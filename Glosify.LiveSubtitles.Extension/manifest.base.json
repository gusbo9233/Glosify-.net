{
  "manifest_version": 3,
  "name": "Glosify Live Subtitles BETA",
  "description": "Real-time translated subtitles for audio playing in the Chrome tab you choose.",
  "version": "0.5.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "identity",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Glosify Live Subtitles BETA",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
