{
  "manifest_version": 3,
  "name": "Glosify Live Subtitles",
  "description": "Real-time translated subtitles for the audio playing in a Chrome tab.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "identity",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://glosify-f0d9e2g3f4ctc3hy.swedencentral-01.azurewebsites.net/*",
    "https://localhost/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Glosify Live Subtitles",
    "default_popup": "popup/popup.html"
  }
}
