{
  "name": "glosify-translator-extension",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/build.mjs test && playwright test",
    "build:dev": "node scripts/build.mjs development",
    "build:test": "node scripts/build.mjs test",
    "build:store": "node scripts/build.mjs store",
    "validate:store": "node scripts/validate-store.mjs artifacts/store",
    "check:production": "node scripts/check-production.mjs",
    "package:store": "node scripts/package-store.mjs",
    "lint": "cd .. && ./Glosify.LiveSubtitles.Extension/node_modules/.bin/eslint --config eslint.config.mjs Glosify.Translator.Extension"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
