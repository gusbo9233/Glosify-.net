<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>b85225d0-8689-47df-8a71-412bb2389bfe</UserSecretsId>
  </PropertyGroup>

  <!-- Versions are centralised in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glosify.Tests" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="Services/Language/language-capabilities.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services/Guest/starter-content.json" LogicalName="Glosify.Guest.StarterContent.json" />
    <!-- Assistant prompts are versioned text, reviewed like code and loaded at runtime. -->
    <EmbeddedResource Include="Services/Ai/Assistant/Prompts/*.md"
                      LogicalName="Glosify.Assistant.Prompts.%(Filename)%(Extension)" />
    <EmbeddedResource Update="Resources/Localization.UiText.*.resx"
                      WithCulture="false"
                      LogicalName="Glosify.Resources.%(Filename).resources" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Frontend/**" />
    <Content Remove="wwwroot/js/**;wwwroot/css/**" />
    <None Remove="Frontend/node_modules/**" />
    <Content Update="wwwroot/**/*.map" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Generated files must exist before the SDK discovers and fingerprints assets. -->
  <Target Name="BuildFrontend" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('Frontend/node_modules/esbuild/package.json')"
           Text="Install frontend dependencies with: npm ci --prefix Glosify/Frontend (Node 24 required)." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Frontend" Command="npm run typecheck" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Frontend" Command="npm run build -- --production"
          Condition="'$(Configuration)' == 'Release'" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Frontend" Command="npm run build"
          Condition="'$(Configuration)' != 'Release'" />
    <ItemGroup>
      <Content Remove="wwwroot/js/**;wwwroot/css/**" />
      <Content Include="wwwroot/js/**;wwwroot/css/**" Exclude="wwwroot/**/*.map"
               CopyToPublishDirectory="PreserveNewest" />
      <Content Include="wwwroot/js/**/*.map;wwwroot/css/**/*.map"
               CopyToPublishDirectory="Never" Condition="'$(Configuration)' != 'Release'" />
    </ItemGroup>
  </Target>

</Project>
