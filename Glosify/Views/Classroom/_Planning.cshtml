@model ClassroomDetailsViewModel
@{
    var sharedQuizzes = Model.Content
        .Where(c => c.ContentType == ClassroomContentType.Quiz && c.Quiz != null)
        .Select(c => c.Quiz!)
        .ToList();
}

@if (Model.IsTeacher)
{
    <div class="tool-grid">
        <section class="panel">
            <div class="panel-header">
                <div class="panel-icon"><span class="material-symbols-outlined">event</span></div>
                <h2 class="panel-title">@Text["Classroom.AddLesson"]</h2>
            </div>
            <form method="post" asp-controller="ClassroomPlanning" asp-action="CreateLesson">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Classroom.Id" />
                <div class="form-group">
                    <label class="form-label" for="lessonTitle">@Text["Classroom.TitleLabel"]</label>
                    <input class="form-input" id="lessonTitle" name="title" maxlength="160" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="lessonDescription">@Text["Classroom.DescriptionOptional"]</label>
                    <input class="form-input" id="lessonDescription" name="description" maxlength="2000" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="lessonScheduledAt">@Text["Classroom.ScheduledOptional"]</label>
                    <input class="form-input" id="lessonScheduledAt" name="scheduledAt" type="datetime-local" />
                </div>
                <button class="btn-submit" type="submit">
                    @Text["Classroom.AddLesson"] <span class="material-symbols-outlined" aria-hidden="true">event</span>
                </button>
            </form>
        </section>

        <section class="panel">
            <div class="panel-header">
                <div class="panel-icon"><span class="material-symbols-outlined">assignment</span></div>
                <h2 class="panel-title">@Text["Classroom.AddAssignment"]</h2>
            </div>
            <form method="post" asp-controller="ClassroomPlanning" asp-action="CreateAssignment">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Classroom.Id" />
                <div class="form-group">
                    <label class="form-label" for="assignmentTitle">@Text["Classroom.TitleLabel"]</label>
                    <input class="form-input" id="assignmentTitle" name="title" maxlength="160" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="assignmentInstructions">@Text["Classroom.InstructionsOptional"]</label>
                    <input class="form-input" id="assignmentInstructions" name="instructions" maxlength="2000" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="assignmentQuiz">@Text["Classroom.QuizOptional"]</label>
                    <select class="form-input" id="assignmentQuiz" name="quizId">
                        <option value="">@Text["Classroom.NoQuiz"]</option>
                        @foreach (var quiz in sharedQuizzes)
                        {
                            <option value="@quiz.Id">@quiz.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="assignmentLesson">@Text["Classroom.LessonOptional"]</label>
                    <select class="form-input" id="assignmentLesson" name="lessonId">
                        <option value="">@Text["Classroom.NoLesson"]</option>
                        @foreach (var lessonInfo in Model.Schedule.Lessons)
                        {
                            <option value="@lessonInfo.Lesson.Id">@lessonInfo.Lesson.Title</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="assignmentDueAt">@Text["Classroom.DueOptional"]</label>
                    <input class="form-input" id="assignmentDueAt" name="dueAt" type="datetime-local" />
                </div>
                <button class="btn-submit" type="submit">
                    @Text["Classroom.AddAssignment"] <span class="material-symbols-outlined" aria-hidden="true">assignment_add</span>
                </button>
            </form>
        </section>
    </div>
}

<section>
    <div class="collection-header">
        <div>
            <h2 class="collection-title">@Text["Classroom.CoursePlan"]</h2>
            <p class="collection-subtitle">
                @Model.Schedule.Lessons.Count @(Model.Schedule.Lessons.Count == 1 ? Text["Classroom.LessonOne"] : Text["Classroom.LessonMany"]),
                @{ var assignmentCount = Model.Schedule.Lessons.Sum(l => l.Assignments.Count) + Model.Schedule.UnattachedAssignments.Count; }
                @assignmentCount @(assignmentCount == 1 ? Text["Classroom.AssignmentOne"] : Text["Classroom.AssignmentMany"])
            </p>
        </div>
    </div>

    @foreach (var lessonInfo in Model.Schedule.Lessons)
    {
        <section class="classroom-lesson">
            <div class="classroom-lesson-header">
                <div>
                    <h3 class="collection-title">@lessonInfo.Lesson.Title</h3>
                    <p class="book-meta">
                        @if (lessonInfo.Lesson.ScheduledAt.HasValue)
                        {
                            <time datetime="@lessonInfo.Lesson.ScheduledAt.Value.ToString("O")" data-local="weekday">@lessonInfo.Lesson.ScheduledAt.Value.UtcDateTime.ToString("dddd MMM d, yyyy HH:mm")</time>
                        }
                        @if (!string.IsNullOrWhiteSpace(lessonInfo.Lesson.Description))
                        {
                            <span> &middot; @lessonInfo.Lesson.Description</span>
                        }
                    </p>
                </div>
                @if (Model.IsTeacher)
                {
                    <form method="post" asp-controller="ClassroomPlanning" asp-action="DeleteLesson" data-confirm="@Text["Classroom.DeleteLessonConfirm"]">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Classroom.Id" />
                        <input type="hidden" name="lessonId" value="@lessonInfo.Lesson.Id" />
                        <button class="btn-linkish" type="submit">@Text["Classroom.DeleteLesson"]</button>
                    </form>
                }
            </div>
            <div class="classroom-member-list">
                @foreach (var info in lessonInfo.Assignments)
                {
                    <partial name="_PlanningAssignment" model="(Model, info)" />
                }
                @if (!lessonInfo.Assignments.Any())
                {
                    <div class="empty-state">@Text["Classroom.NoAssignmentsLesson"]</div>
                }
            </div>
        </section>
    }

    @if (Model.Schedule.UnattachedAssignments.Any())
    {
        <section class="classroom-lesson">
            <div class="classroom-lesson-header">
                <h3 class="collection-title">@Text["Classroom.OtherAssignments"]</h3>
            </div>
            <div class="classroom-member-list">
                @foreach (var info in Model.Schedule.UnattachedAssignments)
                {
                    <partial name="_PlanningAssignment" model="(Model, info)" />
                }
            </div>
        </section>
    }

    @if (!Model.Schedule.Lessons.Any() && !Model.Schedule.UnattachedAssignments.Any())
    {
        <div class="empty-state">@Text["Classroom.NoPlanYet"] @(Model.IsTeacher ? Text["Classroom.PlanAbove"] : Text["Classroom.NoTeacherPlan"])</div>
    }
</section>
