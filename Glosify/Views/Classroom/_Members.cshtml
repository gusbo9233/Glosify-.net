@model ClassroomDetailsViewModel

@if (Model.IsTeacher)
{
    <div class="tool-grid">
        <section class="panel">
            <div class="panel-header">
                <div class="panel-icon"><span class="material-symbols-outlined">person_add</span></div>
                <h2 class="panel-title">@Text["Classroom.InviteEmail"]</h2>
            </div>
            <form method="post" asp-controller="ClassroomMembers" asp-action="Invite">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Classroom.Id" />
                <div class="form-group">
                    <label class="form-label" for="inviteEmail">@Text["Auth.EmailAddress"]</label>
                    <input class="form-input" id="inviteEmail" name="email" type="email" maxlength="256" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="inviteRole">@Text["Classroom.Role"]</label>
                    <select class="form-input" id="inviteRole" name="role">
                        <option value="student">@Text["Classroom.Student"]</option>
                        <option value="teacher">@Text["Classroom.Teacher"]</option>
                    </select>
                </div>
                <button class="btn-submit" type="submit">
                    @Text["Classroom.Invite"] <span class="material-symbols-outlined" aria-hidden="true">outgoing_mail</span>
                </button>
                <p class="book-meta">@Text["Classroom.InviteHelp"]</p>
            </form>
        </section>

        @if (Model.IsOwner)
        {
            <section class="panel">
                <div class="panel-header">
                    <div class="panel-icon"><span class="material-symbols-outlined">key</span></div>
                    <h2 class="panel-title">@Text["Classroom.JoinCode"]</h2>
                </div>
                <p class="book-meta">
                    @Text["Classroom.CodeAnyone"] <strong>@Model.Classroom.JoinCode</strong> @Text["Classroom.CodeCanJoin"]
                    @Text["Classroom.JoiningCurrently"] <strong>@(Model.Classroom.JoinCodeEnabled ? Text["Classroom.Enabled"] : Text["Classroom.Paused"])</strong>.
                </p>
                <div class="classroom-invite-actions">
                    <form method="post" asp-controller="ClassroomMembers" asp-action="RegenerateJoinCode">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Classroom.Id" />
                        <button class="btn-secondary" type="submit">@Text["Classroom.NewCode"]</button>
                    </form>
                    <form method="post" asp-controller="ClassroomMembers" asp-action="ToggleJoinCode">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Classroom.Id" />
                        <input type="hidden" name="enabled" value="@((!Model.Classroom.JoinCodeEnabled).ToString().ToLowerInvariant())" />
                        <button class="btn-secondary" type="submit">@(Model.Classroom.JoinCodeEnabled ? Text["Classroom.PauseJoining"] : Text["Classroom.ResumeJoining"])</button>
                    </form>
                </div>
            </section>
        }
    </div>
}

<section>
    <div class="collection-header">
        <div>
            <h2 class="collection-title">@Text["Classroom.Members"]</h2>
            <p class="collection-subtitle">@Model.Members.Count @(Model.Members.Count == 1 ? Text["Classroom.MemberOne"] : Text["Classroom.MemberMany"])</p>
        </div>
    </div>

    <div class="classroom-member-list">
        @foreach (var member in Model.Members)
        {
            <article class="book-card">
                <div class="book-card-main">
                    <div class="word-icon"><span class="material-symbols-outlined">person</span></div>
                    <div>
                        <h3 class="book-title">@member.DisplayName</h3>
                        <p class="book-meta">@member.Role &middot; @Text["Classroom.Joined"] <time datetime="@member.JoinedAt.ToString("O")" data-local="date">@member.JoinedAt.UtcDateTime.ToString("MMM d, yyyy")</time></p>
                    </div>
                </div>
                <div class="classroom-content-actions">
                    @if (Model.IsTeacher)
                    {
                        <a class="btn-secondary" asp-controller="ClassroomMembers" asp-action="MemberResults" asp-route-id="@Model.Classroom.Id" asp-route-memberId="@member.UserId">@Text["Classroom.Results"]</a>
                    }
                    @if (Model.IsOwner && member.Role != ClassroomRole.Owner)
                    {
                        <form method="post" asp-controller="ClassroomMembers" asp-action="ChangeRole">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Classroom.Id" />
                            <input type="hidden" name="memberUserId" value="@member.UserId" />
                            <input type="hidden" name="role" value="@(member.Role == ClassroomRole.Student ? "teacher" : "student")" />
                            <button class="btn-linkish" type="submit">@Text["Classroom.MakeRole", member.Role == ClassroomRole.Student ? Text["Classroom.Teacher"] : Text["Classroom.Student"]]</button>
                        </form>
                    }
                    @if (Model.IsTeacher && member.Role != ClassroomRole.Owner && !(member.Role == ClassroomRole.Teacher && !Model.IsOwner))
                    {
                        <form method="post" asp-controller="ClassroomMembers" asp-action="RemoveMember" data-confirm="@Text["Classroom.RemoveMemberConfirm", member.DisplayName]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Classroom.Id" />
                            <input type="hidden" name="memberUserId" value="@member.UserId" />
                            <button class="btn-linkish" type="submit">@Text["Common.Remove"]</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>

    <div class="classroom-danger-zone">
        @if (Model.IsOwner)
        {
            <form method="post" asp-controller="Classroom" asp-action="Delete" data-confirm="@Text["Classroom.DeleteForEveryone"]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Classroom.Id" />
                <button class="btn-linkish" type="submit">@Text["Classroom.DeleteClassroom"]</button>
            </form>
        }
        else
        {
            <form method="post" asp-controller="Classroom" asp-action="Leave" data-confirm="@Text["Classroom.LeaveConfirm"]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Classroom.Id" />
                <button class="btn-linkish" type="submit">@Text["Classroom.LeaveClassroom"]</button>
            </form>
        }
    </div>
</section>
