@model ClassroomDetailsViewModel

@if (Model.IsTeacher)
{
    <div class="tool-grid">
        <section class="panel">
            <div class="panel-header">
                <div class="panel-icon"><span class="material-symbols-outlined">quiz</span></div>
                <h2 class="panel-title">@Text["Classroom.ShareQuiz"]</h2>
            </div>
            @if (Model.ShareableQuizzes.Any())
            {
                <form method="post" asp-controller="ClassroomContent" asp-action="ShareQuiz">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Classroom.Id" />
                    <div class="form-group">
                        <label class="form-label" for="shareQuizId">@Text["Classroom.QuizLibrary"]</label>
                        <select class="form-input" id="shareQuizId" name="quizId" required>
                            @foreach (var quiz in Model.ShareableQuizzes)
                            {
                                <option value="@quiz.Id">@quiz.Name (@QuizLanguageDisplay.Name(quiz.TargetLanguage))</option>
                            }
                        </select>
                    </div>
                    <button class="btn-submit" type="submit">
                        @Text["Classroom.Share"] <span class="material-symbols-outlined" aria-hidden="true">share</span>
                    </button>
                </form>
            }
            else
            {
                <p class="book-meta">@Text["Classroom.AllQuizzesShared"]</p>
            }
        </section>

        <section class="panel">
            <div class="panel-header">
                <div class="panel-icon"><span class="material-symbols-outlined">picture_as_pdf</span></div>
                <h2 class="panel-title">@Text["Classroom.ShareBook"]</h2>
            </div>
            @if (Model.ShareableBooks.Any())
            {
                <form method="post" asp-controller="ClassroomContent" asp-action="ShareBook">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Classroom.Id" />
                    <div class="form-group">
                        <label class="form-label" for="shareBookId">@Text["Classroom.BookLibrary"]</label>
                        <select class="form-input" id="shareBookId" name="bookId" required>
                            @foreach (var book in Model.ShareableBooks)
                            {
                                <option value="@book.Id">@book.Title</option>
                            }
                        </select>
                    </div>
                    <button class="btn-submit" type="submit">
                        @Text["Classroom.Share"] <span class="material-symbols-outlined" aria-hidden="true">share</span>
                    </button>
                </form>
            }
            else
            {
                <p class="book-meta">@Text["Classroom.AllBooksShared"] <a asp-controller="Books" asp-action="Index">@Text["Books.UploadPdf"]</a> @Text["Classroom.First"]</p>
            }
        </section>
    </div>
}

<section>
    <div class="collection-header">
        <div>
            <h2 class="collection-title">@Text["Classroom.SharedContent"]</h2>
            <p class="collection-subtitle">@Model.Content.Count @(Model.Content.Count == 1 ? Text["Classroom.ItemOne"] : Text["Classroom.ItemMany"])</p>
        </div>
    </div>

    <div class="book-grid">
        @foreach (var item in Model.Content)
        {
            <article class="book-card">
                <div class="book-card-main">
                    <div class="word-icon">
                        <span class="material-symbols-outlined">@(item.ContentType == ClassroomContentType.Quiz ? "quiz" : "picture_as_pdf")</span>
                    </div>
                    <div>
                        <h3 class="book-title">@(item.Quiz?.Name ?? item.Book?.Title ?? Text["Classroom.Removed"])</h3>
                        <p class="book-meta">@Text["Classroom.SharedBy", item.SharedByName] &middot; <time datetime="@item.SharedAt.ToString("O")" data-local="date">@item.SharedAt.UtcDateTime.ToString("MMM d, yyyy")</time></p>
                    </div>
                </div>
                <div class="classroom-content-actions">
                    @if (item.ContentType == ClassroomContentType.Quiz && item.Quiz != null)
                    {
                        var customQuizzes = Model.CustomQuizzesByQuizId.GetValueOrDefault(item.Quiz.Id, []);
                        <a class="btn-secondary" asp-controller="FlashcardQuiz" asp-action="Index" asp-route-id="@item.Quiz.Id" asp-route-classroomId="@Model.Classroom.Id">
                            @Text["Settings.Flashcards"]
                        </a>
                        <a class="btn-secondary" asp-controller="TypingQuiz" asp-action="Index" asp-route-id="@item.Quiz.Id" asp-route-classroomId="@Model.Classroom.Id">
                            @Text["Settings.Typing"]
                        </a>
                        @foreach (var customQuiz in customQuizzes)
                        {
                            <a class="btn-secondary" asp-controller="CustomQuiz" asp-action="Play" asp-route-id="@customQuiz.Id" asp-route-classroomId="@Model.Classroom.Id">@customQuiz.Name</a>
                        }
                        <form method="post" asp-controller="ClassroomContent" asp-action="CopyQuiz">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Classroom.Id" />
                            <input type="hidden" name="quizId" value="@item.Quiz.Id" />
                            <button class="btn-linkish" type="submit">@Text["Classroom.CopyLibrary"]</button>
                        </form>
                    }
                    else if (item.ContentType == ClassroomContentType.Book && item.Book != null)
                    {
                        <a class="btn-secondary" asp-controller="ClassroomContent" asp-action="ContentPdf" asp-route-id="@Model.Classroom.Id" asp-route-bookId="@item.Book.Id" target="_blank" rel="noopener">
                            @Text["Classroom.OpenPdf"]
                        </a>
                    }
                    @if (Model.IsTeacher)
                    {
                        <form method="post" asp-controller="ClassroomContent" asp-action="Unshare" data-confirm="@Text["Classroom.RemoveConfirm"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Classroom.Id" />
                            <input type="hidden" name="contentId" value="@item.Id" />
                            <button class="btn-linkish" type="submit">@Text["Common.Remove"]</button>
                        </form>
                    }
                </div>
            </article>
        }
        @if (!Model.Content.Any())
        {
            <div class="empty-state">@Text["Classroom.NoSharedContent"]</div>
        }
    </div>
</section>
