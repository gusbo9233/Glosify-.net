@model ClassroomDetailsViewModel

<section>
    <div class="collection-header">
        <div>
            <h2 class="collection-title">@Text["Classroom.QuizResults"]</h2>
            <p class="collection-subtitle">@Model.Results.Count @(Model.Results.Count == 1 ? Text["Classroom.AttemptOne"] : Text["Classroom.AttemptMany"]) @Text["Classroom.FromPractice"]</p>
        </div>
    </div>

    @if (Model.Results.Any())
    {
        <div class="classroom-results-table-wrap">
            <table class="admin-credit-table">
                <thead>
                    <tr>
                        <th>@Text["Classroom.MemberOne"]</th><th>@Text["Settings.Quiz"]</th><th>@Text["Settings.Mode"]</th><th>@Text["Classroom.Score"]</th><th>@Text["Quiz.Correct"]</th><th>@Text["Classroom.Completed"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results)
                    {
                        var answered = row.CorrectCount + row.IncorrectCount;
                        var score = answered == 0 ? 0 : (int)Math.Round(row.CorrectCount * 100d / answered);
                        <tr>
                            <td>
                                <a asp-controller="ClassroomMembers" asp-action="MemberResults" asp-route-id="@Model.Classroom.Id" asp-route-memberId="@row.UserId">@row.MemberName</a>
                            </td>
                            <td>@row.QuizName</td>
                            <td>@row.Mode</td>
                            <td>@score%</td>
                            <td>@row.CorrectCount / @row.TotalItems</td>
                            <td><time datetime="@row.CompletedAt.ToString("O")" data-local="datetime">@row.CompletedAt.UtcDateTime.ToString("MMM d, yyyy HH:mm")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">@Text["Classroom.NoAttempts"]</div>
    }
</section>
