@model (ClassroomDetailsViewModel Parent, Glosify.Services.Classrooms.ClassroomAssignmentInfo Info)
@{
    var parent = Model.Parent;
    var info = Model.Info;
    var assignment = info.Assignment;
    var overdue = assignment.DueAt.HasValue && assignment.DueAt.Value < DateTimeOffset.UtcNow;
}

<article class="book-card classroom-assignment">
    <div class="book-card-main">
        <div class="word-icon"><span class="material-symbols-outlined">assignment</span></div>
        <div>
            <h3 class="book-title">@assignment.Title</h3>
            <p class="book-meta">
                @if (assignment.DueAt.HasValue)
                {
                    <span class="classroom-due @(overdue ? "is-overdue" : null)">@Text["Classroom.Due"] <time datetime="@assignment.DueAt.Value.ToString("O")" data-local="datetime">@assignment.DueAt.Value.UtcDateTime.ToString("MMM d, yyyy HH:mm")</time></span>
                }
                @if (info.QuizName != null)
                {
                    <span> &middot; @Text["Settings.Quiz"]: @info.QuizName</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(assignment.Instructions))
            {
                <p class="book-meta">@assignment.Instructions</p>
            }
            <p class="book-meta">
                @if (parent.IsTeacher)
                {
                    @Text["Classroom.StudentsCompleted", info.CompletedStudents, info.TotalStudents]
                }
                else if (assignment.QuizId.HasValue)
                {
                    @(info.CompletedByMe ? Text["Classroom.DoneBest", info.MyBestScorePercent ?? 0] : Text["Classroom.NotDone"])
                }
            </p>
        </div>
    </div>
    <div class="classroom-content-actions">
        @if (assignment.QuizId.HasValue)
        {
            var customQuizzes = parent.CustomQuizzesByQuizId.GetValueOrDefault(assignment.QuizId.Value, []);
            <a class="btn-secondary" asp-controller="FlashcardQuiz" asp-action="Index" asp-route-id="@assignment.QuizId" asp-route-classroomId="@parent.Classroom.Id">@Text["Settings.Flashcards"]</a>
            <a class="btn-secondary" asp-controller="TypingQuiz" asp-action="Index" asp-route-id="@assignment.QuizId" asp-route-classroomId="@parent.Classroom.Id">@Text["Settings.Typing"]</a>
            @foreach (var customQuiz in customQuizzes)
            {
                <a class="btn-secondary" asp-controller="CustomQuiz" asp-action="Play" asp-route-id="@customQuiz.Id" asp-route-classroomId="@parent.Classroom.Id">@customQuiz.Name</a>
            }
        }
        @if (parent.IsTeacher)
        {
            <form method="post" asp-controller="ClassroomPlanning" asp-action="DeleteAssignment" data-confirm="@Text["Classroom.DeleteAssignmentConfirm"]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@parent.Classroom.Id" />
                <input type="hidden" name="assignmentId" value="@assignment.Id" />
                <button class="btn-linkish" type="submit">@Text["Common.Delete"]</button>
            </form>
        }
    </div>
</article>
