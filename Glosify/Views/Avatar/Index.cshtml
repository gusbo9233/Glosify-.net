@{
    ViewData["Title"] = "Avatar conversation";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/avatar.css" asp-append-version="true" />
}
<section class="avatar-page" id="avatar-page">
    @Html.AntiForgeryToken()
    <h1 class="visually-hidden">Avatar conversation</h1>
    <div class="avatar-workspace" id="avatar-workspace">
        <div class="avatar-stage">
            <canvas id="avatar-canvas" aria-label="Rain, your animated conversation partner"></canvas>
            <div class="avatar-stage-top"><span class="avatar-name"><span id="avatar-name">Rain</span> <small>AI conversation partner</small></span><span id="avatar-status" role="status">Getting ready</span></div>
            <div class="avatar-stage-message" id="avatar-render-status">Getting Rain ready…</div>
            <div class="avatar-caption" id="avatar-caption" aria-live="polite" hidden></div>
            <div class="avatar-controls">
                <button type="button" id="avatar-talk" aria-label="Hold to record" title="Hold to record" aria-pressed="false" disabled>
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8" /></svg>
                </button>
            </div>
        </div>
        <button class="avatar-settings-toggle" id="avatar-settings-toggle" type="button" aria-controls="avatar-settings" aria-expanded="true" aria-label="Close conversation settings" title="Close settings">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
        </button>
        <aside class="avatar-settings" id="avatar-settings" aria-label="Conversation settings">
            <div class="avatar-settings-heading"><span class="avatar-step">MAKE IT YOURS</span><h2>Conversation settings</h2></div>
            <label for="avatar-character">Conversation partner</label>
            <select id="avatar-character" aria-describedby="avatar-character-help">
                <option value="rain">Rain · female voice</option>
                <option value="rowan">Rowan · male voice</option>
            </select>
            <p class="avatar-help" id="avatar-character-help">Choose your partner, then hold the microphone to speak.</p>
            <label for="avatar-quiz">What brings you here?</label>
            <select id="avatar-quiz"><option value="">Just a conversation</option></select>
            <p class="avatar-help">Choose a quiz to practice its words and sentences naturally. No scores, no pressure.</p>
            <p class="avatar-help" id="avatar-language">Rain follows your current learning language.</p>
            <p class="avatar-help avatar-voice" id="avatar-voice">A female voice matched to your learning language.</p>
            <fieldset class="avatar-mode"><legend>How would you like to talk?</legend>
                <label><input type="radio" name="avatar-mode" value="push-to-talk" checked /><span>Push to talk<small>Hold the button when you speak</small></span></label>
                <label><input type="radio" name="avatar-mode" value="hands-free" /><span>Hands-free<small>Speak naturally, interrupt anytime</small></span></label>
            </fieldset>
            <p class="avatar-notice" id="avatar-notice" role="alert"></p>
        </aside>
    </div>
    <div class="avatar-footer"><p id="avatar-spending" aria-live="polite">This visit · 0 credits</p><details><summary>Character credits</summary><p>Characters adapted from <a href="https://www.makehumancommunity.org/" target="_blank" rel="noopener">MakeHuman Community</a> CC0 anatomy and Rowan’s short hair. Rain’s <a href="https://www.makehumancommunity.org/node/2816" target="_blank" rel="noopener">Hazel Hair by Elvaerwyn</a> (CC-BY), adapted for this portrait. Original GlobeGlotter styling and animation. Library rendered with <a href="https://polyhaven.com/" target="_blank" rel="noopener">Poly Haven</a> CC0 models and textures; globe map from NASA Blue Marble (Reto Stöckli, NASA Goddard Space Flight Center); AI-generated courtyard view.</p></details></div>
    <details class="avatar-transcript"><summary>Conversation captions</summary><ol id="avatar-transcript"></ol></details>
</section>
@section Scripts {
    <script type="module" src="~/js/avatar/avatar.js" asp-append-version="true"></script>
}
