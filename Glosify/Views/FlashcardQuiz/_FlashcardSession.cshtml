@model FlashcardQuizViewModel
@{
    var isFreestyle = Model.SelectedQuiz?.IsFreestyle == true;
}

<div class="progress-wrap">
    <div class="progress-meta">
        <span class="progress-count">@Model.CompletedCards of @Model.TotalCards @Model.ItemPluralLabel</span>
        <span class="progress-count">@Model.RememberedCount remembered</span>
    </div>
    <div class="progress-track" aria-hidden="true">
        <div class="progress-fill" style="width:@Model.ProgressPercent%"></div>
    </div>
</div>

<div class="card-stage">
    <p class="page-message flashcard-request-status"
       data-flashcard-status
       role="status"
       aria-live="polite"
       hidden></p>
    @if (Model.IsComplete)
    {
        <section class="results visible" aria-live="polite">
            <div class="result-score">@Model.ScorePercent%</div>
            <h2 class="flash-title">@Text["Quiz.SessionComplete"]</h2>
            <div class="result-grid">
                <div class="result-stat"><span>@Text["Quiz.Remembered"]</span><span>@Model.RememberedCount</span></div>
                <div class="result-stat"><span>@Text["Quiz.ReviewAgain"]</span><span>@Model.AgainCount</span></div>
                @if (Model.SkippedCount > 0) { <div class="result-stat"><span>@Text["Quiz.Skipped"]</span><span>@Model.SkippedCount</span></div> }
            </div>
            <form method="post" asp-controller="FlashcardQuiz" asp-action="Restart">
                @Html.AntiForgeryToken()
                <input type="hidden" name="quizId" value="@Model.QuizId" />
                <input type="hidden" name="wordCount" value="@Model.WordCount" />
                <input type="hidden" name="wordRangeStart" value="@Model.WordRangeStart" />
                <input type="hidden" name="wordRangeEnd" value="@Model.WordRangeEnd" />
                <input type="hidden" name="selectedWordIds" value="@Model.SelectedWordIds" />
                <input type="hidden" name="practiceDirection" value="@Model.PracticeDirection" />
                <input type="hidden" name="practiceItemType" value="@Model.PracticeItemType" />
                <button class="btn-main" type="submit">@Text["Quiz.Restart"]</button>
            </form>
            @if (Model.AgainCount > 0)
            {
                <form method="post" asp-controller="FlashcardQuiz" asp-action="RestartAgain">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionId" value="@Model.SessionId" />
                    <button class="btn-main" type="submit">@Text["Quiz.PracticeAgain"]</button>
                </form>
            }
            
        </section>
    }
    else if (Model.CurrentCard != null)
    {
        @if (Model.IsAnswerRevealed)
        {
            <article class="flashcard is-revealed" aria-live="polite">
                <span class="card-label">@Model.CardLabel @Model.CurrentCardNumber</span>
                <h2 class="card-word" dir="auto">
                    @Model.CurrentCard.Prompt
                    @if (!isFreestyle)
                    {
                        <button class="btn-icon-tts"
                                type="button"
                                data-tts="@Model.CurrentCard.Prompt"
                                data-tts-lang="@Model.PromptLanguage"
                                title="@Text["Quiz.PlayPronunciationGeneric"]"
                                aria-label="@Text["Quiz.PlayPronunciation", Model.CurrentCard.Prompt]"
                                aria-pressed="false">
                            <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                        </button>
                    }
                </h2>
                <div class="card-answer revealed">
                    <div class="translation" dir="auto">
                        @Model.CurrentCard.Answer
                        @if (!isFreestyle)
                        {
                            <button class="btn-icon-tts"
                                    type="button"
                                    data-tts="@Model.CurrentCard.Answer"
                                    data-tts-lang="@Model.AnswerLanguage"
                                    title="@Text["Quiz.PlayPronunciationGeneric"]"
                                    aria-label="@Text["Quiz.PlayPronunciation", Model.CurrentCard.Answer]"
                                    aria-pressed="false">
                                <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentCard.ExampleSentence))
                    {
                        <div class="example" dir="auto">@Model.CurrentCard.ExampleSentence</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentCard.ExampleTranslation))
                    {
                        <div class="example" dir="auto">@Model.CurrentCard.ExampleTranslation</div>
                    }
                </div>
            </article>
        }
        else
        {
            <form class="card-reveal-form" method="post" asp-controller="FlashcardQuiz" asp-action="Reveal" data-flashcard-form data-card-reveal-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="sessionId" value="@Model.SessionId" />
                <input type="hidden" name="expectedIndex" value="@Model.CompletedCards" />
                <button class="flashcard flashcard-clickable" type="submit" aria-label="@Text["Quiz.RevealAnswer", Model.CurrentCard.Prompt]">
                    <span class="card-label">@Model.CardLabel @Model.CurrentCardNumber</span>
                    <span class="card-word" dir="auto">@Model.CurrentCard.Prompt</span>
                </button>
                @if (!isFreestyle)
                {
                    <button class="btn-icon-tts card-preview-tts"
                            type="button"
                            data-tts="@Model.CurrentCard.Prompt"
                            data-tts-lang="@Model.PromptLanguage"
                            title="@Text["Quiz.PlayPronunciationGeneric"]"
                            aria-label="@Text["Quiz.PlayPronunciation", Model.CurrentCard.Prompt]"
                            aria-pressed="false">
                        <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                    </button>
                }
            </form>
        }

        @if (Model.IsAnswerRevealed)
        {
            @await Html.PartialAsync("_StudyRatingControls", new Glosify.Models.ViewModels.StudyCardViewModel(
                Model.CurrentCard.Prompt, Model.CurrentCard.Answer, Model.PromptLanguage, Model.AnswerLanguage,
                Model.IsAnswerRevealed, Url.Action("Reveal", "FlashcardQuiz")!, Url.Action("Rate", "FlashcardQuiz")!,
                new Dictionary<string, string> { ["sessionId"] = Model.SessionId, ["expectedIndex"] = Model.CompletedCards.ToString() },
                new[] { new Glosify.Models.ViewModels.StudyRating("again", "Quiz.Again"), new Glosify.Models.ViewModels.StudyRating("good", "Quiz.GotIt") },
                Pronunciation: !isFreestyle, Example: Model.CurrentCard.ExampleSentence, ExampleTranslation: Model.CurrentCard.ExampleTranslation))
        }

        <form class="session-reset" method="post" asp-controller="FlashcardQuiz" asp-action="Restart">
            @Html.AntiForgeryToken()
            <input type="hidden" name="quizId" value="@Model.QuizId" />
            <input type="hidden" name="wordCount" value="@Model.WordCount" />
            <input type="hidden" name="wordRangeStart" value="@Model.WordRangeStart" />
            <input type="hidden" name="wordRangeEnd" value="@Model.WordRangeEnd" />
            <input type="hidden" name="selectedWordIds" value="@Model.SelectedWordIds" />
            <input type="hidden" name="practiceDirection" value="@Model.PracticeDirection" />
            <input type="hidden" name="practiceItemType" value="@Model.PracticeItemType" />
            <button class="btn-linkish" type="submit">@Text["Quiz.Reset"]</button>
        </form>
    }
    else
    {
        <div class="empty-state">
            <h2 class="flash-title">@Text["Quiz.NoneYet", Model.ItemPluralLabel]</h2>
            <p class="flash-subtitle">@Text["Quiz.AddThenStart", Model.ItemPluralLabel, Text["Settings.Flashcards"]]</p>
            <button class="btn-main" type="button" disabled>@Text["Quiz.ShowAnswer"]</button>
        </div>
    }
</div>
