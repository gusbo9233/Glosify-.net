@model ExploreCollectionViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.Collection.Name;
    ViewData["HideAssistantPanel"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-library.css" asp-append-version="true" />
}

<section class="select-quiz-page library-page explore-page">
    <header class="select-header library-hero explore-hero">
        <div class="select-heading">
            <p class="select-kicker">
                <span class="material-symbols-outlined" aria-hidden="true">folder_shared</span>
                @Text["Explore.PublicCollection"] <span class="select-kicker-separator">/</span> @QuizLanguageDisplay.Name(Model.Collection.Language)
            </p>
            <h1 class="select-title">@Model.Collection.Name</h1>
            <p class="select-subtitle">@Text["Explore.CollectionIntro", Model.QuizCount, Model.QuizCount == 1 ? Text["Quiz.QuizOne"] : Text["Quiz.QuizMany"], Model.CollectionCount + 1]</p>
            <div class="library-overview" aria-label="@Text["Explore.CollectionSummary"]">
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">public</span>
                    <strong>@Model.QuizCount</strong> @(Model.QuizCount == 1 ? Text["Quiz.QuizOne"] : Text["Quiz.QuizMany"])
                </span>
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">account_tree</span>
                    <strong>@(Model.CollectionCount + 1)</strong> @(Model.CollectionCount == 0 ? Text["Quiz.CollectionOne"] : Text["Quiz.CollectionMany"])
                </span>
            </div>
        </div>
        <div class="select-actions">
            <a class="btn-new-quiz btn-back-library" asp-controller="Explore" asp-action="Index">
                <span class="material-symbols-outlined">arrow_back</span>
                @Text["Common.Back"]
            </a>
            <form method="post" asp-controller="Explore" asp-action="CopyCollection" asp-route-id="@Model.Collection.Id">
                @Html.AntiForgeryToken()
                <button class="btn-new-quiz" type="submit">
                    <span class="material-symbols-outlined">library_add</span>
                    @Text["Explore.CopyCollection"]
                </button>
            </form>
        </div>
    </header>

    @if (Model.Collection.Quizzes.Any())
    {
        <section class="library-section library-section--quizzes" aria-labelledby="rootQuizzesHeading">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="rootQuizzesHeading">@Text["Explore.InCollection"] <span class="section-count">@Model.Collection.Quizzes.Count</span></h2>
                    <p>@Text["Explore.FiledInside", Model.Collection.Name]</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var quiz in Model.Collection.Quizzes)
                {
                    <article class="quiz-card">
                        <a class="quiz-card-link" asp-controller="Explore" asp-action="Details" asp-route-id="@quiz.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon"><span class="material-symbols-outlined">public</span></div>
                                <span class="quiz-card-kind">@Text["Explore.CommunityQuiz"]</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@quiz.Name</h2>
                            <p class="quiz-languages">@QuizLanguageDisplay.Name(quiz.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(quiz.TargetLanguage)</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@quiz.CreatedAt.ToString("MMM d, yyyy")</span>
                            <span class="status-pill"><span class="status-dot" aria-hidden="true"></span>@quiz.ProcessingStatus</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @foreach (var collection in Model.Collection.Descendants())
    {
        <section class="library-section library-section--quizzes" aria-labelledby="collection-@collection.Id">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="collection-@collection.Id">@collection.Name <span class="section-count">@collection.Quizzes.Count</span></h2>
                    <p class="explore-path">@collection.Path</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var quiz in collection.Quizzes)
                {
                    <article class="quiz-card">
                        <a class="quiz-card-link" asp-controller="Explore" asp-action="Details" asp-route-id="@quiz.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon"><span class="material-symbols-outlined">public</span></div>
                                <span class="quiz-card-kind">@Text["Explore.CommunityQuiz"]</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@quiz.Name</h2>
                            <p class="quiz-languages">@QuizLanguageDisplay.Name(quiz.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(quiz.TargetLanguage)</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@quiz.CreatedAt.ToString("MMM d, yyyy")</span>
                            <span class="status-pill"><span class="status-dot" aria-hidden="true"></span>@quiz.ProcessingStatus</span>
                        </div>
                    </article>
                }
                @if (!collection.Quizzes.Any())
                {
                    <div class="library-inline-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">inventory_2</span>
                        @Text["Explore.NoDirectQuizzes"]
                    </div>
                }
            </div>
        </section>
    }
</section>
