@model QuizWorkspaceViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.SelectedQuiz.Name;
    ViewData["ActiveNav"] = "Explore";
    ViewData.HideAssistantPanel();

    var backCollectionId = ViewData["BackCollectionId"] is Guid id ? id : (Guid?)null;
    var isFreestyle = Model.SelectedQuiz.IsFreestyle;
    var itemLabel = isFreestyle ? "Items" : Text["Settings.Words"].Value;
    var itemLabelLower = isFreestyle ? "items" : Text["Settings.WordsLower"].Value;
}

<section class="workspace explore-page">
    <section class="workspace-hero">
        <div class="workspace-hero-content">
            <p class="hero-label">@Text["Explore.PublicQuiz"] - @(isFreestyle ? "Freestyle" : $"{QuizLanguageDisplay.Name(Model.SelectedQuiz.SourceLanguage)} → {QuizLanguageDisplay.Name(Model.SelectedQuiz.TargetLanguage)}")</p>
            <h1 class="hero-title">@Model.SelectedQuiz.Name</h1>
            <div class="hero-actions">
                @if (backCollectionId.HasValue)
                {
                    <a class="btn-hero btn-hero-secondary" asp-controller="Explore" asp-action="Collection" asp-route-id="@backCollectionId">
                        <span class="material-symbols-outlined">arrow_back</span>
                        @Text["Common.Back"]
                    </a>
                }
                else
                {
                    <a class="btn-hero btn-hero-secondary" asp-controller="Explore" asp-action="Index">
                        <span class="material-symbols-outlined">arrow_back</span>
                        @Text["Common.Back"]
                    </a>
                }
                <form class="share-form" method="post" asp-controller="Explore" asp-action="CopyQuiz" asp-route-id="@Model.SelectedQuiz.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn-hero" type="submit">
                        @Text["Common.Copy"] <span class="material-symbols-outlined">library_add</span>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section>
        <div class="collection-header">
            <div>
                <h2 class="collection-title" id="collectionTitle">@itemLabel</h2>
                <p class="collection-subtitle" id="collectionSubtitle">@Text["Quiz.ItemsIn", Model.Words.Count, itemLabelLower, Model.SelectedQuiz.Name]</p>
            </div>
            <div class="tab-group" role="tablist" aria-label="@Text["Quiz.ContentAria"]">
                <button class="tab active" type="button" role="tab" aria-selected="true" aria-controls="wordsPanel" data-tab="words">@itemLabel</button>
                @if (!isFreestyle) { <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="sentencesPanel" data-tab="sentences">@Text["Settings.Sentences"]</button> }
            </div>
        </div>

        <div class="tab-panel" id="wordsPanel" data-title="@Text["Settings.Words"]" data-subtitle="@Text["Quiz.ItemsIn", Model.Words.Count, Text["Settings.WordsLower"], Model.SelectedQuiz.Name]">
            <div class="word-grid" data-word-grid>
                @foreach (var word in Model.Words)
                {
                    var wiktionaryUrl = isFreestyle ? null : WiktionaryLink.ForWord(Model.SelectedQuiz.TargetLanguage, word.Lemma);
                    <article class="word-card">
                        <div class="word-card-main">
                            @if (wiktionaryUrl != null)
                            {
                                <a class="word-icon word-wiktionary-link"
                                   href="@wiktionaryUrl"
                                   aria-label="@Text["Quiz.OpenWiktionary", word.Lemma]"
                                   title="@Text["Quiz.OpenWiktionary", word.Lemma]">
                                    <span class="material-symbols-outlined">translate</span>
                                </a>
                            }
                            else
                            {
                                <div class="word-icon"><span class="material-symbols-outlined">translate</span></div>
                            }
                            <div class="word-card-link">
                                <div>
                                    <div class="word" dir="auto">@word.Lemma</div>
                                    <div class="translation" dir="auto">@word.Translation</div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
                @if (!Model.Words.Any())
                {
                    <div class="empty-state">@Text["Explore.NoPublicWords"]</div>
                }
            </div>
        </div>

        @if (!isFreestyle)
        {
        <div class="tab-panel" id="sentencesPanel" data-title="@Text["Settings.Sentences"]" data-subtitle="@Text["Quiz.ItemsIn", Model.Sentences.Count, Text["Settings.SentencesLower"], Model.SelectedQuiz.Name]" hidden>
            <div class="sentence-grid" data-sentence-grid>
                @foreach (var sentence in Model.Sentences)
                {
                    <article class="sentence-card">
                        <div class="sentence-card-top">
                            <div class="word-icon"><span class="material-symbols-outlined">format_quote</span></div>
                            <div>
                                <div class="sentence-text" dir="auto">@sentence.Text</div>
                                @if (!string.IsNullOrWhiteSpace(sentence.Translation))
                                {
                                    <div class="sentence-translation" dir="auto">@sentence.Translation</div>
                                }
                            </div>
                        </div>
                        <div class="sentence-meta">
                            @Text["Quiz.LinkedWords", sentence.WordCount, sentence.WordCount == 1 ? Text["Settings.WordLower"] : Text["Settings.WordsLower"]]
                        </div>
                    </article>
                }
                @if (!Model.Sentences.Any())
                {
                    <div class="empty-state">@Text["Explore.NoPublicSentences"]</div>
                }
            </div>
        </div>
        }
    </section>
</section>

@section Scripts {
<script src="~/js/word-tabs.js" asp-append-version="true"></script>
}
