@model ExploreIndexViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Explore";
    ViewData["HideAssistantPanel"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-library.css" asp-append-version="true" />
}

<section class="select-quiz-page library-page explore-page">
    <header class="select-header library-hero explore-hero">
        <div class="select-heading">
            <p class="select-kicker">
                <span class="material-symbols-outlined" aria-hidden="true">travel_explore</span>
                Explore <span class="select-kicker-separator">/</span> @Model.CurrentLanguage
            </p>
            <h1 class="select-title">Discover something new</h1>
            <p class="select-subtitle">
                Browse vocabulary shared by other learners, then copy what inspires you into your own library.
                <a class="language-change-link" asp-controller="Languages" asp-action="Index">Change language</a>
            </p>
            <div class="library-overview" aria-label="Public library summary">
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">folder_shared</span>
                    <strong>@Model.Collections.Count</strong> @(Model.Collections.Count == 1 ? "collection" : "collections")
                </span>
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">public</span>
                    <strong>@Model.Quizzes.Count</strong> @(Model.Quizzes.Count == 1 ? "quiz" : "quizzes")
                </span>
            </div>
        </div>
        <div class="explore-hero-feature" aria-hidden="true">
            <span class="material-symbols-outlined">diversity_3</span>
            <div>
                <span>Community library</span>
                <strong>@Model.CurrentLanguage</strong>
            </div>
        </div>
    </header>

    @if (TempData[NotificationKeys.Explore] is string exploreMessage)
    {
        <div class="page-message">@exploreMessage</div>
    }

    @if (Model.Collections.Any())
    {
        <section class="library-section library-section--collections" aria-labelledby="publicCollectionsHeading">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="publicCollectionsHeading">Shared collections <span class="section-count">@Model.Collections.Count</span></h2>
                    <p>Explore complete learning sets curated by the community.</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var item in Model.Collections)
                {
                    <article class="quiz-card collection-card">
                        <a class="quiz-card-link" asp-controller="Explore" asp-action="Collection" asp-route-id="@item.Collection.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon collection-icon"><span class="material-symbols-outlined">folder_shared</span></div>
                                <span class="quiz-card-kind">Shared collection</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@item.Collection.Name</h2>
                            <p class="quiz-languages">@item.Collection.Language</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@item.Collection.CreatedAt.ToString("MMM d, yyyy")</span>
                            <div class="quiz-meta-actions">
                                <span class="status-pill">@item.QuizCount @(item.QuizCount == 1 ? "quiz" : "quizzes") &middot; @item.CollectionCount nested</span>
                                <form class="share-form" method="post" asp-controller="Explore" asp-action="CopyCollection" asp-route-id="@item.Collection.Id">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-copy-public" type="submit" aria-label="Copy @item.Collection.Name to your library">
                                        <span class="material-symbols-outlined" aria-hidden="true">library_add</span>
                                        Copy
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (Model.Quizzes.Any())
    {
        <section class="library-section library-section--quizzes" aria-labelledby="publicQuizzesHeading">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="publicQuizzesHeading">Community quizzes <span class="section-count">@Model.Quizzes.Count</span></h2>
                    <p>Preview a quiz, then add a personal copy to your library.</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var item in Model.Quizzes)
                {
                    <article class="quiz-card">
                        <a class="quiz-card-link" asp-controller="Explore" asp-action="Details" asp-route-id="@item.Quiz.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon"><span class="material-symbols-outlined">public</span></div>
                                <span class="quiz-card-kind">Community quiz</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@item.Quiz.Name</h2>
                            <p class="quiz-languages">@item.Quiz.SourceLanguage &rarr; @item.Quiz.TargetLanguage</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@item.Quiz.CreatedAt.ToString("MMM d, yyyy")</span>
                            <div class="quiz-meta-actions">
                                <span class="status-pill"><span class="status-dot" aria-hidden="true"></span>@item.WordCount @(item.WordCount == 1 ? "word" : "words")</span>
                                <form class="share-form" method="post" asp-controller="Explore" asp-action="CopyQuiz" asp-route-id="@item.Quiz.Id">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-copy-public" type="submit" aria-label="Copy @item.Quiz.Name to your library">
                                        <span class="material-symbols-outlined" aria-hidden="true">library_add</span>
                                        Copy
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (!Model.Collections.Any() && !Model.Quizzes.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="material-symbols-outlined">explore</span></div>
            <h2 class="empty-title">Nothing public for @Model.CurrentLanguage yet</h2>
            <p class="empty-copy">When learners share quizzes or collections in this language, they will appear here.</p>
        </div>
    }
</section>
