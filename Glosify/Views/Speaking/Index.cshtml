@model Glosify.Services.Speaking.SpeakingPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Text["Speaking.LanguagePractice", QuizLanguageDisplay.Name(Model.Language)];
    ViewData["HideAssistantPanel"] = true;
    var pageData = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

@section Styles {
    <link rel="stylesheet" href="~/css/speaking.css" asp-append-version="true" />
}

<div class="speaking-page"
     id="speaking-app"
     data-speaking-page="@pageData"
     data-create-url="/api/speaking/sessions"
     data-token-url="/api/speaking/speech-token"
     data-tts-fallback-url="/api/tts">
    <form class="speaking-antiforgery" aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>

    <header class="speaking-hero">
        <div>
            <span class="speaking-kicker">@Text["Speaking.ConversationLab", QuizLanguageDisplay.Name(Model.Language)]</span>
            <h2>@Text["Speaking.HeroTitle"]</h2>
            <p>@Text["Speaking.HeroText"]</p>
        </div>

        @if (Model.GenericTutorEnabled)
        {
            <label class="speaking-quiz-control" id="speaking-quiz-control">
                <span>@Text["Speaking.PracticeQuiz"]</span>
                <select id="speaking-quiz" aria-label="@Text["Speaking.ChooseQuiz"]">
                    <option value="">@Text["Speaking.FreeLesson"]</option>
                    @foreach (var quiz in Model.Quizzes)
                    {
                        <option value="@quiz.Id">@quiz.Name</option>
                    }
                </select>
            </label>
        }
        <div class="speaking-azure-badge" title="@Text["Speaking.PoweredBy"]">
            <span class="material-symbols-outlined" aria-hidden="true">cloud</span>
            Azure-powered
        </div>
    </header>

    <section class="speaking-controls" aria-label="@Text["Speaking.Settings"]">
        <div class="speaking-avatar-picker" role="radiogroup" aria-label="@Text["Speaking.ChooseAvatar"]">
            @foreach (var avatar in Model.Avatars)
            {
                <button type="button"
                        class="speaking-avatar-option"
                        data-avatar-choice="@avatar.Id"
                        role="radio"
                        aria-checked="false">
                    <span class="speaking-avatar-dot speaking-avatar-dot-@avatar.Id"
                          style="background: @avatar.AccentColor"
                          aria-hidden="true"></span>
                    <span>
                        <strong>@avatar.Name</strong>
                        <small>@avatar.Scenario</small>
                    </span>
                </button>
            }
        </div>

        <label class="speaking-level-control">
            <span>@Text["Speaking.Level"]</span>
            <select id="speaking-level" aria-label="@Text["Speaking.ChooseLevel"]">
                <option value="A1">A1 · @Text["Speaking.Beginner"]</option>
                <option value="A2" selected>A2 · @Text["Speaking.Elementary"]</option>
                <option value="B1">B1 · @Text["Speaking.Intermediate"]</option>
                <option value="B2">B2 · @Text["Speaking.UpperIntermediate"]</option>
                <option value="C1">C1 · @Text["Speaking.Advanced"]</option>
            </select>
        </label>

        <label class="speaking-switch">
            <input type="checkbox" id="speaking-translation-toggle" />
            <span class="speaking-switch-track" aria-hidden="true"></span>
            <span>@Text["Speaking.EnglishTranslation"]</span>
        </label>

        <label class="speaking-switch">
            <input type="checkbox" id="speaking-mute-toggle" />
            <span class="speaking-switch-track" aria-hidden="true"></span>
            <span>@Text["Speaking.MuteAvatar"]</span>
        </label>

    </section>

    <div class="speaking-workspace">
        <section class="speaking-stage-card" aria-label="@Text["Speaking.AvatarScene"]">
            <div class="speaking-stage" id="speaking-stage">
                @await Html.PartialAsync("_AvatarScenes", Model.Avatars)
                <div class="speaking-scene-caption">
                    <span id="speaking-avatar-name"></span>
                    <small id="speaking-scene-name"></small>
                </div>
                <div class="speaking-live-bubble" id="speaking-live-bubble" hidden>
                    <p id="speaking-live-polish" lang="@Model.LanguageCode"></p>
                    <p class="speaking-translation" id="speaking-live-english" lang="en"></p>
                </div>
                @if (Model.InteractiveBartenderEnabled)
                {
                    <div class="speaking-interactive-layer"
                         id="speaking-interactive-layer"
                         hidden>
                        <div class="speaking-interactive-toolbar">
                            <button type="button"
                                    class="speaking-scene-tool"
                                    id="speaking-menu-toggle"
                                    aria-expanded="false"
                                    aria-controls="speaking-bar-menu">
                                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                                Menu
                            </button>
                            <button type="button"
                                    class="speaking-scene-tool"
                                    id="speaking-wallet-toggle"
                                    aria-expanded="false"
                                    aria-controls="speaking-wallet">
                                <span class="material-symbols-outlined" aria-hidden="true">account_balance_wallet</span>
                                <span id="speaking-wallet-balance">100 zł</span>
                            </button>
                        </div>

                        <section class="speaking-bar-menu"
                                 id="speaking-bar-menu"
                                 aria-label="@Text["Speaking.BarMenu"]"
                                 hidden>
                            <div class="speaking-panel-heading">
                                <strong>MENU</strong>
                                <small>Pod Białym Orłem</small>
                            </div>
                            <dl>
                                @foreach (var drink in Glosify.Services.Speaking.BartenderInteractionCatalog.Drinks)
                                {
                                    <div data-menu-drink="@drink.Id">
                                        <dt>@drink.NamePolish</dt>
                                        <dd>@drink.Price zł</dd>
                                    </div>
                                }
                            </dl>
                        </section>

                        <section class="speaking-wallet"
                                 id="speaking-wallet"
                                 aria-label="@Text["Speaking.YourWallet"]"
                                 hidden>
                            <div class="speaking-panel-heading">
                                <div>
                                    <strong>Portfel</strong>
                                    <small id="speaking-payment-due">@Text["Speaking.NoBill"]</small>
                                </div>
                                <button type="button"
                                        class="speaking-panel-close"
                                        id="speaking-wallet-close"
                                        aria-label="@Text["Speaking.CloseWallet"]">
                                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                </button>
                            </div>
                            <div class="speaking-wallet-money"
                                 id="speaking-wallet-money"
                                 aria-label="Choose Polish złoty notes and coins"></div>
                            <div class="speaking-wallet-footer">
                                <span>@Text["Speaking.Selected"] <strong id="speaking-payment-selected">0 zł</strong></span>
                                <button type="button"
                                        class="speaking-wallet-pay"
                                        id="speaking-payment-submit"
                                        disabled>
                                    Pay
                                </button>
                            </div>
                        </section>

                        <div class="speaking-bill"
                             id="speaking-bill"
                             role="status"
                             aria-live="polite"
                             hidden>
                            <span>RACHUNEK</span>
                            <strong id="speaking-bill-total">0 zł</strong>
                        </div>

                        <div class="speaking-context-actions"
                             id="speaking-context-actions"
                             aria-label="@Text["Speaking.SceneActions"]">
                            <div class="speaking-drink-actions"
                                 id="speaking-drink-actions"
                                 hidden></div>
                            <button type="button"
                                    class="speaking-context-action"
                                    id="speaking-snack-action"
                                    hidden>
                                <span class="material-symbols-outlined" aria-hidden="true">bakery_dining</span>
                                Take paluszki
                            </button>
                        </div>

                        <p class="speaking-scene-event"
                           id="speaking-scene-event"
                           role="status"
                           aria-live="polite"
                           hidden></p>
                    </div>
                }
            </div>
            <div class="speaking-avatar-recorder">
                <button type="button"
                        class="speaking-avatar-record-button"
                        id="speaking-avatar-record"
                        aria-label="Hold to speak in @Model.Language; release to send"
                        aria-pressed="false">
                    <span class="speaking-record-dot" aria-hidden="true"></span>
                    <span class="material-symbols-outlined" aria-hidden="true">mic</span>
                    <span class="speaking-avatar-record-label">@Text["Speaking.HoldSpeak"]</span>
                </button>
            </div>
            <div class="speaking-stage-status">
                <span class="speaking-presence-dot" aria-hidden="true"></span>
                <span id="speaking-connection-label">@Text["Speaking.StartingScene"]</span>
                <button type="button"
                        class="speaking-icon-action"
                        id="speaking-replay-latest"
                        aria-label="@Text["Speaking.ReplayLatestAria"]"
                        title="@Text["Speaking.ReplayLatest"]"
                        disabled>
                    <span class="material-symbols-outlined" aria-hidden="true">replay</span>
                </button>
            </div>
        </section>

        <section class="speaking-chat-card" aria-label="@Text["Speaking.Conversation"]">
            <div class="speaking-chat-heading">
                <div>
                    <span class="speaking-kicker">@Text["Speaking.CurrentSession"]</span>
                    <h3>@Text["Speaking.Conversation"]</h3>
                </div>
                <button type="button" class="speaking-text-action" id="speaking-new-session">
                    @Text["Assistant.NewChat"]
                </button>
            </div>

            <div class="speaking-messages"
                 id="speaking-messages"
                 role="log"
                 aria-live="polite"
                 aria-relevant="additions">
            </div>

            <div class="speaking-recording-note" id="speaking-recording-note" hidden>
                <span class="material-symbols-outlined" aria-hidden="true">graphic_eq</span>
                <span>@Text["Speaking.ScoreHelp"]</span>
            </div>

            <div class="speaking-composer">
                <label for="speaking-message" class="visually-hidden">@Text["Speaking.MessageLabel", QuizLanguageDisplay.Name(Model.Language)]</label>
                <textarea id="speaking-message"
                          dir="auto"
                          maxlength="800"
                          rows="3"
                          placeholder="@Text["Speaking.MessagePlaceholder", QuizLanguageDisplay.Name(Model.Language)]"></textarea>
                <div class="speaking-composer-actions">
                    <button type="button"
                            class="speaking-mic-button"
                            id="speaking-mic"
                            aria-label="@Text["Speaking.MicAria", QuizLanguageDisplay.Name(Model.Language)]"
                            aria-pressed="false">
                        <span class="material-symbols-outlined" aria-hidden="true">mic</span>
                        <span class="speaking-mic-label">@Text["Speaking.SpeakToType"]</span>
                    </button>
                    <span class="speaking-character-count" id="speaking-character-count">0 / 800</span>
                    <button type="button" class="speaking-send-button" id="speaking-send">
                        @Text["Common.Send"]
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                    </button>
                </div>
            </div>

            <p class="speaking-status"
               id="speaking-status"
               role="status"
               aria-live="polite"></p>
        </section>
    </div>

    <p class="speaking-privacy-note">
        <span class="material-symbols-outlined" aria-hidden="true">lock</span>
        @Text["Speaking.PrivacyNote"]
    </p>
</div>

<template id="speaking-user-message-template">
    <article class="speaking-message speaking-message-user">
        <div class="speaking-message-meta">
            <span>@Text["Speaking.You"]</span>
            <span class="speaking-input-badge"></span>
        </div>
        <p class="speaking-message-polish" lang="@Model.LanguageCode"></p>
        <div class="speaking-pronunciation" hidden>
            <div>
                <span>@Text["Speaking.Accuracy"]</span>
                <strong data-score="accuracy"></strong>
            </div>
            <div>
                <span>@Text["Speaking.Fluency"]</span>
                <strong data-score="fluency"></strong>
            </div>
            <div data-score-row="completeness" hidden>
                <span>@Text["Speaking.Completeness"]</span>
                <strong data-score="completeness"></strong>
            </div>
        </div>
    </article>
</template>

<template id="speaking-avatar-message-template">
    <article class="speaking-message speaking-message-avatar">
        <div class="speaking-message-meta">
            <span class="speaking-message-speaker"></span>
            <button type="button" class="speaking-message-replay" aria-label="@Text["Speaking.ReplayReply"]">
                <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
            </button>
        </div>
        <button type="button"
                class="speaking-message-flip"
                data-message-flip
                aria-label="@Text["Speaking.ShowEnglish"]"
                aria-pressed="false">
            <span class="speaking-message-flip-inner">
                <span class="speaking-message-face speaking-message-front" aria-hidden="false">
                    <span class="speaking-message-polish" lang="@Model.LanguageCode"></span>
                    <span class="speaking-message-flip-hint" aria-hidden="true">
                        <span class="material-symbols-outlined">translate</span>
                        @Text["Speaking.ClickTranslate"]
                    </span>
                </span>
                <span class="speaking-message-face speaking-message-back" aria-hidden="true">
                    <span class="speaking-message-english" lang="en"></span>
                    <span class="speaking-message-flip-hint" aria-hidden="true">
                        <span class="material-symbols-outlined">undo</span>
                        @Text["Speaking.ClickShowLanguage", QuizLanguageDisplay.Name(Model.Language)]
                    </span>
                </span>
            </span>
        </button>
        <details class="speaking-coach">
            <summary>
                <span class="material-symbols-outlined" aria-hidden="true">school</span>
                @Text["Speaking.CoachFeedback"]
            </summary>
            <dl>
                <div data-coach-row="correctedPolish">
                    <dt>@Text["Speaking.MoreNatural", QuizLanguageDisplay.Name(Model.Language)]</dt>
                    <dd lang="@Model.LanguageCode"></dd>
                </div>
                <div data-coach-row="grammarTipEnglish">
                    <dt>@Text["Speaking.Grammar"]</dt>
                    <dd></dd>
                </div>
                <div data-coach-row="vocabularyTipEnglish">
                    <dt>@Text["Speaking.Vocabulary"]</dt>
                    <dd></dd>
                </div>
                <div data-coach-row="naturalnessTipEnglish">
                    <dt>@Text["Speaking.Naturalness"]</dt>
                    <dd></dd>
                </div>
            </dl>
        </details>
        <section class="speaking-practice-prompt" hidden>
            <div class="speaking-practice-copy">
                <span class="speaking-kicker">@Text["Speaking.PracticeThis"]</span>
                <strong class="speaking-practice-text" lang="@Model.LanguageCode"></strong>
                <span class="speaking-practice-translation" lang="en"></span>
            </div>
            <div class="speaking-practice-actions">
                <button type="button" class="speaking-practice-replay" aria-label="@Text["Speaking.HearPhrase"]">
                    <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                    Hear it
                </button>
                <button type="button" class="speaking-practice-record" aria-label="@Text["Speaking.HoldRepeatAria"]" aria-pressed="false">
                    <span class="material-symbols-outlined" aria-hidden="true">mic</span>
                    <span>@Text["Speaking.HoldRepeat"]</span>
                </button>
            </div>
        </section>
    </article>
</template>

@section Head {
    @* The avatar scenes import three.module.js, which in turn imports
       three.core.js — 367 KB discovered one request at a time, from an origin
       the browser has not connected to yet. Preloading both alongside the
       connection warm-up collapses that chain into parallel downloads that
       start with the page instead of after speaking.js parses. *@
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/three@@0.180.0/build/three.module.js" crossorigin />
    <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/three@@0.180.0/build/three.core.js" crossorigin />
}

@section Scripts {
    <script src="~/lib/speech-sdk/distrib/browser/microsoft.cognitiveservices.speech.sdk.bundle-min.js" defer></script>
    <script type="module" src="~/js/speaking.js" asp-append-version="true"></script>
}
