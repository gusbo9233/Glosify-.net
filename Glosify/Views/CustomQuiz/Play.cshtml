@model CustomQuizPlayViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.Play.Name;
    ViewData.HideAssistantPanel();
}

<section class="custom-player" data-custom-player
         data-custom-style="@Model.Play.Document.StylePreset"
         data-custom-id="@Model.Play.Id"
         data-attempt-id="@Model.Play.AttemptId"
         data-grade-url="@Url.Action("Grade", "CustomQuiz", new { id = Model.Play.Id })">
    @Html.AntiForgeryToken()
    <header class="custom-player-header">
        <p>@Model.Play.SourceQuizName &middot; @QuizLanguageDisplay.Name(Model.Play.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(Model.Play.TargetLanguage)</p>
        <h1>@Model.Play.Name</h1>
    </header>
    <form class="custom-player-grid" data-custom-player-form>
        @foreach (var item in Model.Blocks)
        {
            var block = item.Block;
            <section class="custom-play-block" style="--custom-span:@block.ColumnSpan;--custom-column:@block.GridColumn;--custom-row:@block.GridRow" data-play-block="@block.Id" data-block-type="@block.Type">
                @switch (block.Type)
                {
                    case CustomQuizBlockTypes.Heading:
                        <h2 dir="auto">@block.Text</h2>
                        break;
                    case CustomQuizBlockTypes.InstructionLabel:
                        <p class="custom-instruction" dir="auto">@block.Text</p>
                        break;
                    case CustomQuizBlockTypes.PromptLabel:
                    case CustomQuizBlockTypes.TranslationLabel:
                        <p class="custom-bound-label" dir="auto">@item.ResolvedValue</p>
                        break;
                    case CustomQuizBlockTypes.TextInput:
                        {
                            <label class="custom-inline-answer">
                                @if (!string.IsNullOrEmpty(item.InlineAnswer.Before)) { <span class="custom-inline-answer-before" dir="auto">@item.InlineAnswer.Before</span> }
                                <input class="form-input" type="text" dir="auto" data-answer-block="@block.Id" />
                                @if (!string.IsNullOrEmpty(item.InlineAnswer.After)) { <span class="custom-inline-answer-after" dir="auto">@item.InlineAnswer.After</span> }
                            </label>
                            <div class="custom-answer-feedback" data-answer-feedback></div>
                        }
                        break;
                    case CustomQuizBlockTypes.Textarea:
                        <label>@block.Label<textarea class="form-input" rows="4" dir="auto" data-answer-block="@block.Id"></textarea></label>
                        <div class="custom-answer-feedback" data-answer-feedback></div>
                        break;
                    case CustomQuizBlockTypes.Checkbox:
                        <label class="custom-check"><input type="checkbox" data-answer-block="@block.Id" /><span dir="auto">@block.Label @item.ResolvedValue</span></label>
                        <div class="custom-answer-feedback" data-answer-feedback></div>
                        break;
                    case CustomQuizBlockTypes.RadioGroup:
                        <fieldset><legend>@block.Label</legend>
                            @foreach (var option in item.Options) { <label class="custom-choice" dir="auto"><input type="radio" name="@block.Id" value="@option.Option.Id" data-answer-block="@block.Id" />@option.ResolvedValue</label> }
                        </fieldset>
                        <div class="custom-answer-feedback" data-answer-feedback></div>
                        break;
                    case CustomQuizBlockTypes.MultiSelectGroup:
                        <fieldset><legend>@block.Label</legend>
                            @foreach (var option in item.Options) { <label class="custom-choice" dir="auto"><input type="checkbox" value="@option.Option.Id" data-answer-block="@block.Id" />@option.ResolvedValue</label> }
                        </fieldset>
                        <div class="custom-answer-feedback" data-answer-feedback></div>
                        break;
                    case CustomQuizBlockTypes.SelectMenu:
                        <label>@block.Label<select class="form-input" data-answer-block="@block.Id"><option value="">@Text["Custom.Choose"]</option>
                            @foreach (var option in item.Options) { <option value="@option.Option.Id" dir="auto">@option.ResolvedValue</option> }
                        </select></label>
                        <div class="custom-answer-feedback" data-answer-feedback></div>
                        break;
                    case CustomQuizBlockTypes.WordBank:
                        <div class="custom-word-bank" data-word-bank data-target-inputs="@string.Join(",", block.TargetInputIds)">
                            <span>@block.Label</span>
                            @foreach (var option in item.Options) { <button type="button" dir="auto" data-bank-value="@option.ResolvedValue">@option.ResolvedValue</button> }
                        </div>
                        break;
                    case CustomQuizBlockTypes.SubmitButton:
                        <button class="btn-submit" type="submit">@(string.IsNullOrWhiteSpace(block.Text) ? Text["Custom.CheckAnswers"] : block.Text)</button>
                        break;
                    case CustomQuizBlockTypes.FeedbackMessage:
                        <div class="custom-overall-feedback" role="status" data-overall-feedback>@Text["Custom.CompleteThenSubmit"]</div>
                        break;
                }
            </section>
        }
    </form>
</section>

@section Scripts {
<script src="~/js/custom-quiz-player.js" asp-append-version="true"></script>
}
