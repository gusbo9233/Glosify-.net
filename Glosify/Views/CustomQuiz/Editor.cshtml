@model CustomQuizEditorViewModel
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.Editor.Id.HasValue ? Text["Custom.EditNamed", Model.Editor.Name] : Text["Quiz.NewCustom"];
    ViewData.SetAssistantPageContext(new AssistantPageContext
    {
        QuizId = Model.Quiz.Id,
        CustomQuizId = Model.Editor.Id,
        Title = Text["Custom.AssistantTitle"],
        ContextLabel = Model.Editor.Name,
        EmptyText = Text["Custom.AssistantEmpty"],
        Placeholder = Text["Custom.AssistantPlaceholder"]
    });
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<section class="custom-builder" data-custom-builder
         data-quiz-id="@Model.Quiz.Id"
         data-custom-id="@Model.Editor.Id"
         data-custom-style="@Model.Editor.Document.StylePreset"
         data-row-version="@Model.Editor.RowVersion">
    @Html.AntiForgeryToken()
    <textarea hidden data-custom-document>@JsonSerializer.Serialize(Model.Editor.Document, jsonOptions)</textarea>
    <textarea hidden data-custom-words>@JsonSerializer.Serialize(Model.Words.Select(word => new { id = word.Id, lemma = word.Lemma, translation = word.Translation }), jsonOptions)</textarea>
    <textarea hidden data-custom-templates>@JsonSerializer.Serialize(Model.Templates, jsonOptions)</textarea>

    <header class="custom-builder-header">
        <div>
            <a class="custom-builder-back" asp-controller="Quiz" asp-action="Details" asp-route-id="@Model.Quiz.Id">&larr; @Model.Quiz.Name</a>
            <input class="custom-builder-name" value="@Model.Editor.Name" maxlength="160" aria-label="@Text["Custom.Name"]" data-custom-name />
            <p>@QuizLanguageDisplay.Name(Model.Quiz.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(Model.Quiz.TargetLanguage)</p>
        </div>
        <div class="custom-builder-actions">
            <button class="btn-secondary" type="button" data-custom-undo disabled>@Text["Common.Undo"]</button>
            <button class="btn-secondary" type="button" data-custom-preview>@Text["Common.Preview"]</button>
            <button class="btn-submit" type="button" data-custom-save>@Text["Common.Save"]</button>
        </div>
    </header>
    <div class="panel-message error" data-custom-errors hidden></div>
    <div class="panel-message success" data-custom-message hidden></div>
    <div class="custom-builder-runtime" data-custom-runtime role="status" aria-live="polite">
        @Text["Custom.LoadingEditor"]
    </div>

    <section class="custom-template-gallery" aria-labelledby="custom-template-title">
        <div class="custom-template-heading">
            <div>
                <span class="custom-template-eyebrow">@Text["Custom.DesignStarters"]</span>
                <h2 id="custom-template-title">@Text["Custom.VisualDirection"]</h2>
            </div>
            <p>@Text["Custom.TemplateHelp"]</p>
        </div>
        <div class="custom-template-grid">
            @foreach (var template in Model.Templates)
            {
                <article class="custom-template-card custom-template-card-@template.StylePreset" data-template-card="@template.Id">
                    <div class="custom-template-card-preview" aria-hidden="true">
                        <span class="material-symbols-outlined">@template.Icon</span>
                        <i></i><i></i><i></i>
                    </div>
                    <div class="custom-template-card-copy">
                        <h3>@Text[$"Custom.Template.{template.Id}.Name"]</h3>
                        <p>@Text[$"Custom.Template.{template.Id}.Description"]</p>
                        <small>@Text[$"Custom.Template.{template.Id}.BestFor"]</small>
                    </div>
                    <div class="custom-template-card-actions">
                        <button type="button" class="btn-secondary" data-template-style="@template.Id">@Text["Custom.UseStyle"]</button>
                        <button type="button" class="btn-linkish" data-template-apply="@template.Id">@Text["Custom.UseLayout"]</button>
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="custom-builder-layout">
        <aside class="custom-block-palette" aria-label="@Text["Custom.BuildingBlocks"]">
            <h2>@Text["Custom.Blocks"]</h2>
            <p>@Text["Custom.BlocksHelp"]</p>
            @foreach (var block in new[] {
                (CustomQuizBlockTypes.Heading, Text["Custom.Block.Heading"].Value), (CustomQuizBlockTypes.InstructionLabel, Text["Custom.Block.Instruction"].Value),
                (CustomQuizBlockTypes.PromptLabel, Text["Custom.Block.WordLabel"].Value), (CustomQuizBlockTypes.TranslationLabel, Text["Custom.Block.TranslationLabel"].Value),
                (CustomQuizBlockTypes.TextInput, Text["Custom.Block.TextInput"].Value), (CustomQuizBlockTypes.Textarea, Text["Custom.Block.LongAnswer"].Value),
                (CustomQuizBlockTypes.Checkbox, Text["Custom.Block.Checkbox"].Value), (CustomQuizBlockTypes.RadioGroup, Text["Custom.Block.RadioChoices"].Value),
                (CustomQuizBlockTypes.MultiSelectGroup, Text["Custom.Block.CheckboxChoices"].Value), (CustomQuizBlockTypes.SelectMenu, Text["Custom.Block.SelectMenu"].Value),
                (CustomQuizBlockTypes.WordBank, Text["Custom.Block.WordBank"].Value), (CustomQuizBlockTypes.SubmitButton, Text["Custom.Block.SubmitButton"].Value),
                (CustomQuizBlockTypes.FeedbackMessage, Text["Custom.Block.Feedback"].Value) })
            {
                <div class="custom-palette-block">
                    <button type="button" class="custom-palette-drag" data-palette-drag data-palette-type="@block.Item1" aria-label="@Text["Custom.DragAdd", block.Item2]">
                        <span class="material-symbols-outlined">drag_indicator</span>
                        <span>@block.Item2</span>
                    </button>
                    <button type="button" class="custom-palette-add" data-palette-add data-palette-type="@block.Item1" aria-label="@Text["Custom.Add", block.Item2]">
                        <span class="material-symbols-outlined">add</span>
                    </button>
                </div>
            }
        </aside>

        <main class="custom-canvas-wrap">
            <div class="custom-canvas-toolbar">
                <span><span class="material-symbols-outlined">grid_4x4</span> @Text["Custom.Grid"]</span>
                <small>@Text["Custom.GridHelp"]</small>
            </div>
            <div class="custom-canvas" data-custom-canvas aria-label="@Text["Custom.Canvas"]"></div>
            <div class="custom-preview" data-custom-preview-host hidden></div>
        </main>

        <aside class="custom-inspector" data-custom-inspector>
            <h2>@Text["Custom.Properties"]</h2>
            <p>@Text["Custom.PropertiesHelp"]</p>
        </aside>
    </div>
</section>

@section Scripts {
<script src="~/js/custom-quiz-editor.js" asp-append-version="true"></script>
}
