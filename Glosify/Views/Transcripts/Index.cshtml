@model TranscriptLibraryViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Transcripts.Title"];
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Library.TotalCount / (double)Model.Library.PageSize));
    var learningLanguage = Model.Library.Items.Count == 0
        ? null
        : Glosify.Services.Language.QuizLanguageCatalog.Find(Model.Library.Items[0].TargetLanguage)?.Name;
    var displayLanguage = QuizLanguageDisplay.Name(learningLanguage);
    if (string.IsNullOrWhiteSpace(displayLanguage))
    {
        displayLanguage = Text["Transcripts.SelectedLanguage"];
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/transcripts.css" asp-append-version="true" />
}

<section class="transcripts-page">
    <header class="transcripts-hero">
        <div>
            <p class="transcripts-eyebrow">@Text["Transcripts.Eyebrow"]</p>
            <h1>@Text["Transcripts.Saved"]</h1>
            <p>@Text["Transcripts.Intro", displayLanguage]</p>
        </div>
        <span class="transcripts-count">@(Model.Library.TotalCount == 1 ? Text["Transcripts.CountOne", Model.Library.TotalCount] : Text["Transcripts.CountMany", Model.Library.TotalCount])</span>
    </header>

    @if (TempData["TranscriptMessage"] is string message)
    {
        <div class="transcripts-notice" role="status">@message</div>
    }

    <div class="transcript-grid">
        @foreach (var transcript in Model.Library.Items)
        {
            <a class="transcript-card" asp-action="Details" asp-route-id="@transcript.Id">
                <span class="material-symbols-outlined" aria-hidden="true">subtitles</span>
                <div>
                    <h2>@transcript.Title</h2>
                    <p>@QuizLanguageDisplay.Name(Glosify.Services.Language.QuizLanguageCatalog.Find(transcript.TargetLanguage)?.Name ?? transcript.TargetLanguage.ToUpperInvariant()) · @transcript.Stream · @(transcript.SegmentCount == 1 ? Text["Transcripts.CaptionOne", transcript.SegmentCount] : Text["Transcripts.CaptionMany", transcript.SegmentCount])</p>
                    <small>@Text["Transcripts.Updated"] <time datetime="@transcript.UpdatedAt.ToString("O")" data-local="datetime">@transcript.UpdatedAt.UtcDateTime.ToString("MMM d, yyyy · HH:mm")</time></small>
                </div>
                <span class="material-symbols-outlined transcript-card-arrow" aria-hidden="true">arrow_forward</span>
            </a>
        }
        @if (Model.Library.Items.Count == 0)
        {
            <div class="transcripts-empty">
                <span class="material-symbols-outlined" aria-hidden="true">subtitles_off</span>
                <h2>@Text["Transcripts.None"]</h2>
                <p>@Text["Transcripts.NoneHelp"]</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="transcript-pagination" aria-label="@Text["Transcripts.PagesAria"]">
            <a class="@(Model.Library.Page <= 1 ? "is-disabled" : "")" asp-route-page="@(Model.Library.Page - 1)">@Text["Common.Previous"]</a>
            <span>@Text["Common.PageOf", Model.Library.Page, totalPages]</span>
            <a class="@(Model.Library.Page >= totalPages ? "is-disabled" : "")" asp-route-page="@(Model.Library.Page + 1)">@Text["Common.Next"]</a>
        </nav>
    }
</section>
