@model TranscriptDetailViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.Transcript.Title;
    ViewData["AssistantTranscriptId"] = Model.Transcript.Id;
    ViewData["AssistantTranscriptPage"] = Model.Transcript.Page;
    ViewData["AssistantTranscriptStream"] = Model.Transcript.SelectedStream;
    ViewData["AssistantTitle"] = "Transcript assistant";
    ViewData["AssistantContextLabel"] = Model.Transcript.Title;
    ViewData["AssistantEmptyText"] = "Ask about this transcript or use it with your existing quizzes.";
    ViewData["AssistantPlaceholder"] = "Ask about this transcript...";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Transcript.TotalSegments / (double)Model.Transcript.PageSize));
    var learningLanguage = Glosify.Services.Language.QuizLanguageCatalog.Find(Model.Transcript.TargetLanguage)?.Name
        ?? Model.Transcript.TargetLanguage.ToUpperInvariant();
    var isSource = Model.Transcript.Stream == Glosify.Models.Entities.RealtimeTranslationTranscriptStreams.Source;
    var showingTranslation = Model.Transcript.SelectedStream
        == Glosify.Models.Entities.RealtimeTranslationTranscriptStreams.Translation;
    var hasBothStreams = Model.Transcript.SourceSegmentCount > 0 && Model.Transcript.TranslationSegmentCount > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/transcripts.css" asp-append-version="true" />
}

<section class="transcripts-page transcript-detail-page">
    <a class="transcript-back" asp-action="Index">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        Saved transcripts
    </a>

    @if (TempData["TranscriptMessage"] is string message)
    {
        <div class="transcripts-notice" role="status">@message</div>
    }
    @if (TempData["TranscriptError"] is string error)
    {
        <div class="transcripts-notice is-error" role="alert">@error</div>
    }

    <header class="transcript-detail-header">
        <div>
            <p class="transcripts-eyebrow">@(isSource ? $"Original speech saved for {learningLanguage} learning" : $"Legacy translated captions · learning {learningLanguage}")</p>
            <h1>@Model.Transcript.Title</h1>
            <p>@Model.Transcript.TotalSegments captions · started <time datetime="@Model.Transcript.CreatedAt.ToString("O")" data-local="datetime">@Model.Transcript.CreatedAt.UtcDateTime.ToString("MMM d, yyyy · HH:mm")</time></p>
        </div>
        <div class="transcript-actions">
            <form method="post" asp-action="Rename" asp-route-id="@Model.Transcript.Id" class="transcript-rename">
                @Html.AntiForgeryToken()
                <label class="visually-hidden" for="transcript-title">Transcript title</label>
                <input id="transcript-title" name="title" value="@Model.Transcript.Title" maxlength="160" required />
                <button type="submit">Rename</button>
            </form>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Transcript.Id"
                  data-confirm="Delete this saved transcript permanently?">
                @Html.AntiForgeryToken()
                @if (Model.Transcript.HasActiveSession)
                {
                    <button type="submit" class="transcript-delete" disabled title="Stop live subtitles before deleting">Delete</button>
                }
                else
                {
                    <button type="submit" class="transcript-delete">Delete</button>
                }
            </form>
        </div>
    </header>

    @if (hasBothStreams)
    {
        <nav class="transcript-streams" aria-label="Caption stream">
            <a class="@(showingTranslation ? "" : "is-active")"
               asp-route-id="@Model.Transcript.Id" asp-route-stream="source"
               aria-current="@(showingTranslation ? null : "page")">
                Original speech (@Model.Transcript.SourceSegmentCount)
            </a>
            <a class="@(showingTranslation ? "is-active" : "")"
               asp-route-id="@Model.Transcript.Id" asp-route-stream="translation"
               aria-current="@(showingTranslation ? "page" : null)">
                Translation (@Model.Transcript.TranslationSegmentCount)
            </a>
        </nav>
        <p class="transcript-stream-note">
            @(showingTranslation
                ? "Translated live from the same audio by a different model. Useful for checking meaning where the original speech was misheard."
                : "What the speech recogniser heard. Switch to the translation to cross-check unclear passages.")
        </p>
    }

    <article class="transcript-reader" aria-label="@(showingTranslation ? "Saved translated captions" : "Saved original speech")">
        @foreach (var segment in Model.Transcript.Segments)
        {
            <section class="transcript-segment">
                <time datetime="@segment.CapturedAt.ToString("O")" data-local="time">@segment.CapturedAt.UtcDateTime.ToString("HH:mm:ss")</time>
                <p>@segment.Text</p>
            </section>
        }
    </article>

    @if (totalPages > 1)
    {
        <nav class="transcript-pagination" aria-label="Transcript text pages">
            <a class="@(Model.Transcript.Page <= 1 ? "is-disabled" : "")"
               asp-route-id="@Model.Transcript.Id" asp-route-page="1"
               asp-route-stream="@Model.Transcript.SelectedStream">First</a>
            <a class="@(Model.Transcript.Page <= 1 ? "is-disabled" : "")"
               asp-route-id="@Model.Transcript.Id" asp-route-page="@(Model.Transcript.Page - 1)"
               asp-route-stream="@Model.Transcript.SelectedStream">Previous</a>
            <span>Page @Model.Transcript.Page of @totalPages</span>
            <a class="@(Model.Transcript.Page >= totalPages ? "is-disabled" : "")"
               asp-route-id="@Model.Transcript.Id" asp-route-page="@(Model.Transcript.Page + 1)"
               asp-route-stream="@Model.Transcript.SelectedStream">Next</a>
            <a class="@(Model.Transcript.Page >= totalPages ? "is-disabled" : "")"
               asp-route-id="@Model.Transcript.Id" asp-route-page="@totalPages"
               asp-route-stream="@Model.Transcript.SelectedStream">Last</a>
        </nav>

        @* A long session is dozens of pages, so Next-by-Next is not a way to get around.
           A plain GET form keeps the jump working without script. *@
        <form class="transcript-jump" method="get" asp-action="Details" asp-route-id="@Model.Transcript.Id">
            <input type="hidden" name="stream" value="@Model.Transcript.SelectedStream" />
            <label for="transcript-jump-page">Jump to page</label>
            @if (Model.PageSpans.Count > 0)
            {
                <select id="transcript-jump-page" name="page">
                    @foreach (var span in Model.PageSpans)
                    {
                        <option value="@span.Page" selected="@(span.Page == Model.Transcript.Page)"
                                data-local-range="time"
                                data-range-label="Page @span.Page"
                                data-range-start="@span.StartsAt.ToString("O")"
                                data-range-end="@span.EndsAt.ToString("O")">Page @span.Page · @span.StartsAt.UtcDateTime.ToString("HH:mm:ss")–@span.EndsAt.UtcDateTime.ToString("HH:mm:ss")</option>
                    }
                </select>
            }
            else
            {
                <input id="transcript-jump-page" name="page" type="number" inputmode="numeric"
                       min="1" max="@totalPages" value="@Model.Transcript.Page" />
            }
            <button type="submit">Go</button>
        </form>
    }
</section>
