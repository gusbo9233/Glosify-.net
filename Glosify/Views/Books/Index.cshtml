@model BookLibraryViewModel
@inject Glosify.Services.Language.ILanguageContext LangContext
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";

    var language = LangContext.CurrentLanguage;
    var displayLanguage = QuizLanguageDisplay.Name(language);
    var isFreestyle = Glosify.Services.Language.QuizLanguageCatalog.IsFreestyle(language);
    var shelfTitle = isFreestyle ? "Your study books" : string.IsNullOrEmpty(language) ? Text["Books.YourBooks"] : Text["Books.LanguageBooks", displayLanguage];
    ViewData["Title"] = isFreestyle ? "Study books" : string.IsNullOrEmpty(language) ? Text["Books.Title"] : Text["Books.LanguageTitle", displayLanguage];

    var totalPages = Model.Books.Sum(book => book.PageCount);
}

<section class="books-page">
    <section class="books-library-hero">
        <div class="books-hero-copy">
            <div class="books-eyebrow">
                <span class="material-symbols-outlined" aria-hidden="true">auto_stories</span>
                @Text["Books.YourLibrary"]
            </div>
            <h1 class="books-hero-title">@Text["Books.HeroPrefix"] <span>@Text["Books.Progress"]</span></h1>
            <p class="books-hero-description">
                @Text["Books.HeroText"]
            </p>

            <div class="books-library-stats" aria-label="@Text["Books.SummaryAria"]">
                <div class="books-library-stat">
                    <strong>@Model.Books.Count</strong>
                    <span>@(Model.Books.Count == 1 ? Text["Books.BookOne"] : Text["Books.BookMany"])</span>
                </div>
                <span class="books-stat-divider" aria-hidden="true"></span>
                <div class="books-library-stat">
                    <strong>@totalPages</strong>
                    <span>@(totalPages == 1 ? Text["Books.PageOne"] : Text["Books.PageMany"])</span>
                </div>
            </div>
        </div>

        <div class="books-upload-card">
            <div class="books-upload-heading">
                <span class="books-upload-icon">
                    <span class="material-symbols-outlined" aria-hidden="true">upload_file</span>
                </span>
                <div>
                    <p>@Text["Books.AddShelf"]</p>
                    <h2>@Text["Books.UploadPdf"]</h2>
                </div>
            </div>

            <form method="post" asp-controller="Books" asp-action="Upload" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label class="books-file-picker" for="bookFile">
                    <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
                    <span class="books-file-picker-copy">
                        <strong data-book-file-label>@Text["Books.ChoosePdf"]</strong>
                        <small>@Text["Books.PdfLimit"]</small>
                    </span>
                    <span class="books-file-browse">@Text["Books.Browse"]</span>
                    <input id="bookFile" name="file" type="file" accept="application/pdf,.pdf" required data-book-file-input />
                </label>
                <button class="books-upload-button" type="submit">
                    @Text["Books.AddLibrary"]
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </button>
            </form>
        </div>
        <span class="books-hero-orbit books-hero-orbit-one" aria-hidden="true"></span>
        <span class="books-hero-orbit books-hero-orbit-two" aria-hidden="true"></span>
    </section>

    @if (TempData[NotificationKeys.Book] is string bookMessage)
    {
        <div class="books-notice" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            @bookMessage
        </div>
    }

    <section class="books-collection">
        <div class="books-collection-header">
            <div>
                <p class="books-section-label">@Text["Books.KeepReading"]</p>
                <h2>@shelfTitle</h2>
            </div>
            @if (Model.Books.Any())
            {
                <span class="books-count-pill">@Text["Books.OnShelf", Model.Books.Count]</span>
            }
        </div>

        <div class="book-grid">
            @foreach (var book in Model.Books.Select((book, index) => new { Book = book, Index = index }))
            {
                <article class="book-card">
                    @* Outside the card link: a button cannot be nested inside an anchor. *@
                    <form class="book-delete-form" method="post" asp-controller="Books" asp-action="Delete"
                          asp-route-id="@book.Book.Id"
                          data-confirm="@Text["Books.DeleteConfirm", book.Book.Title]">
                        @Html.AntiForgeryToken()
                        <button class="book-delete" type="submit"
                                aria-label="@Text["Books.Delete", book.Book.Title]" title="@Text["Books.Delete", book.Book.Title]">
                            <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        </button>
                    </form>
                    <a class="book-card-link" asp-controller="Books" asp-action="Read" asp-route-id="@book.Book.Id"
                       aria-label="@Text["Books.Read", book.Book.Title]">
                        <div class="book-cover book-cover-@((book.Index % 4) + 1)" aria-hidden="true">
                            <span class="book-cover-mark">G</span>
                            <span class="book-cover-title">@book.Book.Title</span>
                            <span class="book-cover-rule"></span>
                            <span class="book-cover-type">@Text["Books.ReaderEdition"]</span>
                            <canvas class="book-cover-preview"
                                    data-book-preview
                                    data-pdf-url="@Url.Action("File", "Books", new { id = book.Book.Id })"></canvas>
                        </div>

                        <div class="book-card-content">
                            <div class="book-card-topline">
                                <span class="book-format">
                                    <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
                                    PDF
                                </span>
                                <span class="book-added">@Text["Books.Added"] <time datetime="@book.Book.CreatedAt.ToString("O")" data-local="date">@book.Book.CreatedAt.UtcDateTime.ToString("MMM d, yyyy")</time></span>
                            </div>
                            <h3 class="book-title">@book.Book.Title</h3>
                            <div class="book-card-footer">
                                <span class="book-page-count">
                                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                                    @(book.Book.PageCount == 1 ? Text["Books.PageCountOne", book.Book.PageCount] : Text["Books.PageCountMany", book.Book.PageCount])
                                </span>
                                <span class="book-read-action">
                                    @Text["Books.StartReading"]
                                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                                </span>
                            </div>
                        </div>
                    </a>
                </article>
            }
            @if (!Model.Books.Any())
            {
                <div class="books-empty-state">
                    <span class="books-empty-icon">
                        <span class="material-symbols-outlined" aria-hidden="true">library_books</span>
                    </span>
                    <h3>@(string.IsNullOrEmpty(language) ? Text["Books.ShelfReady"] : Text["Books.NoLanguageBooks", displayLanguage])</h3>
                    <p>@Text["Books.EmptyText"]@(string.IsNullOrEmpty(language) ? "" : Text["Books.EmptyLanguageText", displayLanguage])</p>
                    <label class="books-empty-action" for="bookFile">
                        @Text["Books.ChooseFirst"]
                        <span class="material-symbols-outlined" aria-hidden="true">north_east</span>
                    </label>
                </div>
            }
        </div>
    </section>
</section>

@section Scripts {
<script type="module" src="~/js/books-library.js" asp-append-version="true"></script>
}
