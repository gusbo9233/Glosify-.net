@inject Glosify.Services.Language.ILanguageContext LangContext
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Languages.Title"];
    ViewData["ActiveNav"] = "languages";

    var languages = Glosify.Services.Language.QuizLanguageCatalog.All;
    var current = LangContext.CurrentLanguage;
    var currentDisplay = QuizLanguageDisplay.Name(current);
}

<section class="language-page" data-language-picker>
    <header class="language-hero">
        <h1 class="language-brand">Sonic Polyglot</h1>
        <h2 class="language-tagline">
            @Text["Languages.Tagline"]
        </h2>
        @if (!string.IsNullOrEmpty(current))
        {
            <span class="language-current">
                <span class="material-symbols-outlined icon-sm">check_circle</span>
                @Text["Languages.Current", currentDisplay]
            </span>
        }
    </header>

    <div class="language-search-panel">
        <label for="languageSearch">@Text["Languages.Find"]</label>
        <div class="language-search-control">
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <input id="languageSearch"
                   type="search"
                   autocomplete="off"
                   placeholder="@Text["Languages.SearchPlaceholder"]"
                   data-language-search />
        </div>
        <p class="language-result-count" aria-live="polite" data-language-result-count>
            @Text["Languages.Count", languages.Count]
        </p>
    </div>

    <form class="language-form" method="post" asp-controller="Languages" asp-action="Select" data-language-list>
        @Html.AntiForgeryToken()
        @if (ViewData["ReturnUrl"] is string returnUrl)
        {
            <input type="hidden" name="returnUrl" value="@returnUrl" />
        }
        @foreach (var language in languages)
        {
            var isCurrent = string.Equals(current, language.Name, StringComparison.OrdinalIgnoreCase);
            var displayName = QuizLanguageDisplay.Name(language);
            var searchTerms = string.Join(" ", new[]
            {
                language.Code,
                language.TranslatorCode,
                language.ScribeCode,
                language.Name,
                language.NativeName,
                displayName,
            }.Concat(language.Aliases));
            <button class="language-card @(isCurrent ? "is-current" : "")"
                    type="submit"
                    name="language"
                    value="@language.Code"
                    aria-label="@displayName"
                    aria-pressed="@(isCurrent ? "true" : "false")"
                    data-language-card
                    data-language-search-terms="@searchTerms">
                <span class="flag-frame" aria-hidden="true">@language.Flag</span>
                <span class="language-labels">
                    <span class="language-name">@displayName</span>
                    <span class="language-native-name" dir="auto" lang="@language.Locale">@language.NativeName</span>
                </span>
                <span class="language-code">@language.Code</span>
            </button>
        }
    </form>

    <div class="language-empty-state" data-language-empty hidden>
        <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
        <strong>@Text["Languages.None"]</strong>
        <span>@Text["Languages.NoneHelp"]</span>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/language-picker.js" asp-append-version="true"></script>
}
