@model SavedTranslationSessionDetailViewModel
@using Glosify.Services.Language
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.Session.Title;
    var session = Model.Session;
    var totalPages = Math.Max(1, (int)Math.Ceiling(session.TotalCount / (double)session.PageSize));
    string LanguageName(string code) => QuizLanguageDisplay.Name(QuizLanguageCatalog.Find(code)?.Name ?? code);
}

@section Styles {
    <link rel="stylesheet" href="~/css/saved-translations.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/saved-translations.js" asp-append-version="true"></script>
}

<section class="saved-translations-page saved-translation-detail">
    <a class="saved-translations-back" asp-action="Index">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        @Text["Translations.Saved"]
    </a>

    <header class="saved-translation-detail-header">
        <div class="saved-translation-detail-heading">
            <p class="saved-translations-eyebrow">@(session.TotalCount == 1 ? Text["Translations.CountOne", session.TotalCount] : Text["Translations.CountMany", session.TotalCount])</p>
            <h1 dir="auto">@session.Title</h1>
            <p class="saved-translation-timestamp"><span class="material-symbols-outlined" aria-hidden="true">schedule</span>@Text["Translations.SavedAt"] <time datetime="@session.CreatedAt.ToString("O")" data-local="datetime">@session.CreatedAt.UtcDateTime.ToString("MMM d, yyyy · HH:mm")</time></p>
        </div>
        <form method="post" asp-action="Delete" asp-route-id="@session.Id" data-confirm="@Text["Translations.DeleteSessionConfirm"]">
            @Html.AntiForgeryToken()
            <button type="submit" class="saved-translation-delete"><span class="material-symbols-outlined" aria-hidden="true">delete</span>@Text["Common.Delete"]</button>
        </form>
    </header>

    <div class="saved-translation-session-list">
        @for (var index = 0; index < session.Translations.Count; index++)
        {
            var item = session.Translations[index];
            var effectiveSource = item.SourceLanguage == "auto"
                ? item.DetectedSourceLanguage ?? item.SourceLanguage
                : item.SourceLanguage;
            <article class="saved-translation-session-entry">
                <header class="saved-translation-entry-header">
                    <span class="saved-translation-entry-number">#@(((session.Page - 1) * session.PageSize) + index + 1)</span>
                    <span>@LanguageName(effectiveSource) → @LanguageName(item.TargetLanguage)</span>
                    <time datetime="@item.CreatedAt.ToString("O")" data-local="datetime">@item.CreatedAt.UtcDateTime.ToString("MMM d, yyyy · HH:mm")</time>
                </header>
                @if (!string.IsNullOrWhiteSpace(item.Preferences))
                {
                    <aside class="saved-translation-preferences">
                        <span class="saved-translation-preferences-icon material-symbols-outlined" aria-hidden="true">tune</span>
                        <div><strong>@Text["Translations.Preferences"]</strong><p dir="auto">@item.Preferences</p></div>
                    </aside>
                }
                <div class="saved-translation-columns">
                    <section class="saved-translation-panel saved-translation-source">
                        <header>
                            <div><span class="saved-translation-panel-label">@LanguageName(effectiveSource)</span><h2>@Text["Translations.Source"]</h2></div>
                            <button type="button" data-copy-target="saved-source-@item.Id"><span class="material-symbols-outlined" aria-hidden="true">content_copy</span>@Text["Common.Copy"]</button>
                        </header>
                        <p id="saved-source-@item.Id" dir="auto">@item.SourceText</p>
                    </section>
                    <section class="saved-translation-panel saved-translation-result">
                        <header>
                            <div><span class="saved-translation-panel-label">@LanguageName(item.TargetLanguage)</span><h2>@Text["Translations.Translation"]</h2></div>
                            <button type="button" data-copy-target="saved-result-@item.Id"><span class="material-symbols-outlined" aria-hidden="true">content_copy</span>@Text["Common.Copy"]</button>
                        </header>
                        <p id="saved-result-@item.Id" dir="auto">@item.TranslatedText</p>
                    </section>
                </div>
            </article>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="saved-translations-pagination" aria-label="@Text["Translations.PagesAria"]">
            <a class="@(session.Page <= 1 ? "is-disabled" : "")" asp-route-id="@session.Id" asp-route-page="@(session.Page - 1)">@Text["Common.Previous"]</a>
            <span>@Text["Common.PageOf", session.Page, totalPages]</span>
            <a class="@(session.Page >= totalPages ? "is-disabled" : "")" asp-route-id="@session.Id" asp-route-page="@(session.Page + 1)">@Text["Common.Next"]</a>
        </nav>
    }

    <div class="saved-translation-copy-status"
         data-copy-success="@Text["Translations.Copied"]"
         data-copy-failed="@Text["Translations.CopyFailed"]"
         role="status"
         aria-live="polite"></div>
</section>
