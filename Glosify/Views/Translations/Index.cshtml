@model SavedTranslationLibraryViewModel
@using Glosify.Services.Language
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Translations.Title"];
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Library.TotalCount / (double)Model.Library.PageSize));
    var languageName = QuizLanguageDisplay.Name(
        QuizLanguageCatalog.Find(Model.Library.LanguageCode)?.Name ?? Model.Library.LanguageCode);
}

@section Styles {
    <link rel="stylesheet" href="~/css/saved-translations.css" asp-append-version="true" />
}

<section class="saved-translations-page">
    <header class="saved-translations-hero">
        <div class="saved-translations-hero-copy">
            <p class="saved-translations-eyebrow">@Text["Translations.Eyebrow"] · @languageName</p>
            <h1>@Text["Translations.Saved"]</h1>
            <p class="saved-translations-intro">@Text["Translations.Intro"]</p>
        </div>
        <span class="saved-translations-count">
            <span class="material-symbols-outlined" aria-hidden="true">bookmark</span>
            @(Model.Library.TotalTranslations == 1 ? Text["Translations.CountOne", Model.Library.TotalTranslations] : Text["Translations.CountMany", Model.Library.TotalTranslations])
        </span>
    </header>

    @if (TempData["TranslationMessage"] is string message)
    {
        <div class="saved-translations-notice" role="status">@message</div>
    }

    <div class="saved-translations-grid">
        @foreach (var item in Model.Library.Items)
        {
            <a class="saved-translation-card" asp-action="Details" asp-route-id="@item.Id">
                <span class="saved-translation-card-icon material-symbols-outlined" aria-hidden="true">translate</span>
                <div class="saved-translation-card-copy">
                    <h2 dir="auto">@item.Title</h2>
                    <p dir="auto">@item.TranslationPreview</p>
                    <small class="saved-translation-meta">
                        <span class="saved-translation-language">@(item.TranslationCount == 1 ? Text["Translations.CountOne", item.TranslationCount] : Text["Translations.CountMany", item.TranslationCount])</span>
                        <span class="saved-translation-meta-separator" aria-hidden="true"></span>
                        <time datetime="@item.UpdatedAt.ToString("O")" data-local="datetime">@item.UpdatedAt.UtcDateTime.ToString("MMM d, yyyy · HH:mm")</time>
                    </small>
                </div>
                <span class="material-symbols-outlined saved-translation-card-arrow" aria-hidden="true">arrow_forward</span>
            </a>
        }
        @if (Model.Library.Items.Count == 0)
        {
            <div class="saved-translations-empty">
                <span class="saved-translations-empty-icon material-symbols-outlined" aria-hidden="true">translate</span>
                <h2>@Text["Translations.None"]</h2>
                <p>@Text["Translations.NoneHelp"]</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="saved-translations-pagination" aria-label="@Text["Translations.PagesAria"]">
            <a class="@(Model.Library.Page <= 1 ? "is-disabled" : "")" asp-route-page="@(Model.Library.Page - 1)">@Text["Common.Previous"]</a>
            <span>@Text["Common.PageOf", Model.Library.Page, totalPages]</span>
            <a class="@(Model.Library.Page >= totalPages ? "is-disabled" : "")" asp-route-page="@(Model.Library.Page + 1)">@Text["Common.Next"]</a>
        </nav>
    }
</section>
