@model AnkiStudyViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Anki session";
    ViewData["ActiveNav"] = "anki";
    var card = Model.State.Card;
}
@section Styles { <link rel="stylesheet" href="~/css/anki.css" asp-append-version="true" /> }
<main class="anki-study" data-anki-study>
    @if (card is null)
    {
        <section class="anki-complete"><span class="material-symbols-outlined" aria-hidden="true">task_alt</span><p class="eyebrow is-primary">Session complete</p><h1>You’re done for now</h1>@if (Model.State.NextDueAt.HasValue) { <p>Next card is due @Model.State.NextDueAt.Value.ToLocalTime().ToString("g").</p> } else { <p>No active cards are waiting.</p> }<a class="btn-submit anki-primary-action" asp-action="Index"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Back to collections</a></section>
    }
    else
    {
        <header class="anki-study-header"><a asp-action="Collection" asp-route-id="@card.CollectionId"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> @card.CollectionName</a><div class="anki-session-counts"><span><strong>@card.DueRemaining</strong> due</span><span><strong>@card.NewRemaining</strong> new</span></div></header>
        <section class="anki-study-card">
            <div class="anki-study-label"><span class="material-symbols-outlined" aria-hidden="true">translate</span> @card.PromptLanguage <span aria-hidden="true">·</span> @card.ItemType</div><h1>@card.Prompt</h1>
            <button class="btn-icon-tts" type="button" data-tts="@card.Prompt" data-tts-lang="@card.PromptLanguage" aria-label="Play prompt"><span class="material-symbols-outlined">volume_up</span></button>
            @if (!Model.AnswerRevealed)
            {
                <form method="post" asp-action="Reveal">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@card.CollectionId"/><input type="hidden" name="cardId" value="@card.CardId"/><button class="btn-submit" type="submit" data-reveal-answer>Show answer</button></form>
            }
            else
            {
                <div class="anki-answer"><small>@card.AnswerLanguage</small><h2>@card.Answer</h2><button class="btn-icon-tts" type="button" data-tts="@card.Answer" data-tts-lang="@card.AnswerLanguage" aria-label="Play answer"><span class="material-symbols-outlined">volume_up</span></button></div>
                <p class="anki-rating-prompt">How well did you remember it?</p>
                <form method="post" asp-action="Rate" class="anki-ratings" data-anki-rating-form>
                    @Html.AntiForgeryToken()<input type="hidden" name="CollectionId" value="@card.CollectionId"/><input type="hidden" name="CardId" value="@card.CardId"/><input type="hidden" name="ClientToken" value="@Model.ClientToken"/><input type="hidden" name="RowVersion" value="@card.RowVersion"/><input type="hidden" name="DurationMilliseconds" data-study-duration/>
                    @{ var ratings = new[] { (Name: "again", Key: 1), (Name: "hard", Key: 2), (Name: "good", Key: 3), (Name: "easy", Key: 4) }; }
                    @foreach (var rating in ratings) { <button type="submit" name="Rating" value="@rating.Name" data-rating-key="@rating.Key"><kbd>@rating.Key</kbd><strong>@rating.Name</strong><span>@card.Intervals.GetValueOrDefault(rating.Name, string.Empty)</span></button> }
                </form>
            }
        </section>
    }
</main>
@section Scripts { <script src="~/js/anki.js" asp-append-version="true"></script> }
