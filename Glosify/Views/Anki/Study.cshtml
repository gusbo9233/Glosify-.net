@model AnkiStudyViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Anki session";
    ViewData["ActiveNav"] = "anki";
}
@section Styles { <link rel="stylesheet" href="~/css/anki.css" asp-append-version="true" /> }
<main data-flashcard-session>
    @await Html.PartialAsync("_StudySession", Model)
</main>
@section Scripts { <script src="~/js/flashcard-quiz.js" asp-append-version="true"></script> }
