@model AnkiStudyViewModel
@{
    var card = Model.State.Card;
    var collectionZone = TimeZoneInfo.FindSystemTimeZoneById(Model.State.TimeZoneId);
    var stats = Model.Statistics;
    var due = card?.DueRemaining ?? stats?.Counts.Due ?? 0;
    var newCards = card?.NewRemaining ?? 0;
}
<div class="flash-shell" data-anki-study data-study-quiz-id="@card?.QuizId" data-study-anki-collection-id="@card?.CollectionId" data-study-card-id="@card?.CardId">
    <p class="anki-stats" aria-label="Today in this direction">
        <span>@due due</span>
        <span>@newCards new</span>
        <span>@(stats?.Counts.StudiedToday ?? 0) reviewed today</span>
        @if (stats is { ReviewsLast30Days: > 0 })
        {
            <span title="Share of reviews in the last 30 days not rated Again">@stats.RetentionPercent.ToString("0")% retention</span>
        }
    </p>
    @if (card is null)
    {
        <section class="anki-complete">
            <span class="material-symbols-outlined" aria-hidden="true">task_alt</span>
            <h2>You’re done for now</h2>
            @if (Model.State.NextDueAt.HasValue)
            {
                <p>The next card is due @TimeZoneInfo.ConvertTime(Model.State.NextDueAt.Value, collectionZone).ToString("g").</p>
            }
            else
            {
                <p>No cards are waiting in this direction.</p>
            }
        </section>
    }
    else
    {
        <div class="card-stage">
        @await Html.PartialAsync("_StudyCard", new Glosify.Models.ViewModels.StudyCardViewModel(
            card.Prompt, card.Answer, card.PromptLanguage, card.AnswerLanguage,
            PracticeDirection.IsTargetToSource(card.Direction), Model.AnswerRevealed,
            Url.Action("Reveal", "Anki")!, Url.Action("Rate", "Anki")!,
            new Dictionary<string, string> { ["id"] = card.CollectionId.ToString(), ["CollectionId"] = card.CollectionId.ToString(),
                ["CardId"] = card.CardId.ToString(), ["ClientToken"] = Model.ClientToken.ToString(), ["RowVersion"] = card.RowVersion },
            new[] { new Glosify.Models.ViewModels.StudyRating("again", "Quiz.Again", card.Intervals.GetValueOrDefault("again")),
                new Glosify.Models.ViewModels.StudyRating("hard", "Quiz.Hard", card.Intervals.GetValueOrDefault("hard")),
                new Glosify.Models.ViewModels.StudyRating("good", "Quiz.Good", card.Intervals.GetValueOrDefault("good")),
                new Glosify.Models.ViewModels.StudyRating("easy", "Quiz.Easy", card.Intervals.GetValueOrDefault("easy")) }, "easy", ShowRatingShortcuts: true))
        </div>
    }
</div>
