@model AnkiIndexViewModel
@using Glosify.Models
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Anki";
    ViewData["ActiveNav"] = "anki";
    var workspace = Model.Workspace;
    if (workspace.Collection is { } current)
    {
        ViewData.SetAssistantPageContext(new AssistantPageContext { AnkiCollectionId = current.Id, ContextLabel = "Anki" });
    }
}
@section Styles { <link rel="stylesheet" href="~/css/anki.css" asp-append-version="true" /> }

<main class="anki-page">
    @await Html.PartialAsync("~/Views/Anki/_Workspace.cshtml", Model)
</main>

@section Scripts {
    <script src="~/js/flashcard-quiz.js" asp-append-version="true"></script>
    <script src="~/js/anki.js" asp-append-version="true"></script>
}
