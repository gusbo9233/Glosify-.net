@model TypingQuizViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Quiz.TypingTitle"];
    ViewData["ActiveNav"] = "quizzes";

    var quizName = Model.SelectedQuiz?.Name ?? Text["Quiz.TypingTitle"];
    var isFreestyle = Model.SelectedQuiz?.IsFreestyle == true;
}

<section class="typing-shell"
         data-typing-quiz
         data-session-id="@Model.SessionId"
         data-submit-url="@Url.Action("Submit", "TypingQuiz")"
         data-show-ukrainian-keyboard="@Model.ShowsUkrainianKeyboard.ToString().ToLowerInvariant()"
         data-initial-index="@Model.CompletedWords"
         data-correct-count="@Model.CorrectCount"
         data-incorrect-count="@Model.IncorrectCount"
         data-total-words="@Model.TotalWords"
         data-is-complete="@Model.IsComplete.ToString().ToLowerInvariant()"
         data-item-plural-label="@Model.ItemPluralLabel"
         data-card-label="@Model.CardLabel">
    <header class="flash-header">
        <div>
            <p class="flash-kicker">@Model.DirectionLabel</p>
            <h1 class="flash-title">@quizName</h1>
            <p class="flash-subtitle">@(isFreestyle ? "Type the answer for each prompt." : Text["Quiz.TypeInstruction", QuizLanguageDisplay.Name(Model.AnswerLanguage), Model.ItemSingularLabel, QuizLanguageDisplay.Name(Model.PromptLanguage)])</p>
        </div>
        @if (Model.SelectedQuiz != null)
        {
            <a asp-controller="Quiz" asp-action="Details" asp-route-id="@Model.SelectedQuiz.Id" class="btn-linkish">@(isFreestyle ? "Back to items" : Text["Quiz.BackWords"])</a>
        }
    </header>

    @if (Model.TotalWords == 0)
    {
        <div class="empty-state">
            <h2 class="flash-title">@Text["Quiz.NoneYet", Model.ItemPluralLabel]</h2>
            <p class="flash-subtitle">@Text["Quiz.AddThenStart", Model.ItemPluralLabel, Text["Settings.Typing"]]</p>
            <button class="btn-main" type="button" disabled>@Text["Quiz.CheckAnswer"]</button>
        </div>
    }
    else
    {
        <div class="progress-wrap">
            <div class="progress-meta">
                <span class="progress-count" data-progress-count>@Text["Quiz.Progress", Model.CurrentWordNumber, Model.TotalWords, Model.ItemPluralLabel]</span>
                <span class="progress-count" data-accuracy>@Text["Quiz.CorrectCount", Model.CorrectCount]</span>
            </div>
            <div class="progress-track" aria-hidden="true">
                <div class="progress-fill" data-progress-fill style="width:@Model.ProgressPercent%"></div>
            </div>
        </div>

        <div class="typing-stage">
            <article class="typing-card" data-card>
                <span class="card-label" data-card-label>@Model.CardLabel @Model.CurrentWordNumber</span>
                <p class="typing-prompt-label">@(isFreestyle ? "Prompt" : Text["Quiz.PromptLabel", QuizLanguageDisplay.Name(Model.PromptLanguage)])</p>
                @{
                    var typingPromptIsTarget = Glosify.Models.PracticeDirection.IsTargetToSource(Model.PracticeDirection);
                }
                <h2 class="typing-prompt">
                    <span data-prompt dir="auto">@Model.CurrentWord?.Prompt</span>
                    @if (!isFreestyle && typingPromptIsTarget && Model.CurrentWord != null && !string.IsNullOrWhiteSpace(Model.CurrentWord.Prompt))
                    {
                        <button class="btn-icon-tts"
                                type="button"
                                data-tts="@Model.CurrentWord.Prompt"
                                data-tts-lang="@Model.PromptLanguage"
                                title="@Text["Quiz.PlayPronunciationGeneric"]"
                                aria-label="@Text["Quiz.PlayPronunciationGeneric"]">
                            <span class="material-symbols-outlined">volume_up</span>
                        </button>
                    }
                </h2>
                <p class="typing-feedback" data-feedback aria-live="polite"></p>

                <form class="typing-form" data-typing-form autocomplete="off">
                    @Html.AntiForgeryToken()
                    <label class="visually-hidden" for="typingAnswer">@Text["Quiz.Answer"]</label>
                    <input class="answer-input" id="typingAnswer" data-answer-input type="text" dir="auto" placeholder="@Text["Quiz.TypePlaceholder"]" autocomplete="off" />
                    <button class="btn-check" type="submit" data-check-button>
                        @Text["Quiz.CheckAnswer"] <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </form>

                <div class="typing-reveal" data-reveal hidden>
                    <span>@Text["Quiz.CorrectAnswer"]</span>
                    <strong data-correct-answer dir="auto"></strong>
                    <p data-example dir="auto"></p>
                </div>

                <form class="session-reset" method="post" asp-controller="TypingQuiz" asp-action="Restart">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quizId" value="@Model.QuizId" />
                    <input type="hidden" name="wordCount" value="@Model.WordCount" />
                    <input type="hidden" name="wordRangeStart" value="@Model.WordRangeStart" />
                    <input type="hidden" name="wordRangeEnd" value="@Model.WordRangeEnd" />
                    <input type="hidden" name="selectedWordIds" value="@Model.SelectedWordIds" />
                    <input type="hidden" name="practiceDirection" value="@Model.PracticeDirection" />
                    <input type="hidden" name="practiceItemType" value="@Model.PracticeItemType" />
                    <input type="hidden" name="classroomId" value="@Model.ClassroomId" />
                    <button class="btn-linkish" type="submit">@Text["Quiz.Reset"]</button>
                </form>
            </article>

            @if (Model.ShowsUkrainianKeyboard)
            {
                <section class="ukrainian-keyboard" aria-label="@Text["Quiz.UkrainianKeyboard"]" data-ukrainian-keyboard>
                    <div class="keyboard-row">
                        @foreach (var key in new[] { "й", "ц", "у", "к", "е", "н", "г", "ш", "щ", "з", "х", "ї" })
                        {
                            <button type="button" class="keyboard-key" data-key-value="@key">@key</button>
                        }
                    </div>
                    <div class="keyboard-row">
                        @foreach (var key in new[] { "ф", "і", "в", "а", "п", "р", "о", "л", "д", "ж", "є" })
                        {
                            <button type="button" class="keyboard-key" data-key-value="@key">@key</button>
                        }
                    </div>
                    <div class="keyboard-row">
                        @foreach (var key in new[] { "ґ", "я", "ч", "с", "м", "и", "т", "ь", "б", "ю", "'" })
                        {
                            <button type="button" class="keyboard-key" data-key-value="@key">@key</button>
                        }
                    </div>
                    <div class="keyboard-row keyboard-row-actions">
                        <button type="button" class="keyboard-key keyboard-key-wide" data-key-value=" ">@Text["Quiz.Space"]</button>
                        <button type="button" class="keyboard-key keyboard-key-wide" data-key-action="backspace">
                            <span class="material-symbols-outlined">backspace</span>
                        </button>
                    </div>
                </section>
            }
        </div>

        <section class="results" data-results hidden aria-live="polite">
            <div class="result-score" data-result-score>@Model.ScorePercent%</div>
            <h2 class="flash-title">@Text["Quiz.TypingComplete"]</h2>
            <div class="result-grid">
                <div class="result-stat"><span>@Text["Quiz.Correct"]</span><span data-result-correct>@Model.CorrectCount</span></div>
                <div class="result-stat"><span>@Text["Quiz.Incorrect"]</span><span data-result-incorrect>@Model.IncorrectCount</span></div>
                <div class="result-stat"><span>@Model.ItemPluralLabel</span><span>@Model.TotalWords</span></div>
            </div>
            <div class="typing-result-actions">
                <form method="post" asp-controller="TypingQuiz" asp-action="Restart">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="quizId" value="@Model.QuizId" />
                    <input type="hidden" name="wordCount" value="@Model.WordCount" />
                    <input type="hidden" name="wordRangeStart" value="@Model.WordRangeStart" />
                    <input type="hidden" name="wordRangeEnd" value="@Model.WordRangeEnd" />
                    <input type="hidden" name="selectedWordIds" value="@Model.SelectedWordIds" />
                    <input type="hidden" name="practiceDirection" value="@Model.PracticeDirection" />
                    <input type="hidden" name="practiceItemType" value="@Model.PracticeItemType" />
                    <input type="hidden" name="classroomId" value="@Model.ClassroomId" />
                    <button class="btn-main" type="submit">@Text["Quiz.Restart"]</button>
                </form>
                <form method="post" asp-controller="TypingQuiz" asp-action="RestartIncorrect" data-practice-incorrect hidden>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionId" value="@Model.SessionId" />
                    <button class="btn-main" type="submit">@Text["Quiz.PracticeIncorrect"]</button>
                </form>
                @if (Model.SelectedQuiz != null)
                {
                    <a asp-controller="Quiz" asp-action="Settings" asp-route-id="@Model.SelectedQuiz.Id" class="btn-linkish">@Text["Quiz.ChangeSettings"]</a>
                }
            </div>
        </section>
    }
</section>

@section Scripts {
<script src="~/js/typing-quiz.js" asp-append-version="true"></script>
}
