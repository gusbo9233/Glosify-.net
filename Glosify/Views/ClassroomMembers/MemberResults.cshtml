@model ClassroomMemberResultsViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Classroom.MemberResultsTitle", Model.MemberName];
}

<section class="classroom-page">
    <section class="books-header">
        <div>
            <p class="hero-label">@Model.Classroom.Name</p>
            <h1 class="page-title">@Model.MemberName</h1>
            <p class="collection-subtitle">@Model.Results.Count @(Model.Results.Count == 1 ? Text["Classroom.AttemptOne"] : Text["Classroom.AttemptMany"])</p>
        </div>
        <a class="btn-secondary" asp-controller="Classroom" asp-action="Details" asp-route-id="@Model.Classroom.Id" asp-route-tab="results">
            @Text["Classroom.Back"]
        </a>
    </section>

    @if (Model.Results.Any())
    {
        <div class="classroom-results-table-wrap">
            <table class="admin-credit-table">
                <thead>
                    <tr>
                        <th>@Text["Settings.Quiz"]</th><th>@Text["Settings.Mode"]</th><th>@Text["Classroom.Score"]</th><th>@Text["Quiz.Correct"]</th><th>@Text["Quiz.Incorrect"]</th><th>@Text["Classroom.Skipped"]</th><th>@Text["Classroom.Completed"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results)
                    {
                        var answered = row.CorrectCount + row.IncorrectCount;
                        var score = answered == 0 ? 0 : (int)Math.Round(row.CorrectCount * 100d / answered);
                        <tr>
                            <td>@row.QuizName</td>
                            <td>@row.Mode</td>
                            <td>@score%</td>
                            <td>@row.CorrectCount</td>
                            <td>@row.IncorrectCount</td>
                            <td>@row.SkippedCount</td>
                            <td><time datetime="@row.CompletedAt.ToString("O")" data-local="datetime">@row.CompletedAt.UtcDateTime.ToString("MMM d, yyyy HH:mm")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">@Text["Classroom.NoMemberAttempts"]</div>
    }
</section>
