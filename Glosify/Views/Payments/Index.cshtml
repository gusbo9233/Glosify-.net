@model PaymentIndexViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Payments.GetCredits"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/payments.css" asp-append-version="true" />
}

<div class="content-page">
    <div class="page-heading">
        <p class="eyebrow">@Text["Payments.GlosifyCredits"]</p>
        <h1>@Text["Payments.Hero"]</h1>
        <p>@Text["Payments.Intro"]</p>
    </div>

    @if (TempData["PaymentsMessage"] is string message)
    {
        <div class="alert alert-info" role="status">@message</div>
    }

    @if (!Model.IsEnabled || Model.Packages.Count == 0)
    {
        <section class="empty-state" aria-live="polite">
            <h2>@Text["Payments.NotAvailable"]</h2>
            <p>@Text["Payments.NotConnected"]</p>
        </section>
    }
    else
    {
        <div class="card-grid">
            @foreach (var package in Model.Packages)
            {
                <article class="surface-card">
                    <p class="eyebrow">@Text["Payments.CreditPack"]</p>
                    <h2>@package.DisplayName</h2>
                    <p class="display-number">@Text["Payments.CreditCount", package.Credits]</p>
                    <p>@package.DisplayPrice</p>
                    <form asp-action="CreateCheckoutSession" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="packageKey" value="@package.Key" />
                        <button class="payment-button" type="submit">
                            @Text["Payments.ContinueCheckout"]
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                        </button>
                    </form>
                </article>
            }
        </div>
        <p class="muted-copy">@Text["Payments.StripeNotice"]</p>
        <nav class="payment-legal-links" aria-label="@Text["Legal.Label"]">
            <a asp-controller="Home" asp-action="Terms">@Text["Legal.TermsOfService"]</a>
            <a asp-controller="Home" asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
        </nav>
    }
</div>
