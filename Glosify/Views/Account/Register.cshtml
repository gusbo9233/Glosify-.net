@model RegisterViewModel
@inject Microsoft.AspNetCore.Authentication.IAuthenticationSchemeProvider SchemeProvider
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = Text["Auth.CreateAccount"];
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
    var trialGrantCredits = AiUsage.Value.TrialGrantCredits;
    var schemes = await SchemeProvider.GetAllSchemesAsync();
    ViewData["GoogleLoginEnabled"] = schemes.Any(x => x.Name == "Google");
    ViewData["MicrosoftLoginEnabled"] = schemes.Any(x => x.Name == "Microsoft");
}

<main class="auth-shell">
    <div class="brand-stack">
        <div class="brand-orb">
            <span class="material-symbols-outlined">graphic_eq</span>
        </div>
        <h1>Glosify</h1>
        <p class="brand-tagline">@Text["Auth.BrandTagline"]</p>
    </div>

    <section class="glass-card">
        <header class="auth-card-header">
            <h2>@Text["Auth.CreateAccount"]</h2>
            <p>@Text["Auth.RegisterIntro"]</p>
            <p><strong>@Text["Auth.RegisterTrialLabel", trialGrantCredits]</strong> @Text["Auth.RegisterTrialText"]</p>
        </header>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        @foreach (var provider in new[] { "Google", "Microsoft" })
        {
            if (ViewData[provider + "LoginEnabled"] is true)
            {
                <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="@provider" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button class="btn-primary-pill" type="submit">@Text["Auth.ContinueProvider", provider]</button>
                </form>
            }
        }
        @if (ViewData["GoogleLoginEnabled"] is not true && ViewData["MicrosoftLoginEnabled"] is not true)
        {
            <p role="status">@Text["Auth.SocialSignupUnavailable"]</p>
        }

        <footer class="auth-footer">
            @Text["Auth.AlreadyAccount"]
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">@Text["Common.LogIn"]</a>
        </footer>
    </section>

    <nav class="legal-links" aria-label="@Text["Legal.Label"]">
        <a asp-controller="Home" asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
        <a asp-controller="Home" asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        <a asp-controller="Home" asp-action="Support">@Text["Legal.Support"]</a>
    </nav>
</main>
