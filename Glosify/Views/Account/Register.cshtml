@model RegisterViewModel
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = Text["Auth.CreateAccount"];
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<main class="auth-shell">
    <div class="brand-stack">
        <div class="brand-orb">
            <span class="material-symbols-outlined">graphic_eq</span>
        </div>
        <h1>Glosify</h1>
        <p class="brand-tagline">@Text["Auth.BrandTagline"]</p>
    </div>

    <section class="glass-card">
        <header class="auth-card-header">
            <h2>@Text["Auth.CreateAccount"]</h2>
            <p>@Text["Auth.RegisterIntro"]</p>
            <p><strong>@Text["Auth.RegisterTrialLabel"]</strong> @Text["Auth.RegisterTrialText"]</p>
        </header>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div class="field">
                <label class="field-label" asp-for="Email">@Text["Auth.EmailAddress"]</label>
                <input asp-for="Email" type="email"
                       class="field-input"
                       placeholder="name@@domain.com" autocomplete="email" />
            </div>

            <div class="field">
                <label class="field-label" asp-for="Password">@Text["Auth.Password"]</label>
                <input asp-for="Password" type="password"
                       class="field-input"
                       placeholder="••••••••" autocomplete="new-password" />
            </div>

            <div class="field">
                <label class="field-label" asp-for="ConfirmPassword">@Text["Auth.ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" type="password"
                       class="field-input"
                       placeholder="••••••••" autocomplete="new-password" />
            </div>

            <button type="submit" class="btn-primary-pill">
                @Text["Auth.CreateAccount"]
                <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </form>

        <footer class="auth-footer">
            @Text["Auth.AlreadyAccount"]
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">@Text["Common.LogIn"]</a>
        </footer>
    </section>

    <nav class="legal-links" aria-label="@Text["Legal.Label"]">
        <a asp-controller="Home" asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
        <a asp-controller="Home" asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        <a asp-controller="Home" asp-action="Support">@Text["Legal.Support"]</a>
    </nav>
</main>
