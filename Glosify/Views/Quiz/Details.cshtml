@model QuizWorkspaceViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Model.SelectedQuiz.Name;
    ViewData["ActiveNav"] = "quizzes";
    ViewData["AssistantQuizId"] = Model.SelectedQuiz.Id;
    ViewData["AssistantContextLabel"] = Model.SelectedQuiz.Name;
    ViewData["AssistantEmptyText"] = Text["Quiz.AssistantEmpty"];
    ViewData["AssistantPlaceholder"] = Text["Quiz.AssistantPlaceholder"];
}

@section Styles {
<link rel="stylesheet" href="~/css/quiz-details.css" asp-append-version="true" />
}

<section class="workspace quiz-workspace">
    <section class="workspace-hero quiz-hero">
        <div class="workspace-hero-content">
            <p class="hero-label">@QuizLanguageDisplay.Name(Model.SelectedQuiz.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(Model.SelectedQuiz.TargetLanguage)</p>
            <h1 class="hero-title">@Model.SelectedQuiz.Name</h1>
            <p class="hero-meta">
                <span>@Model.Words.Count @(Model.Words.Count == 1 ? Text["Settings.WordLower"] : Text["Settings.WordsLower"])</span>
                <span>@Model.Sentences.Count @(Model.Sentences.Count == 1 ? Text["Settings.SentenceLower"] : Text["Settings.SentencesLower"])</span>
                <span>@Text["Quiz.CustomCount", Model.CustomQuizzes.Count()]</span>
            </p>
            <div class="hero-actions">
                <a asp-controller="Quiz" asp-action="Settings" asp-route-id="@Model.SelectedQuiz.Id" class="btn-hero">
                    @Text["Settings.StartQuiz"] <span class="material-symbols-outlined">play_circle</span>
                </a>
                <form class="custom-quiz-new-form" method="post" asp-controller="CustomQuiz" asp-action="New" asp-route-quizId="@Model.SelectedQuiz.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn-hero btn-hero-secondary" type="submit">
                        @Text["Quiz.BuildCustom"] <span class="material-symbols-outlined">dashboard_customize</span>
                    </button>
                </form>
                <form class="share-form visibility-checkbox-form" method="post" asp-controller="Quiz" asp-action="SetQuizVisibility" asp-route-id="@Model.SelectedQuiz.Id">
                    @Html.AntiForgeryToken()
                    <label class="visibility-checkbox">
                        <input type="checkbox" name="isPublic" value="true" @(Model.SelectedQuiz.IsPublic ? "checked" : "") data-submit-on-change />
                        <input type="hidden" name="isPublic" value="false" />
                        <span class="visibility-checkbox-box" aria-hidden="true"></span>
                        <span>@Text["Quiz.Public"]</span>
                    </label>
                </form>
            </div>
        </div>
    </section>
    @Html.AntiForgeryToken()

    @if (TempData[NotificationKeys.Quiz] is string quizMessage)
    {
        <div class="panel-message success">@quizMessage</div>
    }

    <form class="quick-add-bar" method="post" asp-controller="Quiz" asp-action="AddWord">
        @Html.AntiForgeryToken()
        <input type="hidden" name="quizId" value="@Model.SelectedQuiz.Id" />
        <span class="quick-add-icon" aria-hidden="true"><span class="material-symbols-outlined">add_circle</span></span>
        <div class="quick-add-fields">
            <label class="quick-add-field">
                <span class="quick-add-label">@Text["Quiz.Word"]</span>
                <input class="form-input" type="text" name="word" dir="auto" placeholder="@Text["Quiz.WordExample"]" required />
            </label>
            <label class="quick-add-field">
                <span class="quick-add-label">@Text["Reader.Translation"]</span>
                <input class="form-input" type="text" name="translation" dir="auto" placeholder="@Text["Quiz.TranslationExample"]" required />
            </label>
        </div>
        <button class="btn-submit quick-add-submit" type="submit">@Text["Quiz.AddWord"]</button>
    </form>

    <section>
        <div class="collection-header">
            <div>
                <h2 class="collection-title" id="collectionTitle">@Text["Settings.Words"]</h2>
                <p class="collection-subtitle" id="collectionSubtitle">@Text["Quiz.ItemsIn", Model.Words.Count, Text["Settings.WordsLower"], Model.SelectedQuiz.Name]</p>
            </div>
            <div class="tab-group" role="tablist" aria-label="@Text["Quiz.ContentAria"]">
                <button class="tab active" type="button" role="tab" aria-selected="true" aria-controls="wordsPanel" data-tab="words">@Text["Settings.Words"]</button>
                <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="sentencesPanel" data-tab="sentences">@Text["Settings.Sentences"]</button>
            </div>
        </div>

        <div class="tab-panel" id="wordsPanel" data-title="@Text["Settings.Words"]" data-subtitle="@Text["Quiz.ItemsIn", Model.Words.Count, Text["Settings.WordsLower"], Model.SelectedQuiz.Name]">
            <div class="word-grid" data-word-grid>
                @foreach (var word in Model.Words)
                {
                    var wiktionaryUrl = WiktionaryLink.ForWord(Model.SelectedQuiz.TargetLanguage, word.Lemma);
                    <article class="word-card">
                        <div class="word-card-main">
                            @if (wiktionaryUrl != null)
                            {
                                <a class="word-icon word-wiktionary-link"
                                   href="@wiktionaryUrl"
                                   aria-label="@Text["Quiz.OpenWiktionary", word.Lemma]"
                                   title="@Text["Quiz.OpenWiktionary", word.Lemma]">
                                    <span class="material-symbols-outlined">translate</span>
                                </a>
                            }
                            else
                            {
                                <div class="word-icon"><span class="material-symbols-outlined">translate</span></div>
                            }

                            <div class="word-card-link">
                                <div>
                                    <div class="word" dir="auto">@word.Lemma</div>
                                    <div class="translation" dir="auto">@word.Translation</div>
                                </div>
                            </div>
                        </div>
                        <div class="word-actions">
                            <button class="btn-icon-tts"
                                    type="button"
                                    data-tts="@word.Lemma"
                                    data-tts-lang="@Model.SelectedQuiz.TargetLanguage"
                                    title="@Text["Quiz.PlayPronunciationGeneric"]"
                                    aria-label="@Text["Quiz.PlayPronunciation", word.Lemma]">
                                <span class="material-symbols-outlined">volume_up</span>
                            </button>
                            <details class="item-action-menu" data-item-menu>
                                <summary aria-label="Actions for @word.Lemma"><span class="material-symbols-outlined">more_vert</span></summary>
                                <div class="item-action-popover">
                                    <button type="button" data-open-anki-item data-item-type="word" data-item-id="@word.Id" data-item-label="@word.Lemma"><span class="material-symbols-outlined">style</span> Add to Anki</button>
                                    <form method="post" asp-controller="Quiz" asp-action="DeleteWord" asp-route-id="@word.Id" data-confirm="@Text["Quiz.DeleteWordConfirm"]">
                                        @Html.AntiForgeryToken()<button type="submit"><span class="material-symbols-outlined">delete</span> Remove</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    </article>
                }
                @if (!Model.Words.Any())
                {
                    <div class="empty-state">@Text["Quiz.NoWords"]</div>
                }
            </div>
        </div>

        <div class="tab-panel" id="sentencesPanel" data-title="@Text["Settings.Sentences"]" data-subtitle="@Text["Quiz.ItemsIn", Model.Sentences.Count, Text["Settings.SentencesLower"], Model.SelectedQuiz.Name]" hidden>
            <div class="sentence-grid" data-sentence-grid>
                @foreach (var sentence in Model.Sentences)
                {
                    <article class="sentence-card">
                        <div class="sentence-card-top">
                            <div class="word-icon"><span class="material-symbols-outlined">format_quote</span></div>
                            <div>
                                <div class="sentence-text" dir="auto">@sentence.Text</div>
                                @if (!string.IsNullOrWhiteSpace(sentence.Translation))
                                {
                                    <div class="sentence-translation" dir="auto">@sentence.Translation</div>
                                }
                            </div>
                        </div>
                        <div class="sentence-meta sentence-actions">
                            <span>@Text["Quiz.LinkedWords", sentence.WordCount, sentence.WordCount == 1 ? Text["Settings.WordLower"] : Text["Settings.WordsLower"]]</span>
                            <button class="btn-icon-tts" type="button" data-tts="@sentence.Text" data-tts-lang="@Model.SelectedQuiz.TargetLanguage" aria-label="@Text["Quiz.PlayPronunciation", sentence.Text]"><span class="material-symbols-outlined">volume_up</span></button>
                            <details class="item-action-menu" data-item-menu>
                                <summary aria-label="Actions for sentence"><span class="material-symbols-outlined">more_vert</span></summary>
                                <div class="item-action-popover">
                                    <button type="button" data-open-anki-item data-item-type="sentence" data-item-id="@sentence.Id" data-item-label="@sentence.Text"><span class="material-symbols-outlined">style</span> Add to Anki</button>
                                    <form method="post" asp-controller="Quiz" asp-action="DeleteSentence" asp-route-id="@sentence.Id" data-confirm="Remove this sentence?">@Html.AntiForgeryToken()<button type="submit"><span class="material-symbols-outlined">delete</span> Remove</button></form>
                                </div>
                            </details>
                        </div>
                    </article>
                }
                @if (!Model.Sentences.Any())
                {
                    <div class="empty-state">@Text["Quiz.NoSentences"]</div>
                }
            </div>
        </div>
    </section>

    <section class="custom-quiz-library">
        <div class="collection-header">
            <div>
                <h2 class="collection-title">@Text["Quiz.CustomQuizzes"]</h2>
                <p class="collection-subtitle">@Text["Quiz.CustomHelp"]</p>
            </div>
            <form class="custom-quiz-new-form" method="post" asp-controller="CustomQuiz" asp-action="New" asp-route-quizId="@Model.SelectedQuiz.Id">
                @Html.AntiForgeryToken()
                <button class="btn-new-quiz" type="submit">
                    <span class="material-symbols-outlined">add</span> @Text["Quiz.NewCustom"]
                </button>
            </form>
        </div>
        <div class="custom-quiz-card-grid">
            @foreach (var customQuiz in Model.CustomQuizzes)
            {
                <article class="custom-quiz-card" data-custom-quiz-card>
                    <div>
                        <h3>@customQuiz.Name</h3>
                        <span class="status-pill @(customQuiz.IsPlayable ? "" : "custom-quiz-draft")">@(customQuiz.IsPlayable ? Text["Quiz.Playable"] : Text["Quiz.Draft"])</span>
                    </div>
                    <div class="custom-quiz-card-actions">
                        <a class="btn-secondary" asp-controller="CustomQuiz" asp-action="Edit" asp-route-id="@customQuiz.Id">@Text["Common.Edit"]</a>
                        @if (customQuiz.IsPlayable)
                        {
                            <a class="btn-secondary" asp-controller="CustomQuiz" asp-action="Play" asp-route-id="@customQuiz.Id">@Text["Common.Play"]</a>
                        }
                        <button class="btn-linkish" type="button" data-delete-custom-quiz data-delete-url="@Url.Action("Delete", "CustomQuiz", new { id = customQuiz.Id })">@Text["Common.Delete"]</button>
                    </div>
                </article>
            }
            @if (!Model.CustomQuizzes.Any())
            {
                <div class="empty-state empty-state-slim">@Text["Quiz.NoCustom"]</div>
            }
        </div>
    </section>
</section>

<dialog class="anki-add-dialog" data-anki-item-dialog>
    <form method="post" asp-controller="Anki" asp-action="AddItem">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuizId" value="@Model.SelectedQuiz.Id" />
        <input type="hidden" name="ItemType" data-anki-item-type />
        <input type="hidden" name="ItemId" data-anki-item-id />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
        <header><h2>Add <span data-anki-item-label></span> to Anki</h2><button class="btn-icon" type="button" data-close-anki-item aria-label="Close"><span class="material-symbols-outlined">close</span></button></header>
        @if (Model.AnkiCollections.Count > 0)
        {
            <label>Collection<select class="form-input" name="CollectionId" required>@foreach (var collection in Model.AnkiCollections) { <option value="@collection.Id">@collection.Name</option> }</select></label>
            <fieldset><legend>Directions</legend><label><input type="checkbox" name="SourceToTarget" value="true" checked /> @Model.SelectedQuiz.SourceLanguage &rarr; @Model.SelectedQuiz.TargetLanguage</label><label><input type="checkbox" name="TargetToSource" value="true" /> @Model.SelectedQuiz.TargetLanguage &rarr; @Model.SelectedQuiz.SourceLanguage</label></fieldset>
            <button class="btn-submit" type="submit">Add card</button>
        }
        else
        {
            <p>Create a compatible @Model.SelectedQuiz.SourceLanguage &rarr; @Model.SelectedQuiz.TargetLanguage collection first.</p><a class="btn-submit" asp-controller="Anki" asp-action="Index">Go to Anki</a>
        }
    </form>
</dialog>

@section Scripts {
<script src="~/js/quiz-details.js" asp-append-version="true"></script>
<script src="~/js/word-tabs.js" asp-append-version="true"></script>
}
