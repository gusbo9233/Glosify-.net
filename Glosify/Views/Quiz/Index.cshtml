@model QuizIndexViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Quiz.LibraryTitle"];
    ViewData["ActiveNav"] = "quizzes";

    var currentLanguage = Model.CurrentLanguage;
    var currentCollection = Model.CurrentCollection;
    var currentCollectionId = currentCollection?.Id;
    var childCollections = Model.Collections.Where(collection => collection.ParentCollectionId == currentCollectionId).ToList();
    var visibleQuizzes = Model.Quizzes.Where(quiz => quiz.CollectionId == currentCollectionId).ToList();
    var displayLanguage = QuizLanguageDisplay.Name(currentLanguage);
    var pageTitle = currentCollection?.Name ?? Text["Quiz.SelectQuiz"];
    var pageSubtitle = currentCollection == null
        ? Text["Quiz.ShowingLanguage", displayLanguage]
        : Text["Quiz.LanguageCollection", displayLanguage];
    var importDestination = currentCollection?.Name ?? "the top level of the quiz library";
    var jsonGenerationPrompt = $$"""
        Create a Glosify version 1 quiz-import JSON document for a learner studying {{displayLanguage}}. The import will be placed in {{importDestination}}.

        Return JSON only: no markdown fence, prose, ids, visibility, target_language, or custom-quiz fields. Put words and sentence text in {{displayLanguage}} and translations in source_language. Each quiz needs at least one word or sentence. Use one root source_language and add a per-quiz source_language only when it differs.

        Shape:
        {
          "version": 1,
          "source_language": "English",
          "quizzes": [
            {
              "name": "Quiz name",
              "words": [{ "word": "word or short phrase", "translation": "translation" }],
              "sentences": [{ "text": "full sentence", "translation": "translation" }]
            }
          ],
          "collections": [
            {
              "name": "Collection name",
              "quizzes": [],
              "collections": []
            }
          ]
        }

        Limits: 25 collections, five collection levels, 50 quizzes, 100 items per quiz, and 1,000 items total. Preserve the requested learning content and use natural translations.
        """;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-library.css" asp-append-version="true" />
}

<section class="select-quiz-page library-page" data-quiz-library data-move-quiz-url="@Url.Action("MoveQuizToCollection", "Quiz")">
    <header class="select-header library-hero">
        <div class="select-heading">
            <p class="select-kicker">
                <span class="material-symbols-outlined" aria-hidden="true">stacks</span>
                @Text["Quiz.Library"] <span class="select-kicker-separator">/</span> @displayLanguage
            </p>
            <h1 class="select-title">@pageTitle</h1>
            <p class="select-subtitle">
                @pageSubtitle
                @if (currentCollection == null)
                {
                    <a class="language-change-link" asp-controller="Languages" asp-action="Index">@Text["Quiz.ChangeLanguage"]</a>
                }
            </p>
            @if (currentCollection != null)
            {
                <form class="share-form collection-share-form" method="post" asp-controller="Quiz" asp-action="SetCollectionVisibility" asp-route-id="@currentCollection.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isPublic" value="@(currentCollection.IsPublic ? "false" : "true")" />
                    <button class="btn-inline-share" type="submit">
                        <span class="material-symbols-outlined">@(currentCollection.IsPublic ? "lock" : "public")</span>
                        @(currentCollection.IsPublic ? Text["Quiz.MakePrivate"] : Text["Quiz.MakePublic"])
                    </button>
                    <span class="status-pill">@(currentCollection.IsPublic ? Text["Quiz.PublicSubtree"] : Text["Quiz.Private"])</span>
                </form>
            }
            <div class="library-overview" aria-label="@Text["Quiz.LibrarySummary"]">
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
                    <strong>@childCollections.Count</strong> @(childCollections.Count == 1 ? Text["Quiz.CollectionOne"] : Text["Quiz.CollectionMany"])
                </span>
                <span class="overview-item">
                    <span class="material-symbols-outlined" aria-hidden="true">quiz</span>
                    <strong>@visibleQuizzes.Count</strong> @(visibleQuizzes.Count == 1 ? Text["Quiz.QuizOne"] : Text["Quiz.QuizMany"])
                </span>
            </div>
        </div>
        <div class="select-actions">
            @if (currentCollection != null)
            {
                if (Model.ParentCollection != null)
                {
                    <a class="btn-new-quiz btn-back-library" asp-controller="Quiz" asp-action="Collection" asp-route-id="@Model.ParentCollection.Id">
                        <span class="material-symbols-outlined">arrow_back</span>
                        @Text["Common.Back"]
                    </a>
                }
                else
                {
                    <a class="btn-new-quiz btn-back-library" asp-controller="Quiz" asp-action="Index">
                        <span class="material-symbols-outlined">arrow_back</span>
                        @Text["Common.Back"]
                    </a>
                }
            }
            <button class="btn-new-quiz btn-secondary-action" type="button" data-modal-open="jsonImportModal" aria-label="Import JSON">
                <span class="material-symbols-outlined" aria-hidden="true">data_object</span>
                Import JSON
            </button>
            <button class="btn-new-quiz btn-secondary-action" type="button" data-modal-open="createCollectionModal">
                <span class="material-symbols-outlined">create_new_folder</span>
                @Text["Quiz.NewCollection"]
            </button>
            <button class="btn-new-quiz" type="button" data-modal-open="createModal">
                <span class="material-symbols-outlined">add</span>
                @Text["Quiz.NewQuiz"]
            </button>
        </div>
    </header>

    @if (TempData[NotificationKeys.Quiz] is string quizMessage)
    {
        <div class="page-message">@quizMessage</div>
    }

    @if (childCollections.Any())
    {
        <section class="library-section library-section--collections" aria-labelledby="collectionsHeading">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="collectionsHeading">@Text["Quiz.Collections"] <span class="section-count">@childCollections.Count</span></h2>
                    <p>@Text["Quiz.CollectionsHelp"]</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var collection in childCollections)
                {
                    var childCollectionCount = Model.Collections.Count(child => child.ParentCollectionId == collection.Id);
                    var quizCount = Model.Quizzes.Count(quiz => quiz.CollectionId == collection.Id);

                    <article class="quiz-card collection-card"
                             data-collection-drop-target
                             data-collection-id="@collection.Id"
                             aria-label="@Text["Quiz.DropInto", collection.Name]">
                        <a class="quiz-card-link" asp-controller="Quiz" asp-action="Collection" asp-route-id="@collection.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon collection-icon"><span class="material-symbols-outlined">folder</span></div>
                                <span class="quiz-card-kind">@Text["Quiz.CollectionOne"]</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@collection.Name</h2>
                            <p class="quiz-languages">@QuizLanguageDisplay.Name(collection.Language)</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@collection.CreatedAt.ToString("d")</span>
                            <span class="status-pill">@quizCount @(quizCount == 1 ? Text["Quiz.QuizOne"] : Text["Quiz.QuizMany"]) &middot; @Text["Quiz.NestedCount", childCollectionCount]</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (visibleQuizzes.Any())
    {
        <section class="library-section library-section--quizzes" aria-labelledby="quizzesHeading">
            <div class="library-section-header">
                <div class="library-section-copy">
                    <h2 id="quizzesHeading">@Text["Quiz.YourQuizzes"] <span class="section-count">@visibleQuizzes.Count</span></h2>
                    <p>@(childCollections.Any() ? Text["Quiz.DragHelp"] : Text["Quiz.ChooseHelp"])</p>
                </div>
            </div>
            <div class="quiz-grid">
                @foreach (var quiz in visibleQuizzes)
                {
                    <article class="quiz-card"
                             draggable="true"
                             data-quiz-card
                             data-quiz-id="@quiz.Id">
                        <a class="quiz-card-link" draggable="false" asp-controller="Quiz" asp-action="Details" asp-route-id="@quiz.Id">
                            <div class="quiz-card-top">
                                <div class="quiz-icon"><span class="material-symbols-outlined">quiz</span></div>
                                <span class="quiz-card-kind">@Text["Quiz.QuizOne"]</span>
                                <span class="material-symbols-outlined quiz-arrow" aria-hidden="true">arrow_outward</span>
                            </div>
                            <h2 class="quiz-name">@quiz.Name</h2>
                            <p class="quiz-languages">@QuizLanguageDisplay.Name(quiz.SourceLanguage) &rarr; @QuizLanguageDisplay.Name(quiz.TargetLanguage)</p>
                        </a>
                        <div class="quiz-meta">
                            <span class="quiz-date"><span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>@quiz.CreatedAt.ToString("d")</span>
                            <div class="quiz-meta-actions">
                                <span class="status-pill"><span class="status-dot" aria-hidden="true"></span>@quiz.ProcessingStatus</span>
                                <form class="delete-form" method="post" asp-controller="Quiz" asp-action="DeleteQuiz" asp-route-id="@quiz.Id" data-confirm="@Text["Quiz.DeleteConfirm"]">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-delete" type="submit" aria-label="@Text["Quiz.DeleteNamed", quiz.Name]" title="@Text["Quiz.Delete"]">
                                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    else if (!childCollections.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><span class="material-symbols-outlined">library_add</span></div>
            <h2 class="empty-title">@Text["Quiz.EmptyTitle"]</h2>
            <p class="empty-copy">@Text["Quiz.EmptyText"]</p>
            <div class="empty-actions">
                <button class="btn-new-quiz btn-secondary-action" type="button" data-modal-open="jsonImportModal" aria-label="Import JSON">
                    <span class="material-symbols-outlined" aria-hidden="true">data_object</span>
                    Import JSON
                </button>
                <button class="btn-new-quiz btn-secondary-action" type="button" data-modal-open="createCollectionModal">
                    <span class="material-symbols-outlined">create_new_folder</span>
                    @Text["Quiz.CreateCollection"]
                </button>
                <button class="btn-new-quiz" type="button" data-modal-open="createModal">
                    <span class="material-symbols-outlined">add</span>
                    @Text["Quiz.CreateQuiz"]
                </button>
            </div>
        </div>
    }
</section>

<div class="modal-backdrop" id="createCollectionModal">
    <div class="modal">
        <h2 class="modal-title">@Text["Quiz.CreateNewCollection"]</h2>
        <form method="post" asp-controller="Quiz" asp-action="CreateCollection">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label" for="collectionName">@Text["Quiz.CollectionName"]</label>
                <input class="form-input" id="collectionName" type="text" name="Name" placeholder="@Text["Quiz.CollectionExample"]" required />
            </div>
            <input type="hidden" name="ParentCollectionId" value="@currentCollectionId" />
            <div class="modal-actions">
                <button type="button" class="btn-cancel" data-modal-close>@Text["Common.Cancel"]</button>
                <button type="submit" class="btn-create">@Text["Quiz.CreateCollection"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-backdrop" id="jsonImportModal">
    <div class="modal json-import-modal" role="dialog" aria-modal="true" aria-labelledby="jsonImportTitle">
        <header class="json-import-header">
            <div>
                <p class="json-import-kicker">External AI import</p>
                <h2 class="modal-title" id="jsonImportTitle">Create quizzes without using credits</h2>
                <p>Ask any AI for Glosify JSON, paste it here, review the exact result, and import it into <strong>@importDestination</strong>.</p>
            </div>
            <button class="json-import-close" type="button" data-modal-close aria-label="Close import dialog">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </header>

        <details class="json-import-instructions">
            <summary>1. Copy instructions for your AI</summary>
            <p>Add what you want to learn, then send this prompt to ChatGPT, Claude, Gemini, or another AI.</p>
            <textarea class="json-import-prompt" data-json-import-generation-prompt readonly>@jsonGenerationPrompt</textarea>
            <button class="json-import-copy" type="button" data-copy-json-import-prompt>
                <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                Copy AI instructions
            </button>
        </details>

        <form class="json-import-form"
              data-json-import-form
              data-preview-url="@Url.Action("PreviewJsonImport", "QuizImport")"
              data-repair-url="@Url.Action("RepairJsonImportWithAi", "QuizImport")"
              data-apply-url="@Url.Action("ApplyJsonImport", "QuizImport")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ParentCollectionId" value="@currentCollectionId" />
            <div class="form-group">
                <label class="form-label" for="jsonImportText">2. Paste generated JSON</label>
                <textarea class="json-import-textarea"
                          id="jsonImportText"
                          name="Json"
                          data-json-import-text
                          maxlength="65536"
                          spellcheck="false"
                          placeholder="Paste the JSON object here..."
                          required></textarea>
                <div class="json-import-input-meta">
                    <span>Free preview and import · no AI call</span>
                    <span data-json-import-size>0 / 64 KiB</span>
                </div>
            </div>

            <div class="json-import-status" data-json-import-status aria-live="polite" hidden></div>
            <div class="json-import-errors" data-json-import-errors hidden></div>

            <section class="json-import-preview" data-json-import-preview hidden aria-labelledby="jsonImportPreviewTitle">
                <div class="json-import-preview-header">
                    <div>
                        <p class="json-import-kicker">3. Review before creating</p>
                        <h3 id="jsonImportPreviewTitle">Import preview</h3>
                    </div>
                    <div class="json-import-totals" data-json-import-totals></div>
                </div>
                <div class="json-import-tree" data-json-import-tree></div>
                <div class="json-import-warnings" data-json-import-warnings hidden></div>
            </section>

            <section class="json-import-success" data-json-import-success hidden aria-live="polite"></section>

            <div class="json-import-actions">
                <button class="btn-cancel" type="button" data-modal-close>Cancel</button>
                <button class="json-import-copy json-import-copy--repair" type="button" data-copy-json-repair-prompt hidden>
                    Copy repair prompt
                </button>
                <button class="json-import-ai-repair" type="button" data-json-import-ai-repair hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">auto_fix_high</span>
                    Repair with AI · uses credits
                </button>
                <button class="btn-create" type="button" data-json-import-preview-button>Preview JSON</button>
                <button class="btn-create" type="button" data-json-import-apply hidden>Import everything</button>
            </div>
        </form>

        <p class="json-import-privacy">
            Preview and import are deterministic and do not contact an AI provider. “Repair with AI” sends the pasted text to Glosify’s configured AI and charges credits.
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/quiz-library.js" asp-append-version="true"></script>
    <script type="module" src="~/js/quiz-json-import.js" asp-append-version="true"></script>
}

<div class="modal-backdrop" id="createModal">
    <div class="modal">
        <h2 class="modal-title">@Text["Quiz.CreateNewQuiz"]</h2>
        <form method="post" asp-controller="Quiz" asp-action="Create">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CollectionId" value="@currentCollectionId" />
            <div class="form-group">
                <label class="form-label" for="quizName">@Text["Quiz.Name"]</label>
                <input class="form-input" id="quizName" type="text" name="Name" placeholder="@Text["Quiz.NameExample"]" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="quizSourceLanguage">@Text["Quiz.SourceLanguage"]</label>
                <select class="select-input" id="quizSourceLanguage" name="SourceLanguage" required>
                    <option value="">@Text["Quiz.SelectLanguage"]</option>
                    @foreach (var language in Glosify.Services.Language.QuizLanguageCatalog.All)
                    {
                        <option value="@language.Name">@QuizLanguageDisplay.Name(language.Name)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">@Text["Quiz.TargetLanguage"]</label>
                <input type="hidden" name="TargetLanguage" value="@currentLanguage" />
                <div class="form-input target-language-display">
                    <span>@displayLanguage</span>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" data-modal-close>@Text["Common.Cancel"]</button>
                <button type="submit" class="btn-create">@Text["Quiz.CreateQuiz"]</button>
            </div>
        </form>
    </div>
</div>
