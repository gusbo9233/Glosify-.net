@model QuizSettingsViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Settings.Title"];
    ViewData["ActiveNav"] = "quizzes";

    var quizName = Model.SelectedQuiz?.Name ?? Text["Settings.FlashcardQuiz"];
    var availableWords = Model.AvailableWordCount;
    var availableSentences = Model.AvailableSentenceCount;
    var selectedWordCount = Model.SelectedWordCount;
    var tenCount = Math.Min(10, Math.Max(availableWords, 1));
    var twentyCount = Math.Min(20, Math.Max(availableWords, 1));
    var allCount = Math.Max(availableWords, 1);
    var sentenceTenCount = Math.Min(10, Math.Max(availableSentences, 1));
    var sentenceTwentyCount = Math.Min(20, Math.Max(availableSentences, 1));
    var sentenceAllCount = Math.Max(availableSentences, 1);
    var sourceLanguage = QuizLanguageDisplay.Name(Model.SelectedQuiz?.SourceLanguage) ?? Text["Settings.Source"];
    var targetLanguage = QuizLanguageDisplay.Name(Model.SelectedQuiz?.TargetLanguage) ?? Text["Settings.Target"];
}

@if (Model.SelectedQuiz is not null)
{
    <section class="settings-shell anki-settings-panel">
        <header class="settings-header"><span class="config-badge">Tracked flashcards</span><h2 class="section-title">Add this quiz to Anki</h2><p class="page-subtitle">Link the whole quiz to a compatible collection. New quiz content will stay synchronized.</p></header>
        @if (Model.AnkiCollections.Count > 0)
        {
            <form method="post" asp-controller="Anki" asp-action="AddQuiz" class="anki-settings-form">
                @Html.AntiForgeryToken()<input type="hidden" name="QuizId" value="@Model.SelectedQuiz.Id"/>
                <label>Collection<select class="form-input" name="CollectionId">@foreach (var collection in Model.AnkiCollections) { <option value="@collection.Id">@collection.Name</option> }</select></label>
                <fieldset><legend>Words</legend><label><input type="checkbox" name="WordsSourceToTarget" value="true" checked/> @sourceLanguage &rarr; @targetLanguage</label><label><input type="checkbox" name="WordsTargetToSource" value="true"/> @targetLanguage &rarr; @sourceLanguage</label></fieldset>
                <fieldset><legend>Sentences</legend><label><input type="checkbox" name="SentencesSourceToTarget" value="true"/> @sourceLanguage &rarr; @targetLanguage</label><label><input type="checkbox" name="SentencesTargetToSource" value="true"/> @targetLanguage &rarr; @sourceLanguage</label></fieldset>
                <button class="btn-secondary" type="submit">Link quiz</button>
            </form>
        }
        <details class="anki-create-inline">
            <summary>Create a new compatible collection</summary>
            <form method="post" asp-controller="Anki" asp-action="CreateFromQuiz" class="anki-settings-form">
                @Html.AntiForgeryToken()<input type="hidden" name="QuizId" value="@Model.SelectedQuiz.Id"/><input type="hidden" name="TimeZoneId" value="UTC" data-browser-timezone/>
                <label>Name<input class="form-input" name="Name" required maxlength="160"/></label>
                <fieldset><legend>Words</legend><label><input type="checkbox" name="WordsSourceToTarget" value="true" checked/> @sourceLanguage &rarr; @targetLanguage</label><label><input type="checkbox" name="WordsTargetToSource" value="true"/> @targetLanguage &rarr; @sourceLanguage</label></fieldset>
                <fieldset><legend>Sentences</legend><label><input type="checkbox" name="SentencesSourceToTarget" value="true"/> @sourceLanguage &rarr; @targetLanguage</label><label><input type="checkbox" name="SentencesTargetToSource" value="true"/> @targetLanguage &rarr; @sourceLanguage</label></fieldset>
                <button class="btn-secondary" type="submit">Create and link</button>
            </form>
        </details>
    </section>
}

<form class="settings-shell" method="post" asp-controller="Quiz" asp-action="Start">
    @Html.AntiForgeryToken()
    <input type="hidden" name="QuizId" value="@Model.SelectedQuiz?.Id" />

    <header class="settings-header">
        <span class="config-badge">@Text["Settings.Configuration"]</span>
        <h1 class="page-title">@quizName</h1>
        <p class="page-subtitle">@Text["Settings.Intro"]</p>
    </header>

    <div class="settings-grid">
        <section class="settings-panel">
            <div>
                <div class="section-header">
                    <div>
                        <h2 class="section-title">@Text["Settings.SessionLength"]</h2>
                        <p class="section-note"><span data-available-count>@availableWords</span> <span data-available-label>@Text["Settings.Words"]</span> @Text["Settings.AvailableLower"]</p>
                    </div>
                    <span class="material-symbols-outlined">timer</span>
                </div>
                <div class="length-grid">
                    <label class="choice">
                        <input type="radio" name="WordCount" value="@tenCount" data-word-value="@tenCount" data-sentence-value="@sentenceTenCount" @(selectedWordCount <= 10 ? "checked" : "") />
                        <span class="choice-card"><span class="num" data-length-num>@tenCount</span><span class="label">@Text["Settings.Quick"]</span></span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="WordCount" value="@twentyCount" data-word-value="@twentyCount" data-sentence-value="@sentenceTwentyCount" @(selectedWordCount > 10 && selectedWordCount <= 20 ? "checked" : "") />
                        <span class="choice-card"><span class="num" data-length-num>@twentyCount</span><span class="label">@Text["Settings.Standard"]</span></span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="WordCount" value="@allCount" data-word-value="@allCount" data-sentence-value="@sentenceAllCount" data-word-total="@availableWords" data-sentence-total="@availableSentences" data-length-all @(selectedWordCount > 20 ? "checked" : "") />
                        <span class="choice-card"><span class="num" data-length-num>@allCount</span><span class="label">@Text["Common.All"]</span></span>
                    </label>
                </div>
            </div>

            <div>
                <div class="section-header">
                    <div>
                        <h2 class="section-title">@Text["Settings.WordRange"]</h2>
                        <p class="section-note">@Text["Settings.RangeHelp"]</p>
                    </div>
                    <span class="material-symbols-outlined">tune</span>
                </div>
                <div class="range-presets">
                    <button type="button" class="range-preset" data-range-preset="0,100">@Text["Common.All"]</button>
                    <button type="button" class="range-preset" data-range-preset="80,100">@Text["Settings.Newest20"]</button>
                    <button type="button" class="range-preset" data-range-preset="50,100">@Text["Settings.Newest50"]</button>
                    <button type="button" class="range-preset" data-range-preset="0,20">@Text["Settings.Oldest20"]</button>
                </div>
                <div class="range-slider" data-range-slider>
                    <div class="range-slider-track">
                        <div class="range-slider-fill" data-range-fill></div>
                    </div>
                    <input type="range" name="WordRangeStart" min="0" max="100" step="5" value="0" class="range-thumb range-thumb-min" data-range-min />
                    <input type="range" name="WordRangeEnd" min="0" max="100" step="5" value="100" class="range-thumb range-thumb-max" data-range-max />
                </div>
                <p class="range-slider-label" data-range-label>@Text["Settings.AllWordsOrder"]</p>

                <input type="hidden" name="SelectedWordIds" data-selected-word-ids value="" />
                <div class="word-picker-row" data-word-picker-row>
                    <button type="button" class="range-preset" data-open-word-picker>
                        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:-3px;">checklist</span>
                        @Text["Settings.ChooseIndividually"]
                    </button>
                    <span class="word-picker-summary" data-word-picker-summary hidden></span>
                    <button type="button" class="word-picker-clear" data-clear-word-picker hidden>@Text["Settings.ClearSelection"]</button>
                </div>

                <dialog class="word-picker-dialog" data-word-picker-dialog>
                    <div class="word-picker-header">
                        <h3>@Text["Settings.ChooseWords"]</h3>
                        <button type="button" class="btn-icon" data-close-word-picker aria-label="@Text["Common.Close"]">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <div class="word-picker-toolbar">
                        <button type="button" class="range-preset" data-select-all>@Text["Settings.SelectAll"]</button>
                        <button type="button" class="range-preset" data-deselect-all>@Text["Settings.DeselectAll"]</button>
                        <input type="search" class="word-picker-search" placeholder="@Text["Settings.FilterWords"]" data-word-picker-search />
                        <span class="word-picker-count" data-word-picker-count></span>
                    </div>
                    <div class="word-picker-list">
                        @foreach (var word in Model.Words)
                        {
                            <label class="word-picker-item" data-word-picker-item data-lemma="@word.Lemma.ToLowerInvariant()" data-translation="@word.Translation.ToLowerInvariant()">
                                <input type="checkbox" class="word-picker-checkbox" data-word-picker-checkbox value="@word.Id" checked />
                                <span class="word-picker-lemma" dir="auto">@word.Lemma</span>
                                <span class="word-picker-translation" dir="auto">@word.Translation</span>
                            </label>
                        }
                    </div>
                    <div class="word-picker-footer">
                        <button type="button" class="btn-start" data-apply-word-picker>@Text["Settings.ApplySelection"]</button>
                    </div>
                </dialog>
            </div>

            <div>
                <div class="section-header">
                    <div>
                        <h2 class="section-title">@Text["Settings.PracticeContent"]</h2>
                        <p class="section-note">@Text["Settings.ContentHelp"]</p>
                    </div>
                    <span class="material-symbols-outlined">subject</span>
                </div>
                <div class="mode-grid">
                    <label class="choice">
                        <input type="radio" name="PracticeItemType" value="words" checked data-item-label="@Text["Settings.Words"]" data-count="@availableWords" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">short_text</span>
                            <span class="mode-name">@Text["Settings.Words"]</span>
                        </span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="PracticeItemType" value="sentences" data-item-label="@Text["Settings.Sentences"]" data-count="@availableSentences" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">notes</span>
                            <span class="mode-name">@Text["Settings.Sentences"]</span>
                        </span>
                    </label>
                </div>
            </div>

            <div>
                <div class="section-header">
                    <div>
                        <h2 class="section-title">@Text["Settings.QuizMode"]</h2>
                        <p class="section-note">@Text["Settings.ModeHelp"]</p>
                    </div>
                    <span class="material-symbols-outlined">psychology</span>
                </div>
                <div class="mode-grid">
                    <label class="choice">
                        <input type="radio" name="Mode" value="flashcards" checked />
                        <span class="choice-card">
                            <span class="material-symbols-outlined material-symbols-filled">style</span>
                            <span class="mode-name">@Text["Settings.Flashcards"]</span>
                        </span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="Mode" value="typing" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">keyboard</span>
                            <span class="mode-name">@Text["Settings.Typing"]</span>
                        </span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="Mode" value="multiple-choice" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">checklist</span>
                            <span class="mode-name">@Text["Settings.Choices"]</span>
                        </span>
                    </label>
                </div>
            </div>

            <div>
                <div class="section-header">
                    <div>
                        <h2 class="section-title">@Text["Settings.PracticeDirection"]</h2>
                        <p class="section-note">@Text["Settings.DirectionHelp"]</p>
                    </div>
                    <span class="material-symbols-outlined">swap_horiz</span>
                </div>
                <div class="mode-grid">
                    <label class="choice">
                        <input type="radio" name="PracticeDirection" value="source-to-target" checked data-direction-label="@sourceLanguage -> @targetLanguage" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">east</span>
                            <span class="mode-name">@sourceLanguage &rarr; @targetLanguage</span>
                        </span>
                    </label>
                    <label class="choice">
                        <input type="radio" name="PracticeDirection" value="target-to-source" data-direction-label="@targetLanguage -> @sourceLanguage" />
                        <span class="choice-card">
                            <span class="material-symbols-outlined">west</span>
                            <span class="mode-name">@targetLanguage &rarr; @sourceLanguage</span>
                        </span>
                    </label>
                </div>
            </div>
        </section>

        <aside class="start-panel">
            @if (availableWords == 0)
            {
                <div class="empty-callout" data-empty-callout>@Text["Settings.NeedWord"]</div>
            }
            else
            {
                <div class="empty-callout" data-empty-callout hidden>@Text["Settings.NeedWord"]</div>
            }
            <div class="stat-row"><span>@Text["Settings.Quiz"]</span><span>@quizName</span></div>
            <div class="stat-row"><span>@Text["Settings.Content"]</span><span data-selected-content>@Text["Settings.Words"]</span></div>
            <div class="stat-row"><span>@Text["Settings.Available"]</span><span data-selected-available>@availableWords</span></div>
            <div class="stat-row"><span>@Text["Settings.Mode"]</span><span data-selected-mode>@Text["Settings.Flashcards"]</span></div>
            <div class="stat-row"><span>@Text["Settings.Range"]</span><span data-selected-range>@Text["Common.All"]</span></div>
            <div class="stat-row"><span>@Text["Settings.Direction"]</span><span data-selected-direction>@sourceLanguage -> @targetLanguage</span></div>
            <button class="btn-start" type="submit" data-start-button @(availableWords == 0 ? "disabled" : "")>
                <span class="material-symbols-outlined">play_circle</span>
                @Text["Settings.StartQuiz"]
            </button>
        </aside>
    </div>
</form>

<style>
    .anki-settings-panel{margin-bottom:1.25rem}.anki-settings-form{display:grid;grid-template-columns:minmax(180px,1fr) 1fr 1fr auto;gap:1rem;align-items:end}.anki-settings-form fieldset{display:grid;gap:.35rem;border:1px solid var(--border-color,#ddd);border-radius:10px}.anki-create-inline{margin-top:1rem}.anki-create-inline summary{cursor:pointer;font-weight:600}.anki-create-inline form{margin-top:1rem}@@media(max-width:900px){.anki-settings-form{grid-template-columns:1fr}}
</style>

@section Scripts {
<script src="~/js/quiz-settings.js" asp-append-version="true"></script>
}
