@using System.Security.Claims
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Authorization
@using Glosify.Services.Auth
@inject IAuthorizationService AuthorizationService
@inject IWebHostEnvironment HostEnvironment
@inject IStripePaymentService StripePayments
@{
    var speakingIsAvailable = !HostEnvironment.IsProduction()
        || (await AuthorizationService.AuthorizeAsync(
            User,
            AuthorizationPolicyNames.SpeakingAvailability)).Succeeded;
}
@functions {
    string MetaDescription => ViewData["Description"] as string ?? Text["Layout.MetaDescription"];

    string CurrentController => (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    string CurrentAction => (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
    string DisplayAccount => User.FindFirstValue(ClaimTypes.Email)
        ?? User.Identity?.Name
        ?? Text["Layout.SignedIn"];

    bool IsActive(string controller, string action) =>
        CurrentController == controller.ToLowerInvariant() && CurrentAction == action.ToLowerInvariant();

    bool IsQuizzesActive() =>
        CurrentController == "quiz"
        || CurrentController == "quizzes"
        || CurrentController == "flashcardquiz"
        || CurrentController == "typingquiz"
        || CurrentController == "customquiz";

    string NavClass(string controller, string action = "Index") =>
        IsActive(controller, action) ? "app-nav-item is-active" : "app-nav-item";

    string QuizzesNavClass() =>
        IsQuizzesActive() ? "app-nav-item is-active" : "app-nav-item";

    Guid? AssistantGuid(string key)
    {
        var value = ViewData[key];
        if (value is Guid guid)
        {
            return guid;
        }
        if (value is string text && Guid.TryParse(text, out var parsed))
        {
            return parsed;
        }
        return null;
    }

    int? AssistantInt(string key)
    {
        var value = ViewData[key];
        if (value is int number)
        {
            return number;
        }
        if (value is string text && int.TryParse(text, out var parsed))
        {
            return parsed;
        }
        return null;
    }

    string AssistantText(string key, string fallback) =>
        ViewData[key] as string ?? fallback;

    IHtmlContent NavIcon(string name)
    {
        var paths = name switch
        {
            "language" => """
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18"></path>
                <path d="M12 3a13 13 0 0 1 0 18"></path>
                <path d="M12 3a13 13 0 0 0 0 18"></path>
                """,
            "home" => """
                <path d="M3 10.5 12 3l9 7.5"></path>
                <path d="M5 9.5V21h14V9.5"></path>
                <path d="M9 21v-6h6v6"></path>
                """,
            "explore" => """
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8 4.8-2.2Z"></path>
                """,
            "menu_book" => """
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H7a3 3 0 0 0-3 3V5.5Z"></path>
                <path d="M4 5.5V22"></path>
                <path d="M8 7h8"></path>
                <path d="M8 11h7"></path>
                """,
            "fitness_center" => """
                <path d="M6.5 6.5 17.5 17.5"></path>
                <path d="m4 9 5-5"></path>
                <path d="m15 20 5-5"></path>
                <path d="M2.5 6.5 6.5 2.5"></path>
                <path d="m17.5 21.5 4-4"></path>
                """,
            "subscriptions" => """
                <rect x="4" y="7" width="16" height="12" rx="2"></rect>
                <path d="M8 3h8"></path>
                <path d="m10 11 5 2.5-5 2.5v-5Z"></path>
                """,
            "auto_stories" => """
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"></path>
                <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v16h4.5A2.5 2.5 0 0 1 20 21.5v-16Z"></path>
                <path d="M8 7h1"></path>
                <path d="M15 7h1"></path>
                """,
            "quiz" => """
                <path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14l-4-3H6a2 2 0 0 1-2-2V5Z"></path>
                <path d="M9.5 8.5a2.5 2.5 0 0 1 5 0c0 2-2.5 2-2.5 4"></path>
                <path d="M12 16h.01"></path>
                """,
            "anki" => """
                <rect x="3" y="5" width="15" height="16" rx="2"></rect>
                <path d="M7 2h12a2 2 0 0 1 2 2v13"></path>
                <path d="M7 10h7"></path>
                <path d="M10.5 6.5v7"></path>
                """,
            "school" => """
                <path d="m12 4 10 5-10 5L2 9l10-5Z"></path>
                <path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"></path>
                <path d="M22 9v5"></path>
                """,
            "mic" => """
                <rect x="9" y="3" width="6" height="11" rx="3"></rect>
                <path d="M5.5 11a6.5 6.5 0 0 0 13 0"></path>
                <path d="M12 17.5V21"></path>
                <path d="M9 21h6"></path>
                """,
            "subtitles" => """
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M7 11h4"></path>
                <path d="M14 11h3"></path>
                <path d="M7 15h3"></path>
                <path d="M13 15h4"></path>
                """,
            _ => """
                <circle cx="12" cy="12" r="9"></circle>
                """
        };

        return new HtmlString($"""
            <svg class="nav-svg-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {paths}
            </svg>
            """);
    }
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-display-culture="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" />
    <title>@ViewData["Title"] - Glosify</title>
    <meta name="description" content="@MetaDescription" />
    @await Html.PartialAsync("_LocalizedPublicSeo")
    @* The font files come from a second origin, so both are preconnected before
       the stylesheets are even parsed. Text and icons are separate requests
       because they need different font-display behavior — see WebFonts. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@WebFonts.TextStylesheetUrl" rel="stylesheet" />
    <link href="@WebFonts.IconStylesheetUrl" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="app-body" data-i18n="@System.Text.Json.JsonSerializer.Serialize(UiClientText.Create(Text))">
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-sidebar-brand">
                <h1 class="wordmark">
                    <a asp-controller="Home" asp-action="Index">Glosify</a>
                </h1>
                <p class="brand-tier">@Text["Layout.PremiumLearner"]</p>
                @await Component.InvokeAsync("LanguagePill")
            </div>

            <nav class="app-nav">
                <a class="@NavClass("Languages")" asp-controller="Languages" asp-action="Index">
                    @NavIcon("language")
                    @Text["Nav.LanguageSelector"]
                </a>
                <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
                    @NavIcon("home")
                    @Text["Nav.Home"]
                </a>
                <a class="@NavClass("Explore")" asp-controller="Explore" asp-action="Index">
                    @NavIcon("explore")
                    @Text["Nav.Explore"]
                </a>
                <a class="@NavClass("Books")" asp-controller="Books" asp-action="Index">
                    @NavIcon("auto_stories")
                    @Text["Nav.Books"]
                </a>
                <a class="@NavClass("Transcripts")" asp-controller="Transcripts" asp-action="Index">
                    @NavIcon("subtitles")
                    @Text["Nav.Transcripts"]
                </a>
                <a class="@QuizzesNavClass()" asp-controller="Quiz" asp-action="Index">
                    @NavIcon("quiz")
                    @Text["Nav.Quizzes"]
                </a>
                <a class="@NavClass("Anki")" asp-controller="Anki" asp-action="Index">
                    @NavIcon("anki")
                    Anki
                </a>
                @if (speakingIsAvailable)
                {
                    <a class="@NavClass("Speaking")" asp-controller="Speaking" asp-action="Index">
                        @NavIcon("mic")
                        @Text["Nav.Speaking"]
                    </a>
                }
                else
                {
                    <span class="app-nav-item is-disabled" aria-disabled="true" data-speaking-unavailable
                          title="@Text["Speaking.Unavailable"]">
                        @NavIcon("mic")
                        @Text["Nav.Speaking"]
                    </span>
                }
                <a class="@NavClass("Classroom")" asp-controller="Classroom" asp-action="Index">
                    @NavIcon("school")
                    @Text["Nav.Classrooms"]
                </a>
                @if (User.Identity?.IsAuthenticated == true && StripePayments.IsEnabled)
                {
                    <a class="@NavClass("Payments")" asp-controller="Payments" asp-action="Index">
                        @NavIcon("subscriptions")
                        @Text["Layout.GetCredits"]
                    </a>
                }
            </nav>

        </aside>

        <main class="app-main">
            <header class="app-topbar">
                <a class="app-mobile-brand" asp-controller="Home" asp-action="Index" aria-label="Glosify @Text["Nav.Home"]">
                    Glosify
                </a>
                <div class="app-search">
                    <span class="material-symbols-outlined">search</span>
                    <input placeholder="@Text["Layout.SearchPlaceholder"]" type="text" />
                </div>
                <div class="app-topbar-right">
                    @await Html.PartialAsync("_DisplayLanguageSelector")
                    <button type="button" class="icon-button" aria-label="@Text["Layout.Notifications"]">
                        <span class="material-symbols-outlined">notifications</span>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (StripePayments.IsEnabled)
                        {
                            <a class="credit-pill credit-pill-buy" asp-controller="Payments" asp-action="Index">
                                <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
                                @Text["Layout.GetCredits"]
                            </a>
                        }
                        @await Component.InvokeAsync("AiCreditPill")
                        <div class="account-block">
                            <div class="account-meta">
                                <span class="account-meta-eyebrow">@Text["Layout.SignedInAs"]</span>
                                <span class="account-meta-email">@DisplayAccount</span>
                            </div>
                            <div class="account-avatar" title="@DisplayAccount">
                                <span class="material-symbols-outlined">account_circle</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="btn-social-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-button" title="@Text["Common.LogOut"]" aria-label="@Text["Common.LogOut"]">
                                    <span class="material-symbols-outlined">logout</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-login">
                            <span class="material-symbols-outlined">login</span>
                            @Text["Common.LogIn"]
                        </a>
                    }
                </div>
            </header>

            <div class="app-canvas">
                @RenderBody()
            </div>
        </main>
    </div>
    <nav class="app-mobile-nav" aria-label="@Text["Layout.PrimaryNavigation"]">
        <a class="@NavClass("Languages")" asp-controller="Languages" asp-action="Index">
            @NavIcon("language")
            <span>@Text["Nav.Language"]</span>
        </a>
        <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
            @NavIcon("home")
            <span>@Text["Nav.Home"]</span>
        </a>
        <a class="@QuizzesNavClass()" asp-controller="Quiz" asp-action="Index">
            @NavIcon("quiz")
            <span>@Text["Nav.Quizzes"]</span>
        </a>
        <a class="@NavClass("Anki")" asp-controller="Anki" asp-action="Index">
            @NavIcon("anki")
            <span>Anki</span>
        </a>
        @if (speakingIsAvailable)
        {
            <a class="@NavClass("Speaking")" asp-controller="Speaking" asp-action="Index">
                @NavIcon("mic")
                <span>@Text["Nav.Speak"]</span>
            </a>
        }
        else
        {
            <span class="app-nav-item is-disabled" aria-disabled="true" data-speaking-unavailable
                  title="@Text["Speaking.Unavailable"]">
                @NavIcon("mic")
                <span>@Text["Nav.Speak"]</span>
            </span>
        }
        <a class="@NavClass("Books")" asp-controller="Books" asp-action="Index">
            @NavIcon("auto_stories")
            <span>@Text["Nav.Books"]</span>
        </a>
        <a class="@NavClass("Transcripts")" asp-controller="Transcripts" asp-action="Index">
            @NavIcon("subtitles")
            <span>@Text["Nav.Transcripts"]</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="@NavClass("Explore")" asp-controller="Explore" asp-action="Index">
                @NavIcon("explore")
                <span>@Text["Nav.Explore"]</span>
            </a>
            <a class="@NavClass("Classroom")" asp-controller="Classroom" asp-action="Index">
                @NavIcon("school")
                <span>@Text["Nav.Class"]</span>
            </a>
        }
        else
        {
            <a class="@NavClass("Account", "Login")" asp-controller="Account" asp-action="Login">
                <span class="material-symbols-outlined">login</span>
                <span>@Text["Common.LogIn"]</span>
            </a>
        }
    </nav>
    @if (User.Identity?.IsAuthenticated == true && ViewData["HideAssistantPanel"] is not true)
    {
        @await Component.InvokeAsync("AssistantPanel", new
        {
            panel = new AssistantPanelViewModel
            {
                QuizId = AssistantGuid("AssistantQuizId"),
                FocusedWordId = ViewData["AssistantFocusedWordId"] as string,
                DocumentId = AssistantGuid("AssistantDocumentId"),
                CurrentPage = AssistantInt("AssistantCurrentPage"),
                CustomQuizId = AssistantGuid("AssistantCustomQuizId"),
                TranscriptId = AssistantGuid("AssistantTranscriptId"),
                TranscriptPage = AssistantInt("AssistantTranscriptPage"),
                TranscriptStream = ViewData["AssistantTranscriptStream"] as string,
                Title = AssistantText("AssistantTitle", Text["Assistant.Title"]),
                ContextLabel = AssistantText("AssistantContextLabel", "Glosify"),
                EmptyText = AssistantText("AssistantEmptyText", Text["Assistant.Empty"]),
                Placeholder = AssistantText("AssistantPlaceholder", Text["Assistant.Placeholder"])
            }
        })
        <script type="module" src="~/js/assistant.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tts.js" asp-append-version="true"></script>
    <script src="~/js/local-time.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
