@model Glosify.Models.ViewModels.AssistantPanelContentViewModel
@{
    var panel = Model.Panel;
    var panelKey = panel.QuizId?.ToString("N") ?? "global";
    var imageInputId = $"assistantImageInput-{panelKey}";
    var popoverId = $"assistantPopover-{panelKey}";
}

<div class="assistant-float"
     data-assistant-panel
     data-quiz-id="@panel.QuizId"
     data-context-label="@(string.IsNullOrWhiteSpace(panel.ContextLabel) ? "Glosify" : panel.ContextLabel)"
     data-focused-word-id="@panel.FocusedWordId"
     data-document-id="@panel.DocumentId"
     data-current-page="@panel.CurrentPage"
     data-transcript-id="@panel.TranscriptId"
     data-transcript-page="@panel.TranscriptPage"
     data-transcript-stream="@panel.TranscriptStream"
     data-custom-quiz-id="@panel.CustomQuizId"
     data-context-options-url="@Model.ContextOptionsUrl">
    @Html.AntiForgeryToken()
    @* The accessible name has to contain the button's visible text (WCAG 2.5.3),
       so it is built from the same title rather than a fixed "Open assistant". *@
    <button class="assistant-fab"
            type="button"
            aria-label="@Text["Assistant.Title"]: @panel.Title"
            aria-controls="@popoverId"
            aria-expanded="false"
            data-assistant-toggle>
        <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
        <span class="assistant-fab-label">@panel.Title</span>
    </button>

    <section class="assistant-popover assistant-panel" id="@popoverId" hidden data-assistant-window>
        <header class="assistant-ide-header">
            <div class="assistant-tabs" aria-label="@Text["Assistant.Workspace"]">
                <button class="assistant-tab is-active" type="button" data-assistant-tab="chat">@Text["Assistant.Chat"]</button>
                <button class="assistant-tab" type="button" data-assistant-tab="chats">@Text["Assistant.Chats"]</button>
            </div>
            <div class="assistant-header-actions">
                <button class="assistant-reset" type="button" aria-label="@Text["Assistant.NewChat"]" title="@Text["Assistant.NewChat"]" data-assistant-reset>
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                </button>
                <button class="assistant-close" type="button" aria-label="@Text["Assistant.Close"]" data-assistant-close>
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>
        </header>

        <div class="assistant-pane is-active" data-assistant-pane="chat">
            <div class="assistant-transcript" data-assistant-transcript>
                <div class="assistant-empty" data-assistant-empty>
                    <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                    <strong>@panel.Title</strong>
                    <span>@panel.EmptyText</span>
                </div>
            </div>

            <div class="assistant-status" data-assistant-status hidden></div>

            <form class="assistant-input" data-assistant-form>
                <div class="assistant-context-bar">
                    <label class="assistant-context-picker">
                        <span class="visually-hidden">@Text["Assistant.QuizContext"]</span>
                        <select aria-label="@Text["Assistant.QuizContext"]"
                                aria-busy="true"
                                disabled
                                data-assistant-quiz-selector>
                            <option value="" data-context-label="Glosify">@Text["Assistant.NoQuiz"]</option>
                        </select>
                    </label>
                    <label class="assistant-context-picker">
                        <span class="visually-hidden">@Text["Assistant.ReadingMaterial"]</span>
                        <select aria-label="@Text["Assistant.ReadingMaterial"]"
                                aria-busy="true"
                                disabled
                                data-books-label="@Text["Nav.Books"]"
                                data-transcripts-label="@Text["Nav.Transcripts"]"
                                data-assistant-material-selector>
                            <option value="" data-context-label="">@Text["Assistant.NoMaterial"]</option>
                        </select>
                    </label>
                </div>
                <div class="assistant-composer">
                    <textarea
                        class="form-textarea"
                        data-assistant-textarea
                        dir="auto"
                        placeholder="@panel.Placeholder"
                        rows="3"
                        required></textarea>
                    <div class="assistant-composer-toolbar">
                        <div class="assistant-composer-tools">
                            @if (panel.QuizId.HasValue)
                            {
                                <label class="assistant-icon-tool" for="@imageInputId" aria-label="@Text["Assistant.Picture"]" title="@Text["Assistant.Picture"]">
                                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                                </label>
                                <input
                                    id="@imageInputId"
                                    class="visually-hidden"
                                    type="file"
                                    accept="image/*"
                                    capture="environment"
                                    data-assistant-image-input
                                    data-extract-url="@Url.Action("ExtractTextFromImage", "Quiz", new { quizId = panel.QuizId })" />
                                <span class="scan-status" data-assistant-scan-status hidden></span>
                            }
                        </div>
                        <button class="assistant-send" type="submit" aria-label="@Text["Assistant.Send"]" data-assistant-submit>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="assistant-pane" data-assistant-pane="chats" hidden>
            <div class="assistant-chat-list-toolbar">
                <span>@Text["Assistant.PreviousChats"]</span>
                <button class="assistant-list-action" type="button" aria-label="@Text["Assistant.NewChat"]" title="@Text["Assistant.NewChat"]" data-assistant-new-chat>
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                </button>
            </div>
            <div class="assistant-chat-list" data-assistant-chat-list>
                <div class="assistant-chat-list-empty">@Text["Assistant.NoChats"]</div>
            </div>
        </div>
    </section>
</div>
