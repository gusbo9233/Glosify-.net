@model Glosify.Models.ViewModels.StudyCardViewModel
@{
    var label = Model.Label ?? $"{Model.PromptLanguage} → {Model.AnswerLanguage}";
    var labelClass = Model.Label is null ? "card-label card-label-language" : "card-label";
    var pronouncePrompt = Model.Pronunciation && Model.PromptIsTarget;
    var pronounceAnswer = Model.Pronunciation && !Model.PromptIsTarget;
}
<p class="page-message flashcard-request-status" data-flashcard-status role="status" aria-live="polite" hidden></p>
@if (Model.Revealed)
{
    <article class="flashcard is-revealed" aria-live="polite">
        <span class="@labelClass">@label</span>
        <h2 class="card-word card-text-row">
            <span class="card-text" dir="auto">@Model.Prompt</span>
            @if (pronouncePrompt)
            {
                <button class="btn-icon-tts" aria-pressed="false" type="button" data-tts="@Model.Prompt" data-tts-lang="@Model.PromptLanguage" aria-label="@Text["Quiz.PlayPronunciation", Model.Prompt]"><span class="material-symbols-outlined" aria-hidden="true">volume_up</span></button>
            }
        </h2>
        <div class="card-answer revealed" hidden="@(ViewData["GuestSample"] is string)">
            <div class="translation card-text-row">
                <span class="card-text" dir="auto">@Model.Answer</span>
                @if (pronounceAnswer)
                {
                    <button class="btn-icon-tts" aria-pressed="false" type="button" data-tts="@Model.Answer" data-tts-lang="@Model.AnswerLanguage" aria-label="@Text["Quiz.PlayPronunciation", Model.Answer]"><span class="material-symbols-outlined" aria-hidden="true">volume_up</span></button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Example)) { <div class="example" dir="auto">@Model.Example</div> }
            @if (!string.IsNullOrWhiteSpace(Model.ExampleTranslation)) { <div class="example" dir="auto">@Model.ExampleTranslation</div> }
        </div>
    </article>
    @await Html.PartialAsync("_StudyRatingControls", Model)
}
else
{
    <form class="card-reveal-form" method="post" action="@Model.RevealUrl" data-flashcard-form data-card-reveal-form>
        @Html.AntiForgeryToken()
        @foreach (var field in Model.Fields) { <input type="hidden" name="@field.Key" value="@field.Value" /> }
        <div class="flashcard flashcard-clickable">
            <button class="card-reveal-button" type="submit" aria-label="@Text["Quiz.RevealAnswer", Model.Prompt]"></button>
            <span class="@labelClass">@label</span>
            <span class="card-word card-text-row">
                <span class="card-text" dir="auto">@Model.Prompt</span>
                @if (pronouncePrompt)
                {
                    <button class="btn-icon-tts" aria-pressed="false" type="button" data-tts="@Model.Prompt" data-tts-lang="@Model.PromptLanguage" aria-label="@Text["Quiz.PlayPronunciation", Model.Prompt]"><span class="material-symbols-outlined" aria-hidden="true">volume_up</span></button>
                }
            </span>
            <span class="swipe-hint">@Text["Quiz.ShowAnswer"]</span>
        </div>
    </form>
}
