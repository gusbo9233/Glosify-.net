<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Glosify</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "Sign in to Glosify to build vocabulary from what you read, practice it with quizzes, and speak it with an AI conversation partner.")" />
    @* One stylesheet request for every family the app uses; css2 requires the
       families in alphabetical order. The font files come from a second origin,
       so both are preconnected before the stylesheet is even parsed. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,400..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="auth-body">
    <div class="auth-halos" aria-hidden="true">
        <div class="auth-halo auth-halo-tl"></div>
        <div class="auth-halo auth-halo-br"></div>
    </div>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
