<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Glosify</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "Sign in to Glosify to build vocabulary from what you read, practice it with quizzes, and speak it with an AI conversation partner.")" />
    @* The font files come from a second origin, so both are preconnected before
       the stylesheets are even parsed. Text and icons are separate requests
       because they need different font-display behavior — see WebFonts. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@WebFonts.TextStylesheetUrl" rel="stylesheet" />
    <link href="@WebFonts.IconStylesheetUrl" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="auth-body">
    <div class="auth-halos" aria-hidden="true">
        <div class="auth-halo auth-halo-tl"></div>
        <div class="auth-halo auth-halo-br"></div>
    </div>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
