<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" data-display-culture="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Glosify</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? Text["Layout.AuthMetaDescription"])" />
    @await Html.PartialAsync("_LocalizedPublicSeo")
    @* The font files come from a second origin, so both are preconnected before
       the stylesheets are even parsed. Text and icons are separate requests
       because they need different font-display behavior — see WebFonts. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@WebFonts.TextStylesheetUrl" rel="stylesheet" />
    <link href="@WebFonts.IconStylesheetUrl" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="auth-body" data-i18n="@System.Text.Json.JsonSerializer.Serialize(UiClientText.Create(Text))">
    <div class="auth-halos" aria-hidden="true">
        <div class="auth-halo auth-halo-tl"></div>
        <div class="auth-halo auth-halo-br"></div>
    </div>

    @RenderBody()

    <div class="auth-display-language">
        @await Html.PartialAsync("_DisplayLanguageSelector")
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
