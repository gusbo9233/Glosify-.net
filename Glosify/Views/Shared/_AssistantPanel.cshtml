@model Glosify.Models.ViewModels.AssistantPanelViewModel
@inject Glosify.Services.Ai.Generation.IGenerativeAiModelResolver GenerativeAiModels
@inject Glosify.Services.Quizzes.IQuizService QuizService
@inject Glosify.Services.Books.IBookDocumentService BookService
@inject Glosify.Services.RealtimeTranslation.IRealtimeTranslationTranscriptService TranscriptService
@inject Glosify.Services.Language.IQuizLanguagePreferenceService LanguagePreferences
@{
    var panelKey = Model.QuizId?.ToString("N") ?? "global";
    var imageInputId = $"assistantImageInput-{panelKey}";
    var popoverId = $"assistantPopover-{panelKey}";
    var assistantModels = GenerativeAiModels.AssistantModels
        .Where(model => !string.Equals(
            model.Deployment,
            GenerativeAiModels.DefaultAssistantModel,
            StringComparison.OrdinalIgnoreCase))
        .ToArray();
    IReadOnlyList<Quiz> contextQuizzes = [];
    IReadOnlyList<Glosify.Models.Library.BookDocument> contextBooks = [];
    IReadOnlyList<Glosify.Services.RealtimeTranslation.TranscriptLibraryItem> contextTranscripts = [];
    if (User.Identity?.IsAuthenticated == true)
    {
        var contextUserId = User.GetUserId();
        contextQuizzes = await QuizService.GetUserQuizzesAsync(contextUserId);
        contextBooks = await BookService.GetUserBooksAsync(contextUserId);
        // Transcripts are keyed by language code while books use the display name, so the
        // two lists are fetched separately rather than through one shared filter.
        var selectedLanguage = await LanguagePreferences.GetSelectedAsync(contextUserId);
        if (selectedLanguage is not null)
        {
            var transcriptLibrary = await TranscriptService.GetLibraryAsync(
                contextUserId,
                selectedLanguage.Code,
                page: 1,
                pageSize: 50);
            contextTranscripts = transcriptLibrary.Items;
        }
    }

    // The material picker carries two kinds in one control, so the option value encodes
    // which one it is. Matches the parsing in wwwroot/js/assistant.js.
    var selectedMaterial = Model.TranscriptId.HasValue
        ? $"transcript:{Model.TranscriptId}"
        : Model.DocumentId.HasValue ? $"book:{Model.DocumentId}" : string.Empty;
}

<div class="assistant-float"
     data-assistant-panel
     data-quiz-id="@Model.QuizId"
     data-context-label="@(string.IsNullOrWhiteSpace(Model.ContextLabel) ? "Glosify" : Model.ContextLabel)"
     data-focused-word-id="@Model.FocusedWordId"
     data-document-id="@Model.DocumentId"
     data-current-page="@Model.CurrentPage"
     data-transcript-id="@Model.TranscriptId"
     data-custom-quiz-id="@Model.CustomQuizId">
    @Html.AntiForgeryToken()
    @* The accessible name has to contain the button's visible text (WCAG 2.5.3),
       so it is built from the same title rather than a fixed "Open assistant". *@
    <button class="assistant-fab"
            type="button"
            aria-label="Open @Model.Title"
            aria-controls="@popoverId"
            aria-expanded="false"
            data-assistant-toggle>
        <span class="material-symbols-outlined" aria-hidden="true">chat_bubble</span>
        <span class="assistant-fab-label">@Model.Title</span>
    </button>

    <section class="assistant-popover assistant-panel" id="@popoverId" hidden data-assistant-window>
        <header class="assistant-ide-header">
            <div class="assistant-tabs" aria-label="Assistant workspace">
                <button class="assistant-tab is-active" type="button" data-assistant-tab="chat">CHAT</button>
                <button class="assistant-tab" type="button" data-assistant-tab="chats">CHATS</button>
            </div>
            <div class="assistant-header-actions">
                <button class="assistant-reset" type="button" aria-label="New chat" title="New chat" data-assistant-reset>
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                </button>
                <button class="assistant-close" type="button" aria-label="Close assistant" data-assistant-close>
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>
        </header>

        <div class="assistant-pane is-active" data-assistant-pane="chat">
            <div class="assistant-transcript" data-assistant-transcript>
                <div class="assistant-empty" data-assistant-empty>
                    <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                    <strong>@Model.Title</strong>
                    <span>@Model.EmptyText</span>
                </div>
            </div>

            <div class="assistant-status" data-assistant-status hidden></div>

            <form class="assistant-input" data-assistant-form>
                <div class="assistant-context-bar">
                    <label class="assistant-context-picker">
                        <span class="visually-hidden">Quiz context</span>
                        <select aria-label="Quiz context" data-assistant-quiz-selector>
                            <option value="" data-context-label="Glosify">No quiz selected</option>
                            @foreach (var quiz in contextQuizzes)
                            {
                                <option value="@quiz.Id"
                                        data-context-label="@quiz.Name"
                                        selected="@(Model.QuizId == quiz.Id)">
                                    @quiz.Name (@quiz.SourceLanguage &rarr; @quiz.TargetLanguage)
                                </option>
                            }
                        </select>
                    </label>
                    <label class="assistant-context-picker">
                        <span class="visually-hidden">Reading material</span>
                        <select aria-label="Reading material" data-assistant-material-selector>
                            <option value="" data-context-label="">No material selected</option>
                            @if (contextBooks.Count > 0)
                            {
                                <optgroup label="Books">
                                    @foreach (var book in contextBooks)
                                    {
                                        <option value="book:@book.Id"
                                                data-context-label="@book.Title"
                                                selected="@(selectedMaterial == $"book:{book.Id}")">
                                            @book.Title
                                        </option>
                                    }
                                </optgroup>
                            }
                            @if (contextTranscripts.Count > 0)
                            {
                                <optgroup label="Transcripts">
                                    @foreach (var savedTranscript in contextTranscripts)
                                    {
                                        <option value="transcript:@savedTranscript.Id"
                                                data-context-label="@savedTranscript.Title"
                                                selected="@(selectedMaterial == $"transcript:{savedTranscript.Id}")">
                                            @savedTranscript.Title
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                </div>
                <div class="assistant-composer">
                    <textarea
                        class="form-textarea"
                        data-assistant-textarea
                        placeholder="@Model.Placeholder"
                        rows="3"
                        required></textarea>
                    <div class="assistant-composer-toolbar">
                        <div class="assistant-composer-tools">
                            @if (Model.QuizId.HasValue)
                            {
                                <label class="assistant-icon-tool" for="@imageInputId" aria-label="Picture" title="Picture">
                                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                                </label>
                                <input
                                    id="@imageInputId"
                                    class="visually-hidden"
                                    type="file"
                                    accept="image/*"
                                    capture="environment"
                                    data-assistant-image-input
                                    data-extract-url="@Url.Action("ExtractTextFromImage", "Quiz", new { quizId = Model.QuizId })" />
                                <span class="scan-status" data-assistant-scan-status hidden></span>
                            }
                            <label class="assistant-model-picker">
                                <span class="visually-hidden">Assistant model</span>
                                <select data-assistant-model-select aria-label="Assistant model">
                                    <option value="">Auto</option>
                                    @foreach (var assistantModel in assistantModels)
                                    {
                                        var creditMultiplier = assistantModel.CreditMultiplier.ToString(
                                            "0.##",
                                            System.Globalization.CultureInfo.InvariantCulture);
                                        <option value="@assistantModel.Deployment">
                                            @assistantModel.DisplayName · @assistantModel.Provider · @assistantModel.SpeedTier · @assistantModel.CostTier · @creditMultiplier×
                                        </option>
                                    }
                                </select>
                            </label>
                        </div>
                        <button class="assistant-send" type="submit" aria-label="Send" data-assistant-submit>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="assistant-pane" data-assistant-pane="chats" hidden>
            <div class="assistant-chat-list-toolbar">
                <span>Previous chats</span>
                <button class="assistant-list-action" type="button" aria-label="New chat" title="New chat" data-assistant-new-chat>
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                </button>
            </div>
            <div class="assistant-chat-list" data-assistant-chat-list>
                <div class="assistant-chat-list-empty">No saved chats yet.</div>
            </div>
        </div>
    </section>
</div>
