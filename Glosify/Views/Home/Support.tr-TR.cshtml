@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Destek";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Glosify Destek</h1><p>Beta web uygulaması ve Chrome uzantısı için yardım.</p></header>
        <p><a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a> adresine e-posta gönderin. Yaklaşık zamanı, tarayıcı sürümünü ve görünen hata mesajını ekleyin. Parola, erişim belirteci, sekme sesi veya hassas transkript metni göndermeyin.</p>
        <p>Gizlilik, transkript silme veya hesap silme soruları için aynı adresi kullanın ve isteğinizi açıkça belirtin. Oturum açmış kullanıcılar, varsa önce yerleşik silme kontrollerini kullanmalıdır.</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
