@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "サポート";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Glosify サポート</h1><p>ベータ版のWebアプリとChrome拡張機能に関するサポートです。</p></header>
        <p>メールで <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a> までご連絡ください。おおよその時刻、ブラウザのバージョン、表示されたエラーメッセージを含めてください。パスワード、アクセストークン、タブの音声、機密性の高い文字起こしテキストは送信しないでください。</p>
        <p>プライバシー、文字起こしの削除、またはアカウント削除に関するお問い合わせは、同じ宛先に送り、依頼内容を明確に記載してください。サインイン済みのユーザーは、利用可能な場合はまずアプリ内の削除操作をご利用ください。</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
