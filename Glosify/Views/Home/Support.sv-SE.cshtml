@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Support";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Glosify-support</h1><p>Hjälp med webbappen i betaversion och Chrome-tillägget.</p></header>
        <p>Skicka e-post till <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. Ange ungefärlig tidpunkt, webbläsarversion och felmeddelandet som visades. Skicka inte lösenord, åtkomsttoken, flikljud eller känslig transkriptionstext.</p>
        <p>Använd samma adress för frågor om integritet, radering av transkriptioner eller radering av konto och beskriv tydligt vad du begär. Inloggade användare bör först använda de inbyggda raderingskontrollerna när de finns.</p>
        <nav class="legal-links" aria-label="Juridiska sidor"><a asp-action="Privacy">Integritetspolicy</a><a asp-action="Terms">Användarvillkor</a></nav>
    </article>
</main>
