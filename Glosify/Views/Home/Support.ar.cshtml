@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "الدعم";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>دعم Glosify</h1><p>المساعدة في تطبيق الويب التجريبي وملحق Chrome.</p></header>
        <p>راسل <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. أدرج الوقت التقريبي، وإصدار المتصفح، ورسالة الخطأ الظاهرة. لا ترسل كلمات المرور، أو رموز الوصول، أو صوت علامات التبويب، أو نصوص النسخ التفريغي الحساسة.</p>
        <p>لأسئلة الخصوصية، أو حذف النسخ التفريغية، أو حذف الحساب، استخدم العنوان نفسه واذكر الطلب بوضوح. ينبغي على المستخدمين المسجلين الدخول استخدام عناصر الحذف المدمجة أولًا عندما تكون متاحة.</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
