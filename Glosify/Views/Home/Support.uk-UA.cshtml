@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Підтримка";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Підтримка Glosify</h1><p>Допомога з бета-версією вебзастосунку та розширенням Chrome.</p></header>
        <p>Напишіть на <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. Вкажіть приблизний час, версію браузера та повідомлення про помилку, яке відображалося. Не надсилайте паролі, токени доступу, аудіо з вкладок або чутливий текст транскрипту.</p>
        <p>Щодо конфіденційності, видалення транскриптів або видалення облікового запису звертайтеся на ту саму адресу й чітко вказуйте запит. Якщо користувач увійшов у систему, за наявності спочатку слід скористатися вбудованими засобами видалення.</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
