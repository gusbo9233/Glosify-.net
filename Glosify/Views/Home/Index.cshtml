@inject Glosify.Services.Language.ILanguageContext LangContext
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Home.Title"];

    var currentLanguage = LangContext.CurrentLanguage;
    var hasLanguage = !string.IsNullOrWhiteSpace(currentLanguage);
    var selectedLanguage = Glosify.Services.Language.QuizLanguageCatalog.Find(currentLanguage);
    var globeRegion = selectedLanguage?.FlagRegion;
    var languageQuote = HomeLanguageQuoteCatalog.Find(selectedLanguage?.Code);
    var isFreestyle = Glosify.Services.Language.QuizLanguageCatalog.IsFreestyle(currentLanguage);
    ViewData.SetAssistantPageContext(new AssistantPageContext
    {
        Title = isFreestyle ? "Study assistant" : Text["Home.Coach"],
        ContextLabel = isFreestyle ? "Freestyle" : Text["Home.Title"]
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            @if (languageQuote is not null)
            {
                <figure class="home-language-quote" aria-labelledby="home-title">
                    <blockquote>
                        <p id="home-title" lang="@selectedLanguage!.Locale" dir="auto">“@languageQuote.Original”</p>
                        <strong lang="en" dir="ltr">“@languageQuote.English”</strong>
                    </blockquote>
                    <figcaption>
                        <span class="home-language-flag" aria-label="@selectedLanguage.Name flag">@selectedLanguage.Flag</span>
                        <cite>@languageQuote.Attribution</cite>
                    </figcaption>
                </figure>
            }
            else
            {
                <h1 id="home-title">
                    @if (isFreestyle)
                    {
                        @:Study anything with Freestyle
                    }
                    else if (hasLanguage)
                    {
                        @Text["Home.TitleWithLanguage", currentLanguage!]
                    }
                    else
                    {
                        @Text["Home.TitleAnonymous"]
                    }
                </h1>
            }
        </div>

        <figure class="home-hero-visual" data-home-globe data-region="@globeRegion"
                role="img" aria-label="@(hasLanguage && !isFreestyle ? Text["Home.GlobeFocus", currentLanguage!] : Text["Home.GlobeAria"])">
            <svg class="home-globe" viewBox="0 0 440 440" aria-hidden="true" focusable="false">
                <defs>
                    <radialGradient id="globe-ocean" cx="32%" cy="26%" r="78%">
                        <stop offset="0%" stop-color="#203c43" />
                        <stop offset="58%" stop-color="#102b38" />
                        <stop offset="100%" stop-color="#06172b" />
                    </radialGradient>
                    <radialGradient id="globe-shade" cx="35%" cy="30%" r="72%">
                        <stop offset="35%" stop-color="#041329" stop-opacity="0" />
                        <stop offset="100%" stop-color="#041329" stop-opacity="0.12" />
                    </radialGradient>
                    <clipPath id="globe-disc"><circle cx="220" cy="220" r="184" /></clipPath>
                </defs>
                <circle class="home-globe-atmosphere" cx="220" cy="220" r="193" />
                <circle cx="220" cy="220" r="184" fill="url(#globe-ocean)" />
                <g clip-path="url(#globe-disc)">
                    <image data-globe-fallback href="@Url.Content("~/images/globe-neutral.svg")" width="440" height="440" />
                    <path class="home-globe-grid" data-globe-grid />
                    <path class="home-globe-land" data-globe-land />
                    <circle cx="220" cy="220" r="184" fill="url(#globe-shade)" />
                </g>
                <circle class="home-globe-rim" cx="220" cy="220" r="184" />
                <g class="home-globe-marker" data-globe-marker>
                    <circle class="home-globe-pulse" r="17" />
                    <circle class="home-globe-marker-ring" r="11" />
                    <circle class="home-globe-marker-dot" r="5" />
                </g>
            </svg>
            <figcaption class="home-globe-caption">
                <span>@Text["Home.GlobeCaption"]</span>
                <strong>@(hasLanguage ? currentLanguage : "GlobeGlotter")</strong>
            </figcaption>
        </figure>
    </section>

</div>

@section Scripts {
    <script type="module" src="~/js/home-globe.js" asp-append-version="true"></script>
}
