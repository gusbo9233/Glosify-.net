@inject Glosify.Services.Language.ILanguageContext LangContext
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = Text["Home.Title"];

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentLanguage = LangContext.CurrentLanguage;
    var hasLanguage = !string.IsNullOrWhiteSpace(currentLanguage);
    var selectedLanguage = Glosify.Services.Language.QuizLanguageCatalog.Find(currentLanguage);
    var globeRegion = selectedLanguage?.FlagRegion;
    var languageQuote = HomeLanguageQuoteCatalog.Find(selectedLanguage?.Code);
    var isFreestyle = Glosify.Services.Language.QuizLanguageCatalog.IsFreestyle(currentLanguage);
    ViewData.SetAssistantPageContext(new AssistantPageContext
    {
        Title = isFreestyle ? "Study assistant" : Text["Home.Coach"],
        ContextLabel = isFreestyle ? "Freestyle" : Text["Home.Title"]
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            @if (languageQuote is not null)
            {
                <figure class="home-language-quote" aria-labelledby="home-title">
                    <blockquote>
                        <p id="home-title" lang="@selectedLanguage!.Locale" dir="auto">“@languageQuote.Original”</p>
                        <strong lang="en" dir="ltr">“@languageQuote.English”</strong>
                    </blockquote>
                    <figcaption>
                        <span class="home-language-flag" aria-label="@selectedLanguage.Name flag">@selectedLanguage.Flag</span>
                        <cite>@languageQuote.Attribution</cite>
                    </figcaption>
                </figure>
            }
            else
            {
                <h1 id="home-title">
                    @if (isFreestyle)
                    {
                        @:Study anything with Freestyle
                    }
                    else if (hasLanguage)
                    {
                        @Text["Home.TitleWithLanguage", currentLanguage!]
                    }
                    else
                    {
                        @Text["Home.TitleAnonymous"]
                    }
                </h1>
            }
        </div>

        <figure class="home-hero-visual" data-home-globe data-region="@globeRegion"
                role="img" aria-label="@(hasLanguage && !isFreestyle ? Text["Home.GlobeFocus", currentLanguage!] : Text["Home.GlobeAria"])">
            <svg class="home-globe" viewBox="0 0 440 440" aria-hidden="true" focusable="false">
                <defs>
                    <radialGradient id="globe-ocean" cx="32%" cy="26%" r="78%">
                        <stop offset="0%" stop-color="#203c43" />
                        <stop offset="58%" stop-color="#102b38" />
                        <stop offset="100%" stop-color="#06172b" />
                    </radialGradient>
                    <radialGradient id="globe-shade" cx="35%" cy="30%" r="72%">
                        <stop offset="35%" stop-color="#041329" stop-opacity="0" />
                        <stop offset="100%" stop-color="#041329" stop-opacity="0.12" />
                    </radialGradient>
                    <clipPath id="globe-disc"><circle cx="220" cy="220" r="184" /></clipPath>
                </defs>
                <circle class="home-globe-atmosphere" cx="220" cy="220" r="193" />
                <circle cx="220" cy="220" r="184" fill="url(#globe-ocean)" />
                <g clip-path="url(#globe-disc)">
                    <image data-globe-fallback href="@Url.Content("~/images/globe-neutral.svg")" width="440" height="440" />
                    <path class="home-globe-grid" data-globe-grid />
                    <path class="home-globe-land" data-globe-land />
                    <circle cx="220" cy="220" r="184" fill="url(#globe-shade)" />
                </g>
                <circle class="home-globe-rim" cx="220" cy="220" r="184" />
                <g class="home-globe-marker" data-globe-marker>
                    <circle class="home-globe-pulse" r="17" />
                    <circle class="home-globe-marker-ring" r="11" />
                    <circle class="home-globe-marker-dot" r="5" />
                </g>
            </svg>
            <figcaption class="home-globe-caption">
                <span>@Text["Home.GlobeCaption"]</span>
                <strong>@(hasLanguage ? currentLanguage : "GlobeGlotter")</strong>
            </figcaption>
        </figure>
    </section>

    <section class="home-story" aria-labelledby="learning-loop-title">
        <header class="home-story-heading">
            <div>
                <p class="home-kicker">@Text["Home.ConnectedKicker"]</p>
                <h2 id="learning-loop-title">@Text["Home.LearningLoop"]</h2>
            </div>
            <p>@(isFreestyle
                ? Text["Home.FreestyleDescription"]
                : Text["Home.Description"])</p>
        </header>

        <div class="home-story-flow" aria-label="@Text["Home.LoopAria"]">
            <a class="home-story-step" asp-controller="Quiz" asp-action="Index">
                <span class="home-story-index" aria-hidden="true">01</span>
                <span class="home-story-copy">
                    <small>@(isFreestyle ? Text["Home.Start"] : Text["Home.Discover"])</small>
                    <strong>@Text["Home.CreateMaterial"]</strong>
                    <span>@Text["Home.CreateMaterialText"]</span>
                </span>
                <span class="home-story-demo home-story-demo-create" aria-hidden="true">
                    <span class="home-create-option">
                        <span class="home-create-mark" aria-hidden="true">+</span>
                        <b>@Text["Home.WriteIt"]</b>
                    </span>
                    <span class="home-create-option is-featured">
                        <span class="home-create-mark" aria-hidden="true">✦</span>
                        <b>@Text["Home.AskAi"]</b>
                    </span>
                    <span class="home-create-option is-coming-soon">
                        <span class="home-create-mark home-create-mark-image" aria-hidden="true"></span>
                        <b>@Text["Home.UsePicture"]</b>
                        <small>@Text["Home.ComingSoon"]</small>
                    </span>
                </span>
                <span class="home-story-open material-symbols-outlined" aria-hidden="true">north_east</span>
            </a>

            <a class="home-story-step home-action-card-vocabulary" asp-controller="Quiz" asp-action="Index">
                <span class="home-story-index" aria-hidden="true">02</span>
                <span class="home-story-copy">
                    <small>@Text["Home.BuildVocabulary"]</small>
                    <strong>@(isFreestyle ? Text["Home.PracticeSet"] : Text["Home.PracticeRecall"])</strong>
                    <span>@(isFreestyle ? Text["Home.PracticeSetText"] : Text["Home.PracticeRecallText"])</span>
                </span>
                <span class="home-story-demo home-story-demo-quiz" aria-hidden="true">
                    <span class="home-demo-question">@(isFreestyle ? Text["Home.AnswerQuestion"] : Text["Home.WordQuestion"])</span>
                    <span class="home-demo-options"><i></i><i class="is-active"></i><i></i></span>
                    <span class="home-demo-progress"><i></i></span>
                </span>
                <span class="home-story-open material-symbols-outlined" aria-hidden="true">north_east</span>
            </a>

            <a class="home-story-step home-action-card-anki" asp-controller="@(isFreestyle ? "Quiz" : "Anki")" asp-action="Index">
                <span class="home-story-index" aria-hidden="true">03</span>
                <span class="home-story-copy">
                    <small>@Text["Home.Remember"]</small>
                    <strong>@(isFreestyle ? Text["Home.Revisit"] : Text["Home.KeepWords"])</strong>
                    <span>@(isFreestyle ? Text["Home.RevisitText"] : Text["Home.KeepWordsText"])</span>
                </span>
                <span class="home-story-demo home-story-demo-memory" aria-hidden="true">
                    <span class="home-memory-card home-memory-card-back"></span>
                    <span class="home-memory-card">
                        <span class="material-symbols-outlined">psychology</span>
                        <b>@Text["Home.SmallSteps"]</b>
                    </span>
                </span>
                <span class="home-story-open material-symbols-outlined" aria-hidden="true">north_east</span>
            </a>
        </div>

        <footer class="home-story-footer">
            <p>@Text["Home.ConnectedText"]</p>
            <nav aria-label="@Text["Home.ExploreWays"]">
                <a class="home-feature-card home-feature-card-books" asp-controller="Books" asp-action="Index">
                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                    @Text["Home.ReadCollect"]
                </a>
                <a class="home-feature-card home-feature-card-explore" asp-controller="Explore" asp-action="Index">
                    <span class="material-symbols-outlined" aria-hidden="true">travel_explore</span>
                    @Text["Home.ExploreCollections"]
                </a>
                <a class="home-feature-card" asp-controller="Quiz" asp-action="Index">
                    <span class="material-symbols-outlined" aria-hidden="true">quiz</span>
                    @Text["Home.OpenQuizzes"]
                </a>
            </nav>
        </footer>
    </section>

    <section class="home-final-cta" aria-labelledby="home-final-title">
        <span class="home-final-icon material-symbols-outlined" aria-hidden="true">waving_hand</span>
        <div>
            <p class="home-kicker">@Text["Home.YourTurn"]</p>
            <h2 id="home-final-title">
                @if (isFreestyle)
                {
                    @:What will you master today?
                }
                else if (hasLanguage)
                {
                    @Text["Home.TodayLanguage", currentLanguage!]
                }
                else
                {
                    @Text["Home.PickFirstWord"]
                }
            </h2>
        </div>
        @if (hasLanguage && isAuthenticated)
        {
            <a class="home-button home-button-primary" asp-controller="Quiz" asp-action="Index">
                @Text["Home.ContinueLearning"]
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
        }
        else if (isAuthenticated)
        {
            <a class="home-button home-button-primary" asp-controller="Languages" asp-action="Index">
                @Text["Home.PickLanguage"]
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
        }
        else
        {
            <a class="home-button home-button-primary" asp-controller="Account" asp-action="Register">
                @Text["Home.CreateAccount"]
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a>
        }
    </section>
</div>

@section Scripts {
    <script type="module" src="~/js/home-globe.js" asp-append-version="true"></script>
}
