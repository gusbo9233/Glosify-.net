@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Hỗ trợ";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Hỗ trợ Glosify</h1><p>Trợ giúp cho ứng dụng web beta và tiện ích mở rộng Chrome.</p></header>
        <p>Gửi email đến <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. Hãy bao gồm thời gian ước chừng, phiên bản trình duyệt và thông báo lỗi hiển thị. Không gửi mật khẩu, mã truy cập, âm thanh từ tab hoặc văn bản bản ghi nhạy cảm.</p>
        <p>Đối với các câu hỏi về quyền riêng tư, xóa bản chép lời hoặc xóa tài khoản, hãy dùng cùng địa chỉ này và nêu rõ yêu cầu. Người dùng đã đăng nhập nên ưu tiên dùng các tùy chọn xóa có sẵn trong ứng dụng trước khi có thể.</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
