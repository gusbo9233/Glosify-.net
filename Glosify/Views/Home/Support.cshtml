@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Support";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Glosify Support</h1><p>Help with the beta web app and Chrome extension.</p></header>
        <p>Email <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. Include the approximate time, browser version, and the error message shown. Do not send passwords, access tokens, tab audio, or sensitive transcript text.</p>
        <p>For privacy, transcript deletion, or account deletion questions, use the same address and clearly state the request. Signed-in users should use built-in deletion controls first when available.</p>
        <nav class="legal-links" aria-label="Legal pages"><a asp-action="Privacy">Privacy Policy</a><a asp-action="Terms">Terms of Service</a></nav>
    </article>
</main>
