@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "Dukungan";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Dukungan Glosify</h1><p>Bantuan untuk aplikasi web beta dan ekstensi Chrome.</p></header>
        <p>Email <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>. Sertakan perkiraan waktu, versi browser, dan pesan kesalahan yang ditampilkan. Jangan kirim kata sandi, token akses, audio tab, atau teks transkrip sensitif.</p>
        <p>Untuk pertanyaan tentang privasi, penghapusan transkrip, atau penghapusan akun, gunakan alamat yang sama dan jelaskan permintaannya dengan jelas. Pengguna yang sudah masuk harus terlebih dahulu menggunakan kontrol penghapusan bawaan jika tersedia.</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
