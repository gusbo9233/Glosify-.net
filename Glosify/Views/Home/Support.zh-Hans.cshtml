@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "支持";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>Glosify 支持</h1><p>获取 beta 网页应用和 Chrome 扩展的帮助。</p></header>
        <p>请发送邮件至 <a href="mailto:@legal.ContactEmail?subject=Glosify%20support">@legal.ContactEmail</a>。请包含大致时间、浏览器版本和显示的错误信息。请勿发送密码、访问令牌、标签页音频或敏感的转写文本。</p>
        <p>如涉及隐私、转写删除或账号删除，请使用同一地址并明确说明请求。已登录用户在可用时应先使用内置删除控件。</p>
        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
        </nav>
    </article>
</main>
