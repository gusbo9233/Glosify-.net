@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "سياسة الخصوصية";
    ViewData["Description"] = "كيف تتعامل Glosify وإضافة Chrome Glosify Live Subtitles مع البيانات الشخصية.";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header">
            <h1>سياسة الخصوصية</h1>
            <p>آخر تحديث 14 أغسطس 2026</p>
        </header>
        <aside class="legal-language-notice">
            تُوفَّر هذه الترجمة للتيسير. إذا اختلفت عن النسخة الإنجليزية، فإن النسخة الإنجليزية هي السارية.
            <a asp-action="PrivacyEnglish">اقرأ النسخة الإنجليزية السارية</a>.
        </aside>


        <h2>من يتحكم في بياناتك</h2>
        <p><strong>@legal.ControllerName</strong> يدير Glosify وهو المتحكم في البيانات الشخصية الموضحة هنا. تواصل مع <a href="mailto:@legal.ContactEmail">@legal.ContactEmail</a> لطلبات الخصوصية أو الحذف.</p>

        <h2>البيانات التي يعالجها Glosify</h2>
        <ul>
            <li>معلومات الحساب مثل عنوان البريد الإلكتروني، ومعرّف الحساب الداخلي، وطريقة المصادقة، ومعرّفات تسجيل الدخول الخارجية من Google أو Microsoft.</li>
            <li>تفضيلات اللغة، والاختبارات، ومحتوى التعلم، والاعتمادات، والحجوزات، ومعاملات الاستخدام، وبيانات تعريف الجلسة اللازمة لتقديم الخدمة وحمايتها.</li>
            <li>رسائل دردشة المساعد، وسياق التعلم المحدد، والردود المُولَّدة بالذكاء الاصطناعي، وإجراءات الأدوات، والتغييرات المقترحة اللازمة لتقديم المحادثات المحفوظة. تُعالَج طلبات المساعد بواسطة Microsoft Foundry.</li>
            <li>في الترجمة الفورية بالترجمة الفرعية المباشرة، يُلتقط الصوت من علامة التبويب التي تختارها صراحةً، والترجمات المترجمة، واللغة المستهدفة، والتوقيت، وبيانات تشخيص الاتصال.</li>
            <li>إذا فعّلتَ بشكل منفصل حفظ النصوص، فسيُحفظ الكلام الأصلي النهائي باللغة الأصلية، وعناوين النصوص، والطوابع الزمنية، واللغة التعليمية المختارة.</li>
            <li>بيانات التعريف الأمنية والتشغيلية مثل عنوان IP، ووقت الطلب، والحالة، وبيانات تشخيص الأخطاء. صُمِّمت سجلات التطبيق بحيث لا تتضمن صوت علامة التبويب أو نص الترجمة الفرعية.</li>
        </ul>
        <p>تسجّل تحليلات تشغيل المساعد أسماء النماذج والأدوات، وعدد الرموز، والأوقات، والنتائج، ومعرّفات الارتباط المستعارة. وهي مهيأة بحيث لا تكرر المطالبات الكاملة أو الردود أو معطيات الأدوات أو نتائج الأدوات في التخزين التحليلي أو القياس عن بُعد.</p>

        <h2>الترجمة الفرعية المباشرة ومعالجة المزوّدين</h2>
        <p>يُسجِّل Chrome الصوت فقط بعد أن تضغط <strong>بدء الترجمة النصية</strong> لعلامة التبويب النشطة. في الوضع المحسّن، يُبَث الصوت عبر Glosify إلى Microsoft Foundry لمعالجة الكلام والترجمة في الوقت الحقيقي. وإذا كان حفظ النصوص مفعّلًا، فيُبَث الصوت نفسه أيضًا إلى ElevenLabs Scribe v2 لإنتاج النص الأصلي النهائي. في وضع الترجمة الفرعية الخاص بـ ElevenLabs Scribe v2، يُبَث الصوت عبر Glosify إلى ElevenLabs للنسخ، ثم تُرسَل كل عبارة نهائية إلى Azure Translator. لا يُكتب صوت علامة التبويب إلى تخزين Glosify.
        </p>
        <p>تُعرَض الترجمة الفرعية والعبارات المتعرَّف عليها بشكل مؤقت ما لم تُفعّل حفظ النصوص بشكل منفصل. تعالج Microsoft الصوت والعبارات المتعرَّف عليها وبيانات الخدمة ذات الصلة للترجمة الفرعية المحسّنة. وتعالج ElevenLabs هذه البيانات عندما يكون وضع Scribe نشطًا أو عندما يكون حفظ النصوص المحسّن مفعّلًا. تم تمكين تسجيل واجهة برمجة التطبيقات القياسي لدى ElevenLabs، لذا قد تحتفظ ElevenLabs ببيانات الطلب وسجلات الخدمة بموجب شروط الخدمة وسياسة الاحتفاظ المنطبقة لديها. وتعالج Google وMicrosoft المعلومات وفق سياساتهما الخاصة عندما تختار خدمات تسجيل الدخول OAuth الخاصة بهما.</p>

        <h2>الأغراض والأساس القانوني</h2>
        <p>تستخدم Glosify هذه البيانات لمصادقتك، وتقديم ميزات التعلم والترجمة الفرعية التي طلبتها، وصيانة محتواك، وإدارة الاعتمادات وميزانية التطبيق، ومنع إساءة الاستخدام، واستكشاف الأعطال وإصلاحها، والامتثال للالتزامات القانونية. تكون المعالجة ضرورية لتقديم الخدمة التي تطلبها وللمصالح المشروعة المتعلقة بالأمن والموثوقية؛ أما تخزين النصوص الاختياري فيستند إلى اختيارك الصريح.</p>

        <h2>التخزين والاحتفاظ والحذف</h2>
        <p>يكون حفظ النصوص متوقفًا افتراضيًا. وعند تفعيله، يُخزَّن الكلام الأصلي النهائي في حساب Glosify الخاص بك إلى أن تحذف النص أو الحساب. يُحتفَظ بمحتوى الحساب وسجلات الاعتمادات ما دام الحساب نشطًا ولفترة لازمة بشكل معقول للأمن أو المحاسبة أو تسوية النزاعات أو الالتزامات القانونية. تنتهي صلاحية نسخ النسخ الاحتياطي السحابي وسجلات التشغيل وفق جداول الاحتفاظ المهيأة في Microsoft Azure بدلًا من اختفائها فورًا.</p>
        <p>يمكنك حذف النصوص المحفوظة من صفحة Transcripts واستخدام أدوات حذف إدارة الحساب بعد تسجيل الدخول. ويمكنك أيضًا التواصل عبر العنوان أعلاه. حذف المحتوى لا يلغي النسخة الخاصة بمزوّد OAuth؛ لذا أدر تلك العلاقة مع Google أو Microsoft أيضًا.</p>

        <h2>بيانات إضافة Chrome</h2>
        <p>تخزن الإضافة الحد الأدنى من الإعدادات المحلية ومواد المصادقة اللازمة للبقاء متصلة، مثل اختيارات اللغة، وحالة الجلسة، ورموز Glosify bearer. وتستخدم active-tab وtab-capture وoffscreen وscripting وstorage وidentity وglosify.se للوصول فقط لربط الحساب ووضع الترجمة الفرعية المترجمة فوق علامة التبويب التي يبدأها المستخدم.</p>

        <h2>الاستخدام المحدود في Chrome Web Store</h2>
        <p>سيتوافق استخدام Glosify ونقل المعلومات المستلمة من Google APIs مع سياسة بيانات مستخدم Chrome Web Store، بما في ذلك متطلبات الاستخدام المحدود. لا تبيع Glosify بيانات مستخدمي الإضافة، ولا تستخدمها للإعلانات المخصصة، ولا تنقلها لأغراض غير ذات صلة بالائتمان أو الإقراض.</p>

        <h2>التغييرات والأسئلة</h2>
        <p>سيتم نشر التغييرات الجوهرية في هذه الصفحة مع تاريخ سريان جديد. وللأسئلة أو طلبات الوصول أو التصحيح أو قابلية النقل أو الاعتراض أو الحذف، تواصل مع <a href="mailto:@legal.ContactEmail">@legal.ContactEmail</a>.</p>

        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Terms">@Text["Legal.TermsOfService"]</a>
            <a asp-action="Support">@Text["Legal.Support"]</a>
        </nav>
    </article>
</main>
