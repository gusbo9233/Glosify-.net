@using Microsoft.Extensions.Options
@using Glosify.Services.Legal
@inject IOptions<LegalOptions> Legal
@{
    Layout = "~/Views/Shared/_GlosifyLayout.cshtml";
    ViewData["Title"] = "شروط الخدمة";
    var legal = Legal.Value;
}

<main class="auth-shell legal-shell">
    <article class="glass-card legal-document">
        <header class="auth-card-header"><h1>شروط الخدمة</h1><p>تسري اعتبارًا من 10 أغسطس 2026</p></header>
        <aside class="legal-language-notice">
            تُقدَّم هذه الترجمة للتيسير. إذا اختلفت عن النسخة الإنجليزية، فالنسخة الإنجليزية هي الواجبة التطبيق.
            <a asp-action="TermsEnglish">اقرأ النسخة الإنجليزية الواجبة التطبيق</a>.
        </aside>

        <p>Glosify هي خدمة لتعلّم اللغات في مرحلة تجريبية تُشغِّلها <strong>@legal.ControllerName</strong>. باستخدامك لها، فإنك توافق على استخدام الخدمة بشكل قانوني، والحفاظ على أمان حسابك، وعدم رفع أو بثّ سوى المواد التي يُسمح لك بمعالجتها.</p>

        <h2>الخدمة التجريبية والتوافر</h2>
        <p>قد تتغير الميزات أو تتعطل أو تصبح غير متاحة مؤقتًا. تُغلق الميزات المدفوعة عندما تنفد الميزانية الشهرية لتطبيق Glosify وتُعاد فتحها في الفترة الشهرية التالية بتوقيت Europe/Stockholm. الأرصدة هي وحدات خدمة، ولا تملك قيمة نقدية، ولا تضمن توافرًا مستمرًا دون انقطاع.</p>

        <h2>أرصدة التجربة</h2>
        <p>قد يحصل الحساب المؤهل المرتبط بـ Google أو Microsoft على رصيد تجريبي واحد بقيمة 25 رصيدًا. حسابات كلمة المرور فقط وتسجيلات API لا تحصل على أرصدة تجريبية تلقائية. وقد يؤدي إساءة الاستخدام، أو إنشاء حسابات متعددة بغرض الاستفادة، أو الأتمتة، أو محاولات التحايل على الحدود إلى التعليق.</p>

        <h2>محتواك</h2>
        <p>تحتفظ بالحقوق في المحتوى الذي تقدمه. وتمنح Glosify ومعالجيها الإذن المحدود اللازم لاستضافة ذلك المحتوى ونقله وتحليله وترجمته وإرجاعه للميزات التي تطلبها. لا تعتمد على الترجمات المُولَّدة أو مواد التعلّم لاتخاذ قرارات طبية أو قانونية أو متعلقة بالسلامة أو أي قرارات أخرى عالية المخاطر.</p>

        <h2>إنهاء الاستخدام</h2>
        <p>يمكنك التوقف عن استخدام Glosify وحذف المحتوى المخزن من خلال أدوات التحكم المتاحة للحساب والنصوص. وقد تقيد Glosify الحسابات التي تهدد الخدمة أو المستخدمين الآخرين أو الامتثال القانوني.</p>

        <h2>التواصل</h2>
        <p>يمكن إرسال الأسئلة المتعلقة بهذه الشروط إلى <a href="mailto:@legal.ContactEmail">@legal.ContactEmail</a>.</p>

        <nav class="legal-links" aria-label='@Text["Legal.Label"]'>
            <a asp-action="Privacy">@Text["Legal.PrivacyPolicy"]</a>
            <a asp-action="Support">@Text["Legal.Support"]</a>
        </nav>
    </article>
</main>
