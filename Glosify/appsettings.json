        {
          "Deployment": "gpt-realtime-translate",
          "AudioSekPerMinute": 0.34
        },
        {
          "Deployment": "gpt-realtime-translate+elevenlabs-scribe-v2-realtime",
          "AudioSekPerMinute": 0.68
        },
        // glosify-assistant rates, 2026-08-06. USD list x 9.727 SEK/USD (the rate the
        // rows above already use, and above the ~9.55 spot) x 1.15 markup, so the budget
        // errs toward stopping early rather than overspending.
        //   gpt-5.6-luna       DataZoneStandard  $1.10  / $6.60   (Global $1.00/$6.00 x1.10)
        //   grok-4.3           GlobalStandard    $1.25  / $2.50
        //   DeepSeek-V4-Flash  DataZoneStandard  $0.616 / $1.232
        // The Grok and DeepSeek figures are derived rather than read off an Azure price
        // sheet: Azure publishes no meter for either. Grok assumes Azure matches xAI list
        // (it did for Grok 4.1), DeepSeek applies Azure's observed 4.0x markup over
        // DeepSeek list. Recheck both against a real invoice line.
        // Append new entries here rather than inserting: App Service has historically
        // overridden Models__N__* by index, and reordering rebinds those onto other models.
        {
          "Deployment": "gpt-5.6-luna",
          "InputSekPerMillionTokens": 12.3047,
          "OutputSekPerMillionTokens": 73.8279
        },
        {
          "Deployment": "grok-4.3",
          "InputSekPerMillionTokens": 13.9826,
          "OutputSekPerMillionTokens": 27.9651
        },
        {
          "Deployment": "DeepSeek-V4-Flash",
          "InputSekPerMillionTokens": 6.8906,
          "OutputSekPerMillionTokens": 13.7811
        },
        {
          // Conservative combined estimate for Scribe realtime plus Azure Translator NMT.
          "Deployment": "elevenlabs-scribe-v2-realtime+azure-translator-nmt",
          "AudioSekPerMinute": 0.35
        }
      ]
    }
  },
