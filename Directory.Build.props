<Project>

  <!-- Shared build settings for all projects in the solution; keeps the test
       project from drifting away from the app (framework, nullability). -->
  <PropertyGroup>
    <!-- Guarded so a future multi-targeting project can set TargetFrameworks
         without also inheriting a single TargetFramework. -->
    <TargetFramework Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The build is clean at warning level 10, so holding that line costs nothing
         today and stops the first warning from becoming a hundred. Severities for
         individual analyzer rules live in .editorconfig, next to the reasoning. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit findings stay as warnings during normal local builds so a newly
         published advisory does not unexpectedly block unrelated work. CI clears
         this exception in its dedicated Audit NuGet packages restore step. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <!-- Normalises embedded paths so the same source produces the same assembly
         regardless of which agent built it. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
