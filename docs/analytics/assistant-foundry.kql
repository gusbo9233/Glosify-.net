// Glosify assistant Foundry/Application Insights query pack.
// Adjust the time range for each use. operation_Id is the W3C trace id and joins to
// assistant_turns.trace_id in Azure SQL. Custom attributes live in customDimensions.

// Turn traces and operational outcome.
dependencies
| where timestamp > ago(30d)
| where name == "assistant.turn"
    or tostring(customDimensions["gen_ai.operation.name"]) == "invoke_agent"
| extend
    turnId = tostring(customDimensions["assistant.turn.id"]),
    profile = tostring(customDimensions["assistant.profile"]),
    provider = tostring(customDimensions["gen_ai.provider.name"]),
    model = tostring(customDimensions["gen_ai.response.model"]),
    outcome = tostring(customDimensions["assistant.outcome"]),
    responseId = tostring(customDimensions["gen_ai.response.id"])
| project timestamp, operation_Id, turnId, profile, provider, model, outcome, responseId, duration, success
| order by timestamp desc

// Model volume, failures, tokens, and latency by agent/model.
dependencies
| where timestamp > ago(30d)
| where tostring(customDimensions["gen_ai.operation.name"]) == "chat"
| extend
    turnId = tostring(customDimensions["assistant.turn.id"]),
    invocationId = tostring(customDimensions["assistant.invocation.id"]),
    agent = tostring(customDimensions["gen_ai.agent.name"]),
    agentVersion = tostring(customDimensions["gen_ai.agent.version"]),
    model = coalesce(tostring(customDimensions["gen_ai.response.model"]), tostring(customDimensions["gen_ai.request.model"])),
    inputTokens = tolong(customDimensions["gen_ai.usage.input_tokens"]),
    outputTokens = tolong(customDimensions["gen_ai.usage.output_tokens"])
| summarize
    calls = count(),
    failures = countif(success == false),
    inputTokens = sum(inputTokens),
    outputTokens = sum(outputTokens),
    p50 = percentile(duration, 50),
    p95 = percentile(duration, 95),
    p99 = percentile(duration, 99)
  by agent, agentVersion, model
| order by calls desc

// Tool use and tool failure rate.
dependencies
| where timestamp > ago(30d)
| where tostring(customDimensions["gen_ai.operation.name"]) == "execute_tool"
| extend
    turnId = tostring(customDimensions["assistant.turn.id"]),
    invocationId = tostring(customDimensions["assistant.invocation.id"]),
    toolName = tostring(customDimensions["gen_ai.tool.name"]),
    args = tostring(customDimensions["gen_ai.tool.call.arguments"]),
    result = tostring(customDimensions["gen_ai.tool.call.result"])
| summarize executions = count(), failures = countif(success == false), p95 = percentile(duration, 95) by toolName
| extend failureRatePct = round(100.0 * failures / executions, 2)
| order by executions desc

// User feedback and Foundry continuous-evaluation scores. Free-text comments never enter telemetry.
union
    (customEvents | where timestamp > ago(30d) | where name == "gen_ai.evaluation.result"),
    (dependencies | where timestamp > ago(30d) | where name == "gen_ai.evaluation.result")
| extend
    turnId = tostring(customDimensions["assistant.turn.id"]),
    evaluator = tostring(customDimensions["gen_ai.evaluation.name"]),
    score = todouble(customDimensions["gen_ai.evaluation.score.value"]),
    label = tostring(customDimensions["gen_ai.evaluation.score.label"]),
    reasons = tostring(customDimensions["assistant.feedback.reasons"]),
    responseId = tostring(customDimensions["gen_ai.response.id"]),
    conversationId = tostring(customDimensions["gen_ai.conversation.id"])
| summarize samples = count(), averageScore = avg(score), labels = make_set(label), reasonCodes = make_set(reasons)
  by evaluator, turnId, responseId, conversationId, operation_Id
| order by evaluator asc, turnId asc

// Inspect a complete trace. Replace the operation id with assistant_turns.trace_id.
let selectedOperationId = "<trace-id>";
union isfuzzy=true
    (requests | where operation_Id == selectedOperationId | project timestamp, itemType = "request", name, id, operation_ParentId, duration, success, customDimensions),
    (dependencies | where operation_Id == selectedOperationId | project timestamp, itemType = "dependency", name, id, operation_ParentId, duration, success, customDimensions),
    (traces | where operation_Id == selectedOperationId | project timestamp, itemType = "trace", name = message, id = "", operation_ParentId, duration = 0ms, success = true, customDimensions),
    (customEvents | where operation_Id == selectedOperationId | project timestamp, itemType = "event", name, id, operation_ParentId, duration = 0ms, success = true, customDimensions)
| order by timestamp asc

// Trace completeness audit. Export the operation_Id list and compare it with the SQL audit.
let roots = materialize(
    dependencies
    | where timestamp > ago(24h)
    | where name == "assistant.turn"
    | extend turnId = tostring(customDimensions["assistant.turn.id"])
    | summarize rootSpans = count(), successfulRoots = countif(success == true) by operation_Id, turnId
);
dependencies
| where timestamp > ago(24h)
| where operation_Id in (roots | project operation_Id)
| summarize modelSpans = countif(tostring(customDimensions["gen_ai.operation.name"]) == "chat") by operation_Id
| join kind=rightouter roots on operation_Id
| where isempty(turnId) or rootSpans != 1 or modelSpans == 0
| order by operation_Id desc
